<!DOCTYPE html>
<!--[if lt IE 7 ]><html lang="en" class="no-js ie6"> <![endif]-->
<!--[if IE 7 ]><html lang="en" class="no-js ie7"> <![endif]-->
<!--[if IE 8 ]><html lang="en" class="no-js ie8"> <![endif]-->
<!--[if IE 9 ]><html lang="en" class="no-js ie9"> <![endif]-->
<!--[if (gt IE 9)|!(IE)]><!-->
    <html
    class="no-js" lang="en"> <!--<![endif]-->
    <head>
        <meta content="text/html;charset=utf-8" http-equiv="Content-Type">
        <meta content="width=device-width,initial-scale=1" name="viewport">

        <meta name="author" content="{% block siteauthor %}{% endblock %}">
        <meta name="keywords" content="{% block sitekeywords %}{% endblock %}">
        <title>{{ site_title }}:
            {% block page_title %}{% endblock %}
        </title>

        {% block css %}
            {{ include("WebmastersAfricaPressBundle:Blocks:css.html.twig") }}
        {% endblock %}
    </head>
    <body>

        <!--[if lte IE 8]>
            <p class="chromeframe">You are using an <strong>outdated</strong> browser. Please <a href="http://browsehappy.com/">upgrade your browser</a>.</p>
        <![endif]-->

        <div id="preloader">
            <div class="sk-spinner sk-spinner-wave" id="status">
                <div class="sk-rect1"></div>
                <div class="sk-rect2"></div>
                <div class="sk-rect3"></div>
                <div class="sk-rect4"></div>
                <div class="sk-rect5"></div>
            </div>
        </div>
        <!-- End Preload -->


        <div class="body-wrapper">

            <!-- header -->
            {% block header %}
                {{ include("WebmastersAfricaPressBundle:Blocks:header.html.twig") }}
            {% endblock %}
            <!--/header-->

            <!-- banner -->
            {% block banner %}
                {{ include("WebmastersAfricaPressBundle:Blocks:banner.html.twig", {
                  'banners': [], 
                  'locations': 0,
                  'business_types': 0
                }) }}
            {% endblock %}
            <!--/banner-->


            <!-- content -->
            {% block body %}{% endblock %}
            <!--/content -->

            <!-- footer -->
            {% block footer %}
                {{ include("WebmastersAfricaPressBundle:Blocks:footer.html.twig") }}
            {% endblock %}
            <!--/footer -->

            <!-- js -->
            {% block js %}
                {{ include("WebmastersAfricaPressBundle:Blocks:js.html.twig") }}
            {% endblock %}
            <!-- /js -->


        </div>

        <script>
            (function (i, s, o, g, r, a, m) {
                i['GoogleAnalyticsObject'] = r;
                i[r] = i[r] || function () {
                    (i[r].q = i[r].q || []).push(arguments)
                },
                i[r].l = 1 * new Date();
                a = s.createElement(o),
                m = s.getElementsByTagName(o)[0];
                a.async = 1;
                a.src = g;
                m.parentNode.insertBefore(a, m)
            })(window, document, 'script', 'https://www.google-analytics.com/analytics.js', 'ga');

            ga('create', '', 'auto');
            ga('send', 'pageview');

        $(document).ready(function () {
            $('#speedB').select2();
            $('#speedC').select2();
            $('#speedD').select2();
            $('#speedE').select2({
                placeholder: "SELECT BUSINESS ACTIVITIES:",
                multiple: true
            });
        });
	    $('#form_subscriberemail').clone().attr('type', 'email').insertAfter('#form_subscriberemail').prev().remove();
        $("#form-newsletters").validate();
        </script>


       <script async src="https://www.googletagmanager.com/gtag/js?id=UA-175633985-1"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());

            gtag('config', 'UA-175633985-1');
        </script>


    </body>
</html>

