{% trans_default_domain 'WebmastersAfricaPressBundle' %}

<link href="{{ asset('bundles/webmastersafricapress/new/css/slick-slider.css') }}" rel="stylesheet">
<div id="full-slider-wrapper">
  <!--// Main Banner \\-->
  <div class="wm-banner">
    {% for banner in banners %}
      <div class="wm-banner-wrap">
        <span class="wm-transparent-layer"></span>

        <img src="{{ asset('uploads/' ~ banner.image) }}" alt="{{ banner.title }}">
        <form action="/search/advanced" class="wm-listing-search" method="post">
          <div class="wm-caption">
            <h1>{{ banner.title }}</h1>
            <p>{{ banner.description }}</p>
          </div>
          <div class="wm-c">
            <div class="wm-d">
              <form action="/search/advanced" class="hidden-xs" method="post">
                <div id="custom-search-input">
                  <div class="input-group">
                    <input type="text" name="keywords" class=" search-query" placeholder="{{ 'findsearchdesc'|trans }}">
                      <span class="input-group-btn">
                        <input class="btn_search" type="submit" value="submit"> Search
                      </span>
                  </div>
                </div>
              </form>
            </div>
          </div>
        </form>
        <!--// Listing Search \\-->
      </div>
    {% endfor %}
