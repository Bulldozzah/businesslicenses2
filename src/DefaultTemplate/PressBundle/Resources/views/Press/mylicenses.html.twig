{# src/Webmasters/ContentBundle/Resources/views/Content/index.html.twig #}
{% extends 'WebmastersAfricaPressBundle:Layouts:base.html.twig' %}

{% trans_default_domain 'WebmastersAfricaPressBundle' %}

{% block page_title %}{{ 'my_saved_licenses'|trans }}{% endblock %}

{% block breadcrumb %}
<li><a href="{{ app.request.basepath }}/index.php">{{ 'home'|trans }}</a></li>
<li><a href="#0">{{ 'brlicenses'|trans }}</a></li>
<li>{{ 'my_saved_licenses'|trans }}</li>
{% endblock%}

{% block pageheader %}
<div class="col-md-12 col-sm-12 col-xs-12 title">
    <h4>{{ 'my_saved_licenses'|trans }}</h4>
</div><!-- End sub_content -->
{% endblock %}

{% block body %}

<div class="col-md-9 col-sm-6 col-xs-12">

{% if searches|length == 0 %}
<div class="alert alert-info">
 {{ 'no_saved_licenses'|trans }}
</div>
{% endif %}


    {% set count = 0 %}
    {% for search in searches %}
        {% set count = count + 1 %}
        <div class="box_style_2 info">

          <h4 class="nomargin_top title_case">{{ search.name }}<i class="icon-drive pull-right"></i></h4>
                <div class = "toggle {% if count == 1 %}active {% endif %} toggle-saved">
                        <table class="table table-striped table-bordered m-b-10">
                        <thead>
                            <tr>
                            <th>{{ 'name'|trans }}</th>
                            <th>{{ 'remove'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% set count = 0 %}
                            {% for searchitem in search.content %}
                                    <tr class="gradeX">
                                      <td><a href='{{ app.request.basepath }}/license/id/{{ searchitem.license.id }}'>{{ searchitem.license.name }}</a><p>{{ searchitem.license.purpose }} </p></td>
                                      <td class="align-center">
                                      <a href="{{ app.request.basepath }}/user/deletesearchitem/{{ search.id }}/{{ searchitem.id }}"><span class="label label-danger"><i class="icon-cancel"></i></span></a>
                                      </td>
                                    </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    <div class="toggle-btns-cont">
                    <a onClick="window.location='{{ app.request.basepath }}/search/share/{{ search.id }}';" href="{{ app.request.basepath }}/search/share/{{ search.id }}" class="btn btn-success btn-sm"><span>{{ 'share'|trans }} </a>
                    <a href="#" onClick="if(confirm('{{ 'are_you_sure_delete'|trans }}')){ window.location = '{{ app.request.basepath }}/search/delete/{{ search.id }}'; }else{ return false; }" class="btn btn-danger btn-sm">{{ 'delete'|trans }}</a>
                </div>

              </div>
            </div>
    {% endfor %}

</div>
{% endblock %}
