{# src/Webmasters/ContentBundle/Resources/views/Content/index.html.twig #}
{% extends 'WebmastersAfricaPressBundle:Layouts:base.html.twig' %}

{% trans_default_domain 'WebmastersAfricaPressBundle' %}

{% block page_title %}
  - Business Startup Procedures
{% endblock %}

{% block breadcrumb %}
  <li>
    <a href="{{ app.request.basepath }}/index.php">{{ 'home'|trans }}</a>
  </li>
  <li>
    <a href="/press/10">e-Services</a>
  </li>
  <li>Business Procedure</li>
{% endblock %}

{% block pageheader %}
  <div class="col-md-12 col-sm-12 col-xs-12 title">
    <h4>Business Procedures</h4>
  </div>

{% endblock %}

{% block body %}
  <div class="col-md-12 col-sm-12 col-xs-12">
    <div class="row">
      <div class="container">
        <div class="home_boxesA row">
          {% for procedures in business_startup %}
            <div class="col-md-4 wow fadeIn animated" data-wow-delay="0.1s" style="visibility: visible; animation-delay: 0.1s; animation-name: fadeIn;">
              <div class="feature">
                <i class="icon_documents_alt"></i>
                <h3>{{ procedures.title }}</h3>
                <ul>
                  {% for business_procedure in procedures.businessProcedure %}
                    {% if business_procedure.isPublished %}
                      <li>
                        <a href="/business-procedures/details/{{ business_procedure.slug }}" style="" target="_blank">
                          {{ business_procedure.name }}
                        </a>
                      </li>
                    {% endif %}
                  {% endfor %}
                </ul>
              </div>
            </div>
          {% endfor %}
        </div>
        <!-- End row -->
      </div>
    </div>
  </div>

  <style type="text/css">
    .home_boxesA ul {
      padding-left: 0;
      list-style: none;
      margin-top: 6px;
    }
    .high_light3 .home_boxesA h3 {
      font-size: 1.2em;
    }
    .high_light3 h3 {
      color: #111;
      font-weight: normal;
      margin: 0;
      padding: 0;
    }
    .home_boxesA .feature {
      min-height: 180px;
    }

    .custom-btn {
      border: 2px solid black;
      background-color: white;
      color: black;
      padding: 10px 15px;
      font-size: 16px;
      cursor: pointer;
    }


    .custom-default {
      border-color: #2196F3;
      color: black;
    }
    .custom-default:hover {
      background: #2196F3;
      color: white;
    }
  </style>

{% endblock %}
{% block sidebar%}{% endblock %}
