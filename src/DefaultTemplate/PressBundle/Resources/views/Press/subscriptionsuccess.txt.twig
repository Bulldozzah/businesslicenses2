{% trans_default_domain 'WebmastersAfricaPressBundle' %}

<main>
    {{ 'hi'|trans }}
    <div class="card">
      <div class="card-body">
        <h3 class="card-title">Newsletters Subscription Successful</h3>
        <p class="card-text">You have successfully signed up for our newsletters.</p>
        <a href="{{confirmationUrl ~ path('homepage') }}" class="card-link">Home</a>
        <a href="{{confirmationUrl ~ path('unsubscription_check')}}" class="card-link">Unsubscribe here</a>
      </div>
    </div>
    {{ 'regards'|trans }}
    {{ 'team'|trans }}
</main>

 

