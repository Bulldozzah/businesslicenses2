{# src/Webmasters/ContentBundle/Resources/views/Content/index.html.twig #}
{% extends 'WebmastersAfricaPressBundle:Layouts:base.full.html.twig' %}
{% trans_default_domain 'WebmastersAfricaPressBundle' %}
{% block page_title %}
    {{ 'browselicenses'|trans }}
{% endblock %}

{% block breadcrumb %}
<li>
    <a href="{{ app.request.basepath }}">
        {{ 'home'|trans }}
    </a>
</li>

<li>{{ 'browselicenses'|trans }}</li>
{% endblock%}

{% block pageheader %}
    <div style="margin-top: 25px;"></div>
    {{ 
      include("WebmastersAfricaPressBundle:Press:quick_search.html.twig")
  }}
{% endblock %}

{% block body %}

    <script language="javascript">
        function atLeastOneRadio() {
            return($('input[type=checkbox]:checked').size() > 0);
        }

        function check(checked) {
            if (checked) {
                checkAll($('input[type=checkbox]'));
            } else {
                uncheckAll($('input[type=checkbox]'));
            }
        }

        function checkAll(field) {
            for (i = 0; i < field.length; i ++) 
                field[i].checked = true;
            


        }

        function uncheckAll(field) {
            for (i = 0; i < field.length; i ++) 
                field[i].checked = false;
            


        }
    </script>

    <div class="col-md-12 col-sm-12 col-xs-12">
        <h4>{{ 'filterlicense'|trans }}</h4>
    </div>
    <!-- End sub_content -->
    {{ render(controller("WebmastersAfricaPressBundle:Press:search")) }}

    {% trans_default_domain 'WebmastersAfricaPressBundle' %}


    <link href="{{ asset('bundles/webmastersafricapress/new/dt/jquery.dataTables.min.css') }}" rel="stylesheet">

    <form action="{{ app.request.basepath }}/search/save" method="post" id='licenseform' name='licenseform'>

        <div class="col-md-12 col-sm-12 col-xs-12">
            <div class="box_style_2">
                <div class="agency_filter dataTables_wrapper">
                    <div id="tools">
                        <span class="styled-select">
                            <select id="filter">
                                <option selected="selected" value="">Filter Licenses by issuing Agency</option>
                                    <option value='{{ agency.name }}'>{{ agency.name }}</option>
                            </select>
                        </span>
                    </div>
                </div>

                <table cellspacing="0" class="table table-striped table-hover" id="dtable" width="100%">
                    {% set count = 0 %}
                    <thead>
                        <tr>
                            <th nowrap="nowrap"><input class="icheck" onclick="check(this.checked);" type="checkbox"></th>
                            <th class="hidden-sm hidden-xs" nowrap="nowrap">#</th>
                            <th nowrap="nowrap">{{ 'licensename'|trans }}</th>
                            <th class="hidden-sm hidden-xs">{{ 'issuingagency'|trans }}<a rel="" title="Issuing Agency">
                                    <i class="icon icon-question-sign" title="Issuing Agency"></i>
                                </a>
                            </th>
                            {# <th class="hidden-sm hidden-xs" nowrap="nowrap">{{ 'time'|trans }}</th> #}
                        </tr>
                    </thead>
                    <tbody>
                        {% for license in agency.licenses %}
                            {% set count = count + 1 %}
                            <tr>
                                <td><input type="checkbox" value="{{ license.id }}" id="sf_admin_batch_selection_{{ license.id }}" name="sf_admin_batch_selection[]"></td>
                                <td class="hidden-sm hidden-xs">
                                    <p>{{ count }}</p>
                                </td>
                                <td>
                                    <a href='{{ app.request.basepath }}/license/id/{{ license.id }}'>{{ license.name }}</a>
                                    <p>{{ license.purpose | raw }}</p>
                                </td>
                                <td class="hidden-xs hidden-sm">{{ license.agency.title }}</td>
                                {# <td class="hidden-xs hidden-sm">{{ license.maxProcessingTime }}</td> #}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="col-md-12 col-sm-12 col-xs-12 m-t-20">
            <div class="p-t-10 p-b-10">
                <button class="form-button form-button-default form-button-xs" name="share" value="{{ 'share'|trans }}" id="share" style="outline: medium none; opacity: 1; margin-right:10px;" onclick="if(atLeastOneRadio()){ return true; }else{ alert('{{ 'pleasechooseshare'|trans }}.'); return false; }" class="btn btn_blue">
                    <span>
                        {{ 'share'|trans }}
                    </span>
                </button>
            </div>
        </div>

    </form>

    <script language="javascript">
        function getIndustries(url, location) {
            var xmlHttpRequest = false;
            var self = this;

            // Mozilla/Safari
            if (window.XMLHttpRequest) {
                self.xmlHttpRequest = new XMLHttpRequest();
            } else if (window.ActiveXObject) {
                self.xmlHttpRequest = new ActiveXObject("Microsoft.XMLHTTP");
            }

            self.xmlHttpRequest.open('POST', url, true);
            self.xmlHttpRequest.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');

            self.xmlHttpRequest.onreadystatechange = function () {

                if (self.xmlHttpRequest.readyState == 4) {
                    document.getElementById("industries").innerHTML = self.xmlHttpRequest.responseText;
                } else {
                    document.getElementById("industries").innerHTML = "Loading...";
                }

            }

            self.xmlHttpRequest.send("location=" + location);
        }

        function getBusinesstypes(url, industry) {
            var xmlHttpRequest = false;
            var self = this;

            // Mozilla/Safari
            if (window.XMLHttpRequest) {
                self.xmlHttpRequest = new XMLHttpRequest();
            } else if (window.ActiveXObject) {
                self.xmlHttpRequest = new ActiveXObject("Microsoft.XMLHTTP");
            }

            self.xmlHttpRequest.open('POST', url, true);
            self.xmlHttpRequest.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');

            self.xmlHttpRequest.onreadystatechange = function () {

                if (self.xmlHttpRequest.readyState == 4) {
                    document.getElementById("businesstypes").innerHTML = self.xmlHttpRequest.responseText;
                } else {
                    document.getElementById("businesstypes").innerHTML = "Loading...";
                }

            }

            self.xmlHttpRequest.send("industry=" + industry);
        }
    </script>
{% endblock %}
