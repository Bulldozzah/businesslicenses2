{# src/Webmasters/ContentBundle/Resources/views/Content/index.html.twig #}
{% extends 'WebmastersAfricaPressBundle:Layouts:base.html.twig' %}

{% trans_default_domain 'WebmastersAfricaPressBundle' %}

{% block page_title %}
    {{ 'save_licenses'|trans }}
{% endblock %}

{% block breadcrumb %}
<li>
    <a href="{{ app.request.basepath }}/index.php">{{ 'home'|trans }}</a>
</li>
<li>
    <a href="{{ app.request.basepath }}/browse/licenses">{{ 'licenses1'|trans }}</a>
</li>
<li>{{ 'save_licenses'|trans }}</li>
{% endblock%}

{% block pageheader %}
    <div class="col-md-12 col-sm-12 col-xs-12 title">
        <h4>{{ 'save_licenses'|trans }}</h4>
    </div>
    <!-- End sub_content -->
{% endblock %}


{% block body %}
    <div class="col-md-9 col-sm-9 col-xs-12">
        <div
            class="box_style_2 info">

            <!-- share widget -->
            <div class="widget-container widget_login">
                {% if share == false %}
                    <h3>{{ 'enter_search_name'|trans }}</h3>
                    <form id="form-comments" class="loginform" onsubmit="if(document.getElementById('title').value == '' && document.getElementById('existing').value == ''){ alert('{{ 'please_enter_title_or_select_existing_search'|trans }}'); return false; }else{ return true; }" id="form-comments" action="{{ app.request.basepath }}/search/commit" method="post" autocomplete="off">
                        <p>
                            <label>{{ 'new_search_title'|trans }}</label><br>
                            <input class="form-control" type="text" name="title" id="title" size="30" tabindex="10" type="text"></p>

                        <p>
                            <label>{{ 'add_to_existing'|trans }}</label><br><select name="existing" id="existing">
                                <option value=""></option>
                                {% for search in searches %}
                                    <option value='{{ search.id }}'>{{ search.name }}</option>
                                {% endfor %}
                            </select>
                        </p>

                    {% else %}
                        <h3 class="nomargin_top">{{ 'enter_email'|trans }}<i class="icon_lock_alt pull-right"></i>
                        </h3>
                        <form id="form-comments" class="loginform" onsubmit="if(document.getElementById('email').value == ''){ alert('{{ 'please_enter_an_email'|trans }}'); return false; }else{ return true; }" id="form-comments" action="{{ app.request.basepath }}/share/commit" method="post" autocomplete="off">
                            <p>
                                <label>
                                    {{ 'email_address'|trans }}
                                </label>
                                <br>
                                <input class="form-control" type="email" name="email" id="email" size="30" tabindex="10" type="email" pattern="[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,4}$">
                            </p>

                        {% endif %}
                        {% for license in licenseentities %}
                            <input type="hidden" value="{{ license.id }}" id="sf_admin_batch_selection_{{ license.id }}" name="sf_admin_batch_selection[]">
                        {% endfor %}
                        {% if share == false %}
                            <input name="submitbuttonname" type="submit" onclick="chkLgn()" class="form-button form-button-green" tabindex="100" name="submitbuttonname" value="{{ 'save_search'|trans }}">
                            <input type="reset" name="wp-submit" id="wp-submit" class="form-button form-button-red" value="{{ 'reset'|trans }}" tabindex="100">
                        {% else %}
                            <input name="submitbuttonname" type="submit" onclick="chkLgn()" class="form-button form-button-green" tabindex="100" name="submitbuttonname" value="{{ 'share_licenses'|trans }}">
                            <input type="reset" name="wp-submit" id="wp-submit" class="form-button form-button-red" value="{{ 'reset'|trans }}" tabindex="100">
                        {% endif %}
                    </form>
                </div>
                <!--/ share widget -->
            </div>
        </div>
    {% endblock %}
