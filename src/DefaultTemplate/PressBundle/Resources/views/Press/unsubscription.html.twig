
{% trans_default_domain 'WebmastersAfricaPressBundle' %}

{% extends 'WebmastersAfricaPressBundle:Layouts:base.full.html.twig' %}

{% block page_title %}Newsletters| Unsubscribe{% endblock %}

{% block breadcrumb %}
    <li><a href="{{ app.request.basepath }}/index.php">{{ 'home'|trans }}</a></li>
    <li class="last-child">{{ 'newsletter_sign_up'|trans }}</li>
{% endblock%}

{% block pageheader %}
<div class="col-md-12 col-sm-12 col-xs-12 title">
    <h4>{{ 'newsletter_sign_up'|trans }}</h4>
</div><!-- End sub_content -->
{% endblock %}

{% block body %}
<div class="col-md-offset-3 col-md-6">
			<div class="box_style_2 m-t-20">
        <h3 class="nomargin_top align-center">Newsletters unsubscribe</i></h3>
        {% for flashMessage in app.session.flashbag.get('subscription_failed') %}
            <div>
                <p class="alert alert-danger">
                    {{ flashMessage}}
                </p>
            </div>
        {% endfor %}
				<div id="confirm">
					{{ form_start(form, {'action': path('unsubscription_check'), 'method': 'POST'}) }}
					{{ form(form) }}
					{{ form_end(form)}}
				</div>
			</div>
		</div>
{% endblock %}
