{% extends 'NoticeCommentBundle::base2.html.twig' %}
{% trans_default_domain 'WebmastersAfricaUserBundle' %}


{% block breadcrumb %}
<li>
    <a href="{{ app.request.basepath }}">
        {{ 'home'|trans }}
    </a>
</li>
<li>Registration confirmed</li>
{% endblock%}

{% block body %}

  <div class="feedback_page_wrapper">  
    <div class="row cleafix">
        <div class="offset-md-3 col-md-6">
            <div class="box_style_2 m-t-20">
                <h2 class="text-center nomargin_top align-center">Thank you!</i></h2>

                <div id="confirm">
                    <i class="icon_check_alt2"></i>
                    <h3 class="text-center">Registration confirmed!</h3>
                    <p class="text-center">{{ 'registration.confirmed'|trans({'%username%': user.username}) }}</p>

                    {% if app.session is not empty %}
                        {% set targetUrl = app.session.get('_security.' ~ app.security.token.providerKey ~ '.target_path') %}
                        {% if targetUrl is not empty %}
                            <p class="text-center">
                                <a href="{{ targetUrl }}">{{ 'registration.back'|trans }}</a>
                            </p>
                        {% endif %}
                    {% endif %}
                    {#<p>
                    This  System enables you to access all the licenses you will require to start your business in Zambia, from one place.
                    </p>

                    <p>
                    Perform Business Licensing Search with ease by using this tool
                    </p> #}

                </div>
            </div>
        </div>
    </div>

</div>{% endblock body %}
