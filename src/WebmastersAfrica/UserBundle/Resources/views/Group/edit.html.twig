{# src/WebmastersAfrica/UserBundle/Resources/views/Group/edit.html.twig #}

{% extends 'WebmastersAfricaAdminBundle::adminlayout.html.twig' %}

{% trans_default_domain 'WebmastersAfricaUserBundle' %}

{% block page_title %}
    {{ site_title }},
    {{ 'groups.edit_group' | trans }}
{% endblock %}

{% block header %}
    <!-- Title area -->
    <div class="titleArea">
        <div class="wrapper">
            <div class="pageTitle">
                <h5>{{ 'groups.edit_group' | trans }}</h5>
                <span>{{ 'groups.edit_group_description' | trans }}</span>
            </div>
            <div class="middleNav" style="border: none;">
                <a href="{{ path('managegroups') }}" title="Back To List" class="greyNum w3-button w3-round-large w3-hover-red">
                    <span>{{ 'groups.back_to_list' | trans }}</span>
                </a>
                <div class="clear"></div>
            </div>
            <div class="clear"></div>
        </div>
    </div>
{% endblock %}

{% block body %}

    <form action="{{ path('managegroups_update', { 'id': entity.id }) }}" method="post" {{ form_enctype(edit_form) }} class="form">
        <input type="hidden" name="_method" value="PUT"/>
        {{ form_errors(edit_form) }}
        {{ form_row(edit_form.name) }}

        <div class="formRow">
            <label for="group_roles">{{ 'groups.group_roles' | trans }}</label>
            <div class="formRight">
                <ul>
                    {% for role in roles %}
                        <li><input type="checkbox" name="roles[]" id="role_{{ role.id }}" value="{{ role.roleCode }}" {% if role.roleCode in choosenroles %} checked {% endif %}>
                            {{ role.title }}
                            ({{ role.roleCode }})</li>
                    {% endfor %}
                </ul>
            </div>
            <div class="clear"></div>
        </div>

        {{ form_row(edit_form.update, { 'attr': {'class':'w3-right w3-center w3-button w3-blue w3-round-medium', 'style':'padding: 10px 30px 30px 30px; margin-right:15px;'} }) }}

        <div style="display: none;">
            {{ form_rest(edit_form) }}
        </div>
    </form>
    <br>

<script src="{{ asset('bundles/webmastersafricapress/new/assets/validate.js') }}"></script>
   <script language="javascript">

      $(".label-required").append("<i style='color: red;'>*</i> ")
      $(".form").validate();
    // Requirements
    
</script>
    {% endblock %}
