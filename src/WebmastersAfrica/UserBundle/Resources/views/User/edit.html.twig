{# src/WebmastersAfrica/PressBundle/Resources/views/Default/index.html.twig #}

{% extends 'WebmastersAfricaAdminBundle::adminlayout.html.twig' %}

{% trans_default_domain 'WebmastersAfricaUserBundle' %}

{% block page_title %}{{ site_title }}, {{ 'users.edit_user' | trans }}{% endblock %}

{% block header %}
<!-- Title area -->
<div class="titleArea">
    <div class="wrapper">
        <div class="pageTitle">
            <h5>{{ 'users.edit_user' | trans }}</h5>
            <span>{{ 'users.edit_user_description' | trans }}</span>
        </div>
        <div class="middleNav" style="border: none;">
                <a href="{{ path('manage_admins') }}" title="{{ 'users.back_to_list' | trans }}" class="w3-button w3-round-large w3-green w3-hover-teal"><span>{{ 'users.back_to_list' | trans }}</span></a>
            <div class="clear"></div>
        </div>
        <div class="clear"></div>
    </div>
</div>
{% endblock %}

{% block body %}

    <form action="{{ path('manageusers_update', { 'id': entity.id }) }}" method="post" {{ form_enctype(edit_form) }} class="form">
        <input type="hidden" name="_method" value="PUT" />
		{{ form_row(edit_form.first_name) }}
        {{ form_row(edit_form.last_name) }}
        {{ form_row(edit_form.phone_number) }}
        {{ form_row(edit_form.email) }}
        {{ form_row(edit_form.username) }}
        {{ form_row(edit_form.password) }}
        {{ form_row(edit_form.agencies) }}
        {{ form_row(edit_form.groups) }}
        {{ form_row(edit_form.enabled) }}

        {{ form_row(edit_form.update, { 'attr': {'class':'w3-right w3-center w3-button w3-blue w3-round-medium', 'style':'padding: 10px 30px 30px 30px; margin-right:15px;'} }) }}
        <div style="display: none;">
            {{ form_rest(edit_form) }}
        </div>
	</form>
    <br>
    {# <div>
    	{{ form(delete_form) }}
	</div> #}

  <script language="javascript">
  jQuery(document).ready(function() {
      $("#webmastersafrica_userbundle_user_password").removeAttr('required');
      var demo1 = $('select[name="webmastersafrica_userbundle_user[agencies][]"]').bootstrapDualListbox();
      var demo2 = $('select[name="webmastersafrica_userbundle_user[groups][]"]').bootstrapDualListbox();
  });
  </script>
{% endblock %}
