{# src/WebmastersAfrica/PressBundle/Resources/views/Default/index.html.twig #}

{% extends 'WebmastersAfricaAdminBundle::adminlayout.html.twig' %}

{% trans_default_domain 'WebmastersAfricaUserBundle' %}

{% block page_title %}
  {{ site_title }},
  {{ 'users.manage_users' | trans }}
{% endblock %}

{% block header %}
  <!-- Title area -->
  <div class="titleArea">
    <div class="wrapper">
      <div class="pageTitle">
        <h5>{{ 'users.users' | trans }}</h5>
        <span>{{ 'users.users_description' | trans }}</span>
      </div>
      <div class="clear"></div>
    </div>
    <!-- Search widget -->
    <div class="searchWidget_form">
      <form action="{{ path('search_user_details') }}" method="post" class="form-search">
          <input type="text" name="search" placeholder="search users by name, agency, email ..." id="ac" />
          <input type="submit" value="" />
      </form>
    </div>
  </div>
  <div class="clear"></div>
  <hr />
  <br>
  <div class="line"></div>


  <div class="statsRow">
    {% if add_user %}
      <div class="wrapper w3-center">
        <div class="w3-show-inline-block">      
          <div class="w3-bar">
            <a href="{{ path("manageusers_new") }}" title="" class="w3-button w3-round-large w3-blue w3-hover-teal w3-large" title="" href="#">
              <img alt="" src="{{ asset('bundles/webmastersafricaadmin/images/icons/sPlus.png') }}" alt=""/>
              <span>{{ 'users.add_user' | trans }}</span>
            </a>
            <div class="clear"></div>
          </div>
        </div>
      </div>
    {% endif %}
  </div>


{% endblock %}

{% block body %}
  {% for flashMessage in app.session.flashbag.get('update') %}
    <div class="nNote nSuccess hideit">
      <p>
        <strong>Success:
        </strong>
        {{ 'licenses.updated_item_notice' | trans }}
      </p>
    </div>
  {% endfor %}
  {% for flashMessage in app.session.flashbag.get('delete') %}
    <div class="nNote nSuccess hideit">
      <p>
        <strong>Success:
        </strong>
        {{ 'licenses.deleted_item_notice' | trans }}
      </p>
    </div>
  {% endfor %}  
  {% for flashMessage in app.session.flashbag.get('delete') %}
    <div class="nNote nSuccess hideit">
      <p>
        <strong>Success:
        </strong>
        {{ 'licenses.created_item_notice' | trans }}
      </p>
    </div>
  {% endfor %}

  <div class="widget">
    <div class="title"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/frames.png') }}" alt="" class="titleIcon"/>
      <h6>{{ user_heading }}</h6>
    </div>
    <form id="batch_form" name="batch_form" action="{{ path("batch_users") }}" method="post">
      <table cellpadding="0" cellspacing="0" class="w3-bordered w3-table-all w3-hoverable" id="admin_table" width="100%">
        <thead>
          <tr>
            <td width="3%">
              <div>&middot;&middot;&middot;</div>
            </td>
            <td>
              <div>{{ 'users.first_name' | trans }}</div>
            </td>
            <td>
              <div>{{ 'users.last_name' | trans }}</div>
            </td>
            <td>
              <div>{{ 'users.username' | trans }}</div>
            </td>
            <td width="20%">
              <div>{{ 'users.email' | trans }}</div>
            </td>
            <td align="center">
              <div>{{ 'users.enabled' | trans }}</div>
            </td>
            <td align="center">{{ 'users.last_login' | trans }}</td>
            <td width="60px">{{ 'users.actions' | trans }}</td>
          </tr>
        </thead>
        <tbody class="table-anchor">
          {% for entity in pagination %}
            <tr>
              <td><input type="checkbox" class="w3-check" name="batch_items[]]" value="{{ entity.id }}"></td>
              <td>{{ entity.firstname }}</td>
              <td>{{ entity.lastname }}</td>
              <td>
                <a href="{{ path('manageusers_edit', { 'id': entity.id }) }}">{{ entity.username }}</a>
              </td>
              <td>{{ entity.email }}</td>
              <td align="center">
                {% if entity.enabled == true %}
                  <span class="smallButton"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/check.png') }}" alt="Enabled"></span>
                {% else %}
                  <span class="smallButton"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/close.png') }}" alt="Disabled"></span>
                {% endif %}
              </td>
              <td>
                {% if entity.lastLogin %}
                  {{ entity.lastLogin|date('Y-m-d H:i:s') }}
                {% endif %}
              </td>
              <td align="center">
                <ul>
                  <li><a alt="{{'users.edit'|trans}}" href="{{path('manageusers_edit',{'id':entity.id})}}" class="smallButton"><img alt="Edit"src="{{ asset('bundles/webmastersafricaadmin/images/icons/color/pencil.png') }}"></a></li>
                </ul>
              </td>
            </tr>
          {% endfor %}
        </tbody>
        <thead>
          <tr></tr>
          <tr style="border-top:1px solid #CDCDCD">
            <td colspan="9" style="padding:10px;">
              <select id="batch_select" name="batch_select" onchange="if(atLeastOne()){ if(confirm('{{ 'users.batch_confirm_1' | trans }} ' + this.value + ' {{ 'users.batch_confirm_2' | trans }}')){ document.getElementById('batch_form').submit(); } }">
                <option>{{ 'users.select_batch' | trans }}...</option>
                <option value="enable">{{ 'users.enable' | trans }}</option>
                <option value="disable">{{ 'users.disable' | trans }}</option>
                <option value="delete">{{ 'users.delete' | trans }}</option>
              </select>
            </td>
          </tr>
        </thead>
      </table>
    </form>
  </div>

  <div class="navigation">
    {{ knp_pagination_render(pagination) }}
  </div>
</div>
{% endblock %}

{% block stylesheet_2 %}

<script>


    $(document).ready( function () {
      $('#admin_table').DataTable();
      // $(".dataTables_filter input").addClass("w3-input w3-border w3-animate-input");
    } );
  </script>
{% endblock %}