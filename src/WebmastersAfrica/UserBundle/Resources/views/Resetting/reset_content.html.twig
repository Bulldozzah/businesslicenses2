{% trans_default_domain 'WebmastersAfricaUserBundle' %}

<div class="col-md-offset-3 col-md-6">
  <div class="box_style_2 info m-t-20">
  	    <h3 class="nomargin_top">Password Reset<i class="icon_lock-open_alt pull-right"></i></h3>

<form action="{{ path('fos_user_resetting_reset', {'token': token}) }}" {{ form_enctype(form) }} method="POST" class="m-t-20 loginform">
    {{ form_widget(form) }}
    <div class="m-t-10">
        <input type="submit" value="{{ 'resetting.reset.submit'|trans }}"  class="form-button form-button-green"/>
    <div class="clear"></div>
    </div>
</form>
</div>
</div>
