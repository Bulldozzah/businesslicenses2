{% extends 'WebmastersAfricaAdminBundle::adminlayout.html.twig' %}

{% trans_default_domain 'WebmastersAfricaTaskBundle' %}

{% block page_title %}
  {{ site_title }},
  {{ 'tasks.tasks' | trans }}
{% endblock %}

{% block header %}
  <!-- Title area -->
  <div class="titleArea">
    <div class="wrapper">
      <div class="pageTitle">
        <h5>Enter Reasons For Declining License Details</h5>
      </div>
    </div>
  </div>
{% endblock %}

{% block body %}
  <div class="widget">
    <div class="title"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/frames.png') }}" alt="" class="titleIcon"/>
      <h6>Reasons For Declining</h6>
    </div>
    <div>
      <form action="{{ path('managetask_reject_post', {'id': id, 'stage_id': stage_id }) }}" method="post">
        <textarea class="form-control" cols="50" id="reasons_for_decline" name="decline_reasons"rows="100" placeholder="Enter your assessment results .."></textarea>
        <input type="hidden" name="license" value={{ id }}>
        <div class="clearfix"></div>
        <button class="w3-right w3-center w3-button w3-blue w3-round-medium" style="padding: 10px 30px 30px 30px; margin-right:15px;">Decline</button>
      </form>
    </div>

    <script>
     ClassicEditor
            .create( document.querySelector( '#reasons_for_decline' ) )
            .catch( error => {
                console.error( error );
            } );
    // Requirements
    </script>
  {% endblock %}
