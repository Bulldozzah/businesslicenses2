{# src/WebmastersAfrica/PressBundle/Resources/views/Default/index.html.twig #}

{% extends 'WebmastersAfricaAdminBundle::adminlayout.html.twig' %}

{% trans_default_domain 'WebmastersAfricaLicenseBundle' %}

{% block page_title %}{{ site_title }}, {{ 'licenses.license_details' | trans }}{% endblock %}

{% block header %}
<!-- Title area -->
{% if entity.taskStatus == 'pending' %}
	<div class="titleArea" style="margin-top: -25px;">
	    {% if entity.decline %}
	        <div class="wrapper">
	            <h5>The license was sent back for corrections with the following issues:</h5>
	            <div class="w3-panel w3-pale-blue w3-leftbar w3-rightbar w3-border-blue">
	                <div>
	                {{ entity.taskDescription|raw }}
	                 </div>
	            </div>
	        </div>

	    {% endif %}
	</div>
	<div class="title">
	    <div class="wrapper">
	        {% if entity.decline == 1 %}
	        		{% if entity.license.stage.type == 'corrections' %}
	            	<a href="{{ path('managelicenses_edit', {'id': entity.license.id, 'stage_id': entity.license.stage.id }) }}" class="w3-button w3-hover-blue w3-green w3-round-medium" onclick="return confirm('Confirm Action ?')">Edit license details</a>
	            {% endif %}
              {% if entity.license.stage.type == 'assess' %} 
                 <a href="{{ path('managetask_reject', {'id': entity.license.id, 'stage_id': entity.stage.id}) }}" class="w3-button w3-hover-teal w3-round-large w3-red w3-medium" onclick="return confirm('Confirm Action ?')">Send to agency</a>
              {% endif %}
	        {% else %}

	            {% if entity.license.stage.type == 'assess' %}
	                <a href="{{ path('my_task_approve', {'id': entity.license.id, 'stage_id': entity.license.stage.id }) }}" class="wButton bluewB" style="width: 120px;" onclick="return confirm('Confirm Action ?')" >Approve</a>
	                <a href="{{ path('managetask_reject', {'id': entity.license.id, 'stage_id': entity.license.stage.id }) }}" class="wButton redwB" style="width: 120px;" onclick="return confirm('Confirm Action ?')">Reject</a>
	            {% endif %}
	            {% if entity.license.stage.type == 'publish' %}
	                <a href="{{ path('my_task_approve', {'id': entity.license.id, 'stage_id': entity.license.stage.id }) }}" class="wButton bluewB" style="width: 120px;" onclick="return confirm('Confirm Action ?')">Publish</a>
	                <a href="{{ path('managetask_reject', {'id': entity.license.id, 'stage_id': entity.license.stage.id}) }}" class="wButton redwB" style="width: 120px;" onclick="return confirm('Confirm Action ?')">Reject</a>
	            {% endif %}
	        {% endif %}
	            <span style="padding-left : 35%;">
	                <span style="font-size: 18px;">Stage:
	                </span>
	                <span style="font-size: 18px; color: red;">{{ entity.license.stage }}</span>
	            </span>
	    </div>
	</div>
{% else	%}
	<div class="titleArea">
		<div class="wrapper">
		{{ entity.taskDescription|raw }}
		<p><span>Status: </span><span>{{entity.taskStatus}}</span></p>
	</div>
	</div>
{% endif %}
{% endblock %}

{% block body %}

<link rel="stylesheet" type="text/css" href="{{ asset('bundles/webmastersafricaadmin/css/bootstrap-duallistbox.css') }}">
<script src="//maxcdn.bootstrapcdn.com/bootstrap/3.2.0/js/bootstrap.min.js"></script>
<script src="//cdnjs.cloudflare.com/ajax/libs/prettify/r298/run_prettify.min.js"></script>
<script type="text/javascript" src="{{ asset('bundles/webmastersafricaadmin/js/jquery.bootstrap-duallistbox.js') }}"></script>


<input type="hidden" name="_method" value="PUT" />

<!-- Tabs -->
<div class="widget">
     {% for flashMessage in app.session.flashbag.get('update') %}
        <div class="nNote nFailure hideit">
            <p>
                <strong>Success:
                </strong>
                {{ flashMessage }}
            </p>
        </div>
    {% endfor %}
    <div class="title"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/frames.png') }}" alt="" class="titleIcon" />
    <h6>
      {{ 'licenses.license_details' | trans }}
    </h6>

    <div class="num">
         <a href="{{ path('my_task') }}" title="{{ 'licenses.back_to_list' | trans }}" class="redNum">{{ 'licenses.back_to_list' | trans }}</a>
      </div>
    </div>
    <ul class="tabs">
        <li><a href="#tab1">{{ 'licenses.license_details' | trans }}</a></li>
        <li>
            <a href="#tab6">License Legal Basis</a>
        </li>
        {% if customfields | length > 0 %}
        <li><a href="#tab4">{{ 'licenses.license_additional_details' | trans }}</a></li>
        {% endif %}
        <li><a href="#tab2">{{ 'licenses.license_requirements' | trans }}</a></li>
        <li><a href="#tab3">{{ 'licenses.license_downloads' | trans }}</a></li>
        <li><a href="#tab7">Movement History</a><li>
        <li><a href="#tab8">Review History</a><li>
    </ul>
    <div class="tab_container">
        <div id="tab1" class="tab_content nopadding">
            <div class="w3-row">
                <div class="w3-col s2">
                   <b>Business License Name:</b>
                </div>
                <div class="w3-col s10 text-align">
                    {{ entity.license.name|raw}}
                </div>
            </div>
            <hr />
            {% if ('19' in showedfields) %}
                <div class="w3-row">
                    <div class="w3-col s2">
                       <b>Jurisdiction</b>
                    </div>
                    <div class="w3-col s10 text-align">
                        {{ entity.license.location|raw}}
                    </div>
                </div>
            {% endif %}
<hr />
            <div class="w3-row">
                <div class="w3-col s2">
                   <b>Agency:</b>
                </div>
                <div class="w3-col s10 text-align">
                    {{ entity.license.agency|raw}}
                </div>
            </div>
<hr />
            {% if ('4' in showedfields) %}
                <div class="w3-row">
                    <div class="w3-col s2">
                       <b>Description:</b>
                    </div>
                    <div class="w3-col s10 text-align">
                        {{ entity.license.description|raw }}
                    </div>
                </div>
            {% endif %}
<hr />
       
            {% if ('3' in showedfields) %}

                <div class="w3-row">
                    <div class="w3-col s2">
                       <b>Purpose:</b>
                    </div>
                    <div class="w3-col s10 text-align">
                        {{ entity.license.purpose|raw}}
                    </div>
                </div>
            {% endif %}
            <hr />
            <div class="w3-row">
                <div class="w3-col s2">
                   <b>Keywords:</b>
                </div>
                <div class="w3-col s10 text-align">
                    {{ entity.license.keywords|raw }}
                </div>
            </div>
<hr />
            <div class="w3-row">
                <div class="w3-col s2">
                   <b>Activities:</b>
                </div>
                <div class="w3-col s10 text-align">
                    <ul class="w3-ul w3-item">
                    {% for activity in entity.license.activities %}
                        <li>{{ activity.name|raw }}</li>
                    {% endfor %}
                    </ul>
                </div>
            </div>
            <hr />
            {% if ('5' in showedfields) %}
            <div class="w3-row">
                <div class="w3-col s2">
                   <b>Comments:</b>
                </div>
                <div class="w3-col s10 text-align">
                    {{ entity.license.comments|raw}}
                </div>
            </div>
            {% endif %}
            <hr />
            {% if ('6' in showedfields) %}
                <div class="w3-row">
                    <div class="w3-col s2">
                       <b>Business License No:</b>
                    </div>
                    <div class="w3-col s10 text-align">
                        {{ entity.license.licenseNo|raw}}
                    </div>
                </div>
            {% endif %}
<hr />
            {% if ('7' in showedfields) %}
                <div class="w3-row">
                    <div class="w3-col s2">
                       <b>Application Fee:</b>
                    </div>
                    <div class="w3-col s10 text-align">
                        {{ entity.license.applicationFee|raw}}
                    </div>
                </div>
            {% endif %}
<hr />
            {% if ('8' in showedfields) %}
                <div class="w3-row">
                    <div class="w3-col s2">
                       <b>license Fee:</b>
                    </div>
                    <div class="w3-col s10 text-align">
                        {{ entity.license.licenseFee|raw}}
                    </div>
                </div>
            {% endif %}
<hr />
            {% if ('9' in showedfields) %}
                <div class="w3-row">
                    <div class="w3-col s2">
                       <b>Maxium Processing Time:</b>
                    </div>
                    <div class="w3-col s10 text-align">
                        {{ entity.license.maxProcessingTime|raw}}
                    </div>
                </div>
            {% endif %}
<hr />
            {% if ('10' in showedfields) %}
                <div class="w3-row">
                    <div class="w3-col s2">
                       <b>Gazetted On:</b>
                    </div>
                    <div class="w3-col s10 text-align">
                        {{ entity.license.gazettedOn|raw}}
                    </div>
                </div>
            {% endif %} 
            <hr />
            {% if ('11' in showedfields) %}

                <div class="w3-row">
                    <div class="w3-col s2">
                       <b>Related Website:</b>
                    </div>
                    <div class="w3-col s10 text-align">
                        {{ entity.license.relatedWebsites|raw}}
                    </div>
                </div>
            {% endif %}
            <hr />
            {% if ('12' in showedfields) %}

                <div class="w3-row">
                    <div class="w3-col s2">
                       <b>Validity:</b>
                    </div>
                    <div class="w3-col s10 text-align">
                        {{ entity.license.validity|raw}}
                    </div>
                </div>
            {% endif %}
            <hr />
            {% if ('13' in showedfields) %}

                <div class="w3-row">
                    <div class="w3-col s2">
                       <b>Enactment:</b>
                    </div>
                    <div class="w3-col s10 text-align">
                        {{ entity.license.enactment|raw}}
                    </div>
                </div>
            {% endif %}
            <hr />
            {% if ('14' in showedfields) %}
                <div class="w3-row">
                    <div class="w3-col s2">
                       <b>Gazetting Reference:</b>
                    </div>
                    <div class="w3-col s10 text-align">
                        {{ entity.license.gazettingRef|raw}}
                    </div>
                </div>
            {% endif %} 
            <hr />
            {% if ('15' in showedfields) %}
                <div class="w3-row">
                    <div class="w3-col s2">
                       <b>Contact Office:</b>
                    </div>
                    <div class="w3-col s10 text-align">
                        {{ entity.license.contactOffice|raw}}
                    </div>
                </div>
            {% endif %}
            <hr />
            {% if ('16' in showedfields) %}
                <div class="w3-row">
                    <div class="w3-col s2">
                       <b>Resolution Criteria:</b>
                    </div>
                    <div class="w3-col s10 text-align">
                        {{ entity.license.resolutionCriteria|raw}}
                    </div>
                </div>
            {% endif %}
            <hr />
            {% if ('18' in showedfields) %}
                <div class="w3-row">
                    <div class="w3-col s2">
                       <b>Universal</b>
                    </div>
                    <div class="w3-col s10 text-align">
                        {{ entity.license.universal|raw}}
                    </div>
                </div>
            {% endif %}
            <hr />
        </div>
        <div id="tab6" class="tab_content nopadding">

            {% if ('24' in showedfields) %}
                <div class="formRow">
                    <b>Principle Legislation: </b> {{ entity.license.principleLegislation }}
                    <div class="formRight">
                        {% if entity.license.principleLegislationAttachment %}
                              <a class="w3-button w3-white w3-border w3-border-blue w3-small"  target="_blank"  href="{{ app.request.basepath }}/uploads/documents/{{ entity.license
                              .principleLegislationAttachment }}">Click To Download</a>
                        {% endif %}
                    </div>
                    <div class="clear"></div>
                </div>
                <div class="cLine"></div>
                {% if entity.license.subsidiaryLegislation.count > 0 %}
                    Subsidiary Legislation:
		                <div class="clear"></div>
		                {% for docs in entity.license.subsidiaryLegislation %}
		                    <div class="formRow">
		                        {% if docs.name %}
		                            {{ docs.name }}
		                        {% endif %}
		                        {% if docs.filepath %}
		                            <div class="formRight">
		                                <a class="w3-button w3-white w3-border w3-border-blue w3-small"  target="_blank" href="{{ app.request.basepath }}/uploads/documents/{{ docs
		                                  .filepath }}">Click To Download</a>
		                            </div>
		                        {% endif %}
		                    </div>
		                {% endfor %}
		                <div class="clear"></div>
                {% endif %}
            {% endif %}
        </div>
        <div id="tab4" class="tab_content nopadding">
            {% set value = '' %}
            {% for field in customfields %}
                <div class="formRow">
                    <label>{{ field.fieldLabel }}</label>
                    <div class="formRight">
                         {% for data in field.fielddatas %}
                            {% if data.licenseId == entity.license.id %}
                                {{ data.fielddata }}
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}
        </div>
        <div id="tab2" class="tab_content nopadding">
            <ul>
                {% set count = 0 %}
                {% for requirement in entity.license.requirements %}
                {% set count = count + 1 %}
                    <li id='req_{{ count }}'>
                        <div class="formRow">
                            {{ requirement.description }}
                             <div class="clear"></div>
                        </div>
                        <div class="clear"></div>
                        <div class="cLine"></div>
                    </li>
                {% endfor %}

            </ul>
        </div>
        <div id="tab3" class="tab_content nopadding">
            <ul class="downloads">
                {% set count = 0 %}
                {% for download in entity.license.downloads %}
                {% set count = count + 1 %}
                    <li id='down_{{ count }}'>
                        <div class="formRow">
                            {{ download.name }}
                            <div class="clear"></div>
                        </div>
                        <div class="formRow">
                            {{ download.issuingBody }}
                            <div class="clear"></div>
                        </div>
                        <div class="formRow">
                            {% if download.filepath %}
                             <a class="w3-button w3-white w3-border w3-border-blue w3-small" target="_blank" href="{{ app.request.basepath }}/uploads/documents/{{ download.filepath }}">Click To Dowload
                             </a>

                            {% endif %}
                        </div>
                        <div class="cLine"></div>
                    </li>
                {% endfor %}
            </ul>
            <div class="clear"></div>
        </div>

        <div id="tab7" class="tab_content nopadding">
            <div class="w3-responsive">
            <table class="w3-table w3-table-all">
                <tr>
                    <th>User</th>
                    <th>Action Taken</th>
                    <th>From</th>
                    <th>To</th>
                </tr>
                <tbody>
                    {% for item in entity.license.history %}
                        <tr>
                            <td>{{ item.user }}</td>
                            <td>{{ item.actionType }}</td>
                            <td>{{ item.previousStage }}</td>
                            <td>{{ item.currentStage }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            </div>
        </div>
        <div id="tab8" class="tab_content nopadding">
            <div class="w3-responsive">
                <table class="w3-table w3-table-all">
                    <tr>
                        <th>Comment</th>
                        <th>From</th>
                    </tr>
                    <tbody>
                        {% for item in entity.license.tasks %}
                            {% if item.decline == 1 %}
                                <tr>
                                    <td>
                                        {{ item.taskDescription|raw }}
                                    </td>
                                    <td>
                                        {{ item.assigner }}
                                    </td>
                                </tr>
                            {% endif %}
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div> 
 </div>
 <style type="text/css">
   div#text-align {
      text-align: justify;
      text-justify: inter-word;
    }
 </style>
{% endblock %}
