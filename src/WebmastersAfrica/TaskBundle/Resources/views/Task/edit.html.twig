{# src/WebmastersAfrica/PressBundle/Resources/views/Default/index.html.twig #}

{% extends 'WebmastersAfricaAdminBundle::adminlayout.html.twig' %}

{% trans_default_domain 'WebmastersAfricaTaskBundle' %}

{% block page_title %}{{ site_title }}, {{ 'tasks.edit_task' | trans }}{% endblock %}

{% block header %}
<!-- Title area -->
<div class="titleArea">
    <div class="wrapper">
        <div class="pageTitle">
            <h5>{{ 'tasks.edit_task' | trans }}</h5>
            <span>{{ 'tasks.edit_task_description' | trans }}</span>
        </div>
        <div class="middleNav" style="border: none;">
                <a href="{{ path('managetasks') }}" title="{{ 'tasks.back_to_list' | trans }}" class="wButton redwB ml15 m10"><span>{{ 'tasks.back_to_list' | trans }}</span></a>
            <div class="clear"></div>
        </div>
        <div class="clear"></div>
    </div>
</div>
{% endblock %}

{% block body %} 
 <form action="{{ path('managetasks_update', { 'id': entity.id }) }}" method="post" {{ form_enctype(edit_form) }} class="form">
        <input type="hidden" name="_method" value="PUT" />
		{{ form_row(edit_form.taskDescription) }}
        {{ form_row(edit_form.taskStartDate) }}
        {{ form_row(edit_form.taskEndDate) }}
        {{ form_row(edit_form.assignee) }}
        {{ form_row(edit_form.license) }}
        {{ form_row(edit_form.update) }}
        <div style="display: none;">
            {{ form_rest(edit_form) }}
        </div>
	</form>
    <br>
    <div>
    	{{ form(delete_form) }}
	</div>
{% endblock %}
