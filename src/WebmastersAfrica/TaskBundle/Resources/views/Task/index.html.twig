{# src/WebmastersAfrica/PressBundle/Resources/views/Default/index.html.twig #}

{% extends 'WebmastersAfricaAdminBundle::adminlayout.html.twig' %}

{% trans_default_domain 'WebmastersAfricaTaskBundle' %}

{% block page_title %}{{ site_title }}, {{ 'tasks.tasks' | trans }}{% endblock %}

{% block header %}
<!-- Title area -->
<div class="titleArea">
    <div class="wrapper">
        <div class="pageTitle">
            <h5>{{ 'tasks.tasks' | trans }}</h5>
            <span>{{ 'tasks.description' | trans }}</span>
        </div>
        <div class="controlB">
                <ul>
                    <li><a href="{{ path("managetasks_new") }}" title=""><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/control/32/plus.png') }}" alt="" /><span>{{ 'tasks.add_new_tasks' | trans }}</span></a></li>
                </ul>
                <div class="clear"></div>
            </div>
        <div class="clear"></div>
    </div>
</div>
{% endblock %}

{% block body %} 
<div class="widget">
    <div class="title"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/frames.png') }}" alt="" class="titleIcon" />
    <h6>{{ 'tasks.list_of_tasks' | trans }}</h6></div>
        <table cellpadding="0" cellspacing="0" width="100%" class="sTable" id="res">
        <thead>
            <tr>
                <td width="5%">#</th>
                <td>{{ 'tasks.description' | trans }}</td>
                <td>{{ 'tasks.start_date' | trans }}</td>
                <td>{{ 'tasks.end_date' | trans }}</td>
                <td>{{ 'tasks.assigned_by' | trans }}</td>
                <td>{{ 'tasks.status' | trans }}</td>
                <td>{{ 'tasks.actions' | trans }}</td>
            </tr>
        </thead>
        <tbody>
        {% for entity in pagination %}
            <tr>
                <td><a href="{{ path('managetasks_show', { 'id': entity.id }) }}">{{ entity.id }}</a></td>
                <td>{{ entity.taskDescription }}</td>
                <td>{% if entity.taskStartDate %}{{ entity.taskStartDate|date('Y-m-d H:i:s') }}{% endif %}</td>
                <td>{% if entity.taskEndDate %}{{ entity.taskEndDate|date('Y-m-d H:i:s') }}{% endif %}</td>
                <td>{{ entity.assigner }}</td>
                <td>{{ entity.taskStatus }}</td>
                <td>
                <ul>
                    <li>
                        <a href="{{ path('managetasks_edit', { 'id': entity.id }) }}"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/pencil.png') }}" alt="{{ 'tasks.edit' | trans }}"></a>
                    </li>
                </ul>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
    <div class="navigation">
        {{ knp_pagination_render(pagination) }}
    </div>
</div>
{% endblock %}
