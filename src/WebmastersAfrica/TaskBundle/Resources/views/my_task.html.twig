{% extends 'WebmastersAfricaAdminBundle::adminlayout.html.twig' %}

{% trans_default_domain 'WebmastersAfricaTaskBundle' %}

{% block page_title %}
  {{ site_title }},
  {{ 'tasks.tasks' | trans }}
{% endblock %}

{% block header %}
  <!-- Title area -->
  <div class="titleArea">
    <div class="wrapper">
      <div class="pageTitle">
        <h5>Task</h5>
        <span>My Task List</span>
      </div>
    </div>
  </div>
{% endblock %}

{% block body %}
  {% for flashMessage in app.session.flashbag.get('success') %}
    <div class="nNote nSuccess hideit">
      <p>
        <strong>Success:
        </strong>
        {{ flashMessage }}
      </p>
    </div>
  {% endfor %}


  <div class="widget">
    <div class="title"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/frames.png') }}" alt="" class="titleIcon"/>
      <h6>My Task</h6>
    </div>
    <table cellpadding="0" cellspacing="0" class="sTable w3-table-all" id="res task_table" width="100%">
      <thead>
        <tr>
          <th width="5%">#</th>
          <th>{{ 'tasks.description' | trans }}</th>
          <th>{{ 'tasks.start_date' | trans }}</th>
          <th>{{ 'tasks.assigned_by' | trans }}</th>
          <th>{{ 'tasks.status' | trans }}</th>
          <th>{{ 'tasks.actions' | trans }}</th>
        </tr>
      </thead>
      <tbody>
        {% for entity in pagination %}
          <tr>
            <td>
              <a href="{{ path('managetasks_start', { 'id': entity.id }) }}">{{ entity.id }}</a>
            </td>
            <td>{{ entity.taskDescription }}</td>
            <td>
              {% if entity.taskStartDate %}
                {{ entity.taskStartDate|date('Y-m-d H:i:s') }}
              {% endif %}
            </td>
            <td>{{ entity.assigner }}</td>
            <td style="color: red;">{{ entity.taskStatus }}</td>
            <td>
              <ul>
                <li>
                  <a href="{{ path('managetasks_start',{'id':entity.id}) }}" class="w3-button w3-white w3-border w3-border-blue">
                    Start Task
                  </a>
                </li>
                {% if is_expr_granted("hasRole('MANAGE_TASK')") %}
                  <li>
                    <a href="{{path('managetasks_delete',{'id':entity.id})}}" class="w3-button w3-white w3-border w3-border-red">
                      Delete
                    </a>
                  </li>
                {% endif %}
              </ul>
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endblock %}
{% block stylesheet_2 %}

  <link href="https://cdn.datatables.net/1.10.19/css/jquery.dataTables.min.css" rel="stylesheet">
  <script>
    $(document).ready(function () {
      $('#task_table').DataTable();
    });
  </script>
{% endblock %}
