{# src/WebmastersAfrica/PressBundle/Resources/views/Default/index.html.twig #}

{% extends 'WebmastersAfricaAdminBundle::adminlayout.html.twig' %}

{% trans_default_domain 'WebmastersAfricaLicenseBundle' %}

{% block page_title %}{{ site_title }}, {{ 'fixed_license_fields.fixed_license_fields' | trans }}{% endblock %}

{% block header %}
<!-- Title area -->
<div class="titleArea">
    <div class="wrapper">
        <div class="pageTitle">
            <h5>{{ 'fixed_license_fields.fixed_license_fields' | trans }}</h5>
            <span>{{ 'fixed_license_fields.fixed_fields_description' | trans }}</span>
        </div>
        <div class="controlB">
                <div class="clear"></div>
            </div>
        <div class="clear"></div>
    </div>
</div>
{% endblock %}

{% block body %} 
<div class="widget">
    <div class="title"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/cog2.png') }}" alt="" class="titleIcon" />
    <h6>{{ 'fixed_license_fields.list_of_fields' | trans }}</h6></div>
        <table cellpadding="0" cellspacing="0" width="100%" class="sTable" id="license_fixed_field">
        <thead>
            <tr>
                <td width="40">#</td>
                <td>{{ 'fixed_license_fields.field_label' | trans }}</td>
                <td width="120">{{ 'fixed_license_fields.showed' | trans }}</td>
                <td width="120">{{ 'fixed_license_fields.required' | trans }}</td>
                <td width="40">{{ 'fixed_license_fields.actions' | trans }}</td>
            </tr>
        </thead>
        <tbody>
        {% for entity in entities %}
            <tr>
                <td align="center"><a href="{{ path('managefixedfields_show', { 'id': entity.id }) }}">{{ entity.id }}</a></td>
                <td>{{ entity.fieldlabel }}</td>
                <td align="center">
                {% if entity.showed == true %}
                <span class="smallButton"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/check.png') }}" alt="Showed"></span>
                {% else %}
                <span class="smallButton"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/close.png') }}" alt="Not Showed"></span>
                {% endif %}
                </td>
                <td align="center">
                {% if entity.required == true %}
                <span class="smallButton"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/check.png') }}" alt="Required"></span>
                {% else %}
                <span class="smallButton"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/close.png') }}" alt="Not Required"></span>
                {% endif %}
                </td>
                <td>
                <ul>
                    <li>
                         <a href="{{ path('managefixedfields_edit', { 'id': entity.id }) }}" class="smallButton">
							<img alt="{{ 'fixed_license_fields.edit' | trans }}" src="{{ asset('bundles/webmastersafricaadmin/images/icons/color/pencil.png') }}">
						</a>
                    </li>
                </ul>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
</div>
{% endblock %}

{% block stylesheet_2 %}
<script>
    $(document).ready( function () {
      $('#license_fixed_field').DataTable();
      // $(".dataTables_filter input").addClass("w3-input w3-border w3-animate-input");
    } );
  </script>
{% endblock %}

