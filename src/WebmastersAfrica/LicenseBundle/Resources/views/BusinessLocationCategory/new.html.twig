
{% extends 'WebmastersAfricaAdminBundle::adminlayout.html.twig' %}

{% trans_default_domain 'WebmastersAfricaLicenseBundle' %}

{% block page_title %}{{ site_title }}, {{ 'locations.add_new_location' | trans }}{% endblock %}

{% block header %}

<!-- Title area -->
<div class="titleArea">
    <div class="wrapper">
        <div class="pageTitle">
            <h5>{{ 'locations.add_new_location' | trans }}</h5>
            <span>Add new Jurisdiction Category</span>
        </div>
        <div class="clear"></div>
    </div>
</div>
{% endblock %}

{% block body %}
  {% for flashMessage in app.session.flashbag.get('update') %}
    <div class="nNote nSuccess hideit">
      <p>
        <strong>Success:
        </strong>
        {{ 'licenses.updated_item_notice' | trans }}
      </p>
    </div>
  {% endfor %}
  {% for flashMessage in app.session.flashbag.get('delete') %}
    <div class="nNote nSuccess hideit">
      <p>
        <strong>Success:
        </strong>
        {{ 'licenses.deleted_item_notice' | trans }}
      </p>
    </div>
  {% endfor %}
  {% for flashMessage in app.session.flashbag.get('unsuccessdelete') %}
    <div class="nNote nFailure hideit">
        <p>
            <strong>Error: </strong>
        {{ flashMessage }}
        </p>
    </div>
{% endfor %}
	<div class="widget">
		<div class="title">
		<img class="titleIcon" alt="" src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/globe.png') }}">
		<h6>{{ 'locations.add_new_location' | trans }}</h6>

		<div class="num">
			<a href="{{ path('managebusinesslocationcategory') }}" title="{{ 'locations.back_to_list' | trans }}" class="greyNum w3-button w3-round-large w3-hover-red">{{ 'locations.back_to_list' | trans }}</a>
			</div>
		</div>
		<div class="body nopadding">
			{{ form_start(form, {'attr': {'class': 'form', 'novalidate':'novalidate'}}) }}
	    <input name="_method" type="hidden" value="POST"/>
	    <div id="errors">
	      {{ form_errors(form) }}
	    </div>
        {{ form_row(form.name, { 'attr': {'class': 'w3-input w3-border form-control'} }) }}
        {{ form_row(form.published )}}
       	 <div class="formSubmit">
					{{ form_row(form.submit, { 'attr': {'class':'w3-right w3-center w3-button w3-blue w3-round-medium', 'style':'padding: 10px 30px 30px 30px; margin-right:15px;'} }) }}
					</div>
					<div class="clear"></div>
        {{ form_end(form) }}
			</div>
	</div>
 <script src="{{ asset('bundles/webmastersafricapress/new/assets/validate.js') }}"></script>
    <script>
        $(".label-required").append("<i style='color: red;'>*</i> ");
        $(".form").validate();
    </script>
{% endblock %}

