{% extends 'WebmastersAfricaAdminBundle::adminlayout.html.twig' %}
{% trans_default_domain 'WebmastersAfricaLicenseBundle' %}
{% block page_title %}
    Eregistry | show
    {{ entity.name }}
{% endblock %}

{% block header %}
    <!-- Title area -->
    <div class="titleArea">
        <div class="wrapper">
            <div class="pageTitle">
                <h3>
                    <b>Name:</b>
                    {{ entity.name }}
                </h3>
            </div>
            <div class="clear"></div>
        </div>
        <div class="statsRow">
            <div class="wrapper w3-center">
                <div class="w3-show-inline-block">
                    <div class="w3-bar">

                        <a href="{{ path("manageagencies_office_new", {'agency_id': agency }) }}" title="" class="w3-button w3-hover-red w3-round-large w3-green w3-medium" title="" href="#">
                            <img alt="" src="{{ asset('bundles/webmastersafricaadmin/images/icons/sPlus.png') }}" alt=""/>
                            <span>Add new Agency Office</span>
                        </a>
                        <a href="{{ path("manageagencies", {'agency_id': agency}) }}" title="" class="w3-button w3-hover-red w3-round-large w3-red w3-medium" title="" href="#">
                            <i class="fa fa-bars"></i>
                            <span>
                                Agency List
                            </span>
                        </a>

                        <div class="clear"></div>
                    </div>
                </div>
                <div class="clear"></div>
            </div>
        </div>
    </div>
{% endblock %}

{% block body %}
    {% for flashMessage in app.session.flashbag.get('update') %}
        <div class="nNote nSuccess hideit">
            <p>
                <strong>Success:
                </strong>
                {{ 'licenses.updated_item_notice' | trans }}
            </p>
        </div>
    {% endfor %}
    {% for flashMessage in app.session.flashbag.get('create') %}
        <div class="nNote nSuccess hideit">
            <p>
                <strong>Success:
                </strong>
                {{ 'licenses.created_item_notice' | trans }}
            </p>
        </div>
    {% endfor %}
    {% for flashMessage in app.session.flashbag.get('delete') %}
        <div class="nNote nSuccess hideit">
            <p>
                <strong>Success:
                </strong>
                {{ 'licenses.deleted_item_notice' | trans }}
            </p>
        </div>
    {% endfor %}

    <div class="widget">
        <div class="title">
            <img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/docs.png') }}" alt="" class="titleIcon"/>
            <h6>Agency offices</h6>
        </div>

        <form id="batch_form" name="batch_form" action="{{ path("batch_businessagency_offices", {'agency_id': agency}) }}" method="post">
            <table cellpadding="0" cellspacing="0" width="100%" class="sTable mTable w3-table-all w3-card-4" id="forward_plans_table">
                <thead>
                    <tr>
                        <td width="40">
                            <div>&middot;&middot;&middot;</div>
                        </td>
                        <td>{{ 'agencies.name' | trans }}</td>
                        <td>{{ 'agencies.address' | trans }}</td>
                        <td>{{ 'agencies.actions' | trans }}</td>
                    </tr>
                </thead>
                <tfoot>
                    <tr>
                        <td colspan="4">
                            <div class="itemActions">
                                <select id="batch_select" name="batch_select" class="form-control" onchange="if(atLeastOne()){ if(confirm('{{ 'locations.batch_confirm_1' | trans }} ' + this.value + ' {{ 'locations.batch_confirm_2' | trans }}')){ document.getElementById('batch_form').submit(); } }">
                                    <option>{{ 'locations.select_batch' | trans }}...</option>
                                    <option value="delete">{{ 'locations.delete' | trans }}</option>
                                </select>
                            </div>
                        </td>
                    </tr>
                </tfoot>
                <tbody>
                    {% for offices in entity.agencyoffices %}
                        <tr>
                            <td>
                                <input type="checkbox" name="batch_items[]" value="{{ offices.id }}">
                            </td>
                            <td align="center">
                                {{ offices.name }}
                            </td>
                            <td>{{ offices.address }}</td>
                            <td>
                                <ul>
                                    <li><a href="{{path('manageagencies_office_edit',{'agency_id':agency,'id':offices.id})}}" class="smallButton"><img alt="agency edit"src="{{asset('bundles/webmastersafricaadmin/images/icons/color/pencil.png')}}"></a></li>
                                </ul>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </form>
    </div>
{% endblock %}
{% block stylesheet_2 %}
    <script>
        $(document).ready(function () {
            $('#forward_plans_table').DataTable();
        });
    </script>
{% endblock %}
