{# src/WebmastersAfrica/PressBundle/Resources/views/Default/index.html.twig #}

{% extends 'WebmastersAfricaAdminBundle::adminlayout.html.twig' %}

{% trans_default_domain 'WebmastersAfricaLicenseBundle' %}

{% block page_title %}
    {{ site_title }},
    {{ 'agencies.add_new_agency' | trans }}
{% endblock %}

{% block header %}
    <!-- Title area -->
    <div class="titleArea">
        <div class="wrapper">
            <div class="pageTitle">
                <h5>{{ 'agencies.add_new_agency' | trans }}</h5>
                <span>{{ 'agencies.add_agency_description' | trans }}</span>
            </div>
            <div class="clear"></div>
        </div>
    </div>
{% endblock %}

{% block body %}
{% for flashMessage in app.session.flashbag.get('agency_create_unsuccess') %}
    <div class="nNote nFailure hideit">
        <p>
            <strong>Error: </strong>
        {{ flashMessage }}
        </p>
    </div>
{% endfor %}

    <div class="widget">
        <div class="title">
            <img class="titleIcon" alt="" src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/home2.png') }}">
            <h6>{{ 'agencies.add_agency_description' | trans }}</h6>

            <div class="num">
                <a href="{{ path('manageagencies') }}" title="{{ 'agencies.back_to_list' | trans }}" class="greyNum w3-button w3-round-large w3-hover-red">{{ 'agencies.back_to_list' | trans }}</a>
            </div>
        </div>
        <div class="body nopadding ">
            <form action="{{ path('manageagencies_create') }}" method="post" {{ form_enctype(form) }} class="form" novalidate="novalidate">

                <ul class="tabs">
                    <li>
                        <a href="#tab1">{{ 'agencies.details' | trans }}</a>
                    </li>
                    {# <li>
                        <a href="#tab2">{{ 'agencies.agencyoffices' | trans }}</a>
                    </li> #}
                </ul>
                <div class="tab_container">
                    <div id="tab1" class="tab_content tab_content_nopadding">
                        {{ form_row(form.title) }}
                        {{ form_row(form.acronym) }}
                        {{ form_row(form.fax) }}
                        {{ form_row(form.address) }}
                        {{ form_row(form.telephone) }}
                        {{ form_row(form.email) }}
                        {{ form_row(form.website) }}
                        {{ form_row(form.hours) }}
                        {{ form_row(form.postal_address) }}
                        {{ form_row(form.latitude) }}
                        {{ form_row(form.longitude) }}
                        {{ form_row(form.file) }}
			            {{ form_row(form.map_scan) }}
                        {{ form_row(form.business_no) }}
                        {{ form_row(form.location) }}
                        {{ form_row(form.users) }}
                        {# {{ form_row(form.industries) }} #}
                    </div>
                    {# <div id="tab2" class="tab_content tab_content_nopadding">
                        <ul class="agencyoffices" data-prototype="{{ form_widget(form.agencyoffices.vars.prototype)|e }}"></ul>
                    </div> #}

                    <div class="formSubmit">
                        {{ form_row(form.submit, { 'attr': {'class':'w3-right w3-center w3-button w3-blue w3-round-medium', 'style':'padding: 10px 30px 30px 30px; margin-right:15px;'} }) }}
                    </div>
                    <div class="clear"></div>
                    <div style="display: none;">
                        {{ form_rest(form) }}
                    </div>
                </form>

            </div>
        </div>
    </div>

    <script src="{{ asset('bundles/webmastersafricapress/new/assets/validate.js') }}"></script>
    <script language="javascript">
        $("#webmastersafrica_licensebundle_businessagency_website").addClass("w3-input w3-border");
        $('#webmastersafrica_licensebundle_businessagency_email').clone().attr('type', 'email').insertAfter('#webmastersafrica_licensebundle_businessagency_email').prev().remove();
        $("#webmastersafrica_licensebundle_businessagency_email").addClass("w3-input w3-border");
        $(".label-required").append("<i style='color: red;'>*</i> ")
        $(".form").validate();

        // Agencyoffices
        var $agencyofficesCollectionHolder;

        var $addAgencyofficeLink = $('<a href="#" class="w3-button w3-hover-teal w3-round-large w3-green w3-medium add_agencyoffice_link"><span>    {{ 'agencies.add_a_agencyoffice' | trans }}</span></a>');
        var $newAgencyofficeLinkLi = $('<li></li>').append($addAgencyofficeLink);

        function addAgencyofficeForm($agencyofficesCollectionHolder, $newAgencyofficeLinkLi) {
            var prototype = $agencyofficesCollectionHolder.data('prototype');

            var index = $agencyofficesCollectionHolder.data('index');

            var newForm = prototype.replace(/__name__/g, index);

            $agencyofficesCollectionHolder.data('index', index + 1);

            var $newFormLi = $('<li></li>').append(newForm);
            addAgencyofficeFormDeleteLink($newFormLi);
            $newAgencyofficeLinkLi.before($newFormLi);
        }

        function addAgencyofficeFormDeleteLink($agencyofficeFormLi) {
            var $removeFormA = $('<a href="#" class="w3-button w3-hover-teal w3-round-large w3-red w3-medium floatR"><span>    {{ 'agencies.delete_this_agencyoffice' | trans }}</span></a><div class="clear"></div><div class="cLine"></div>');

            $agencyofficeFormLi.append($removeFormA);

            $removeFormA.on('click', function (e) { // prevent the link from creating a "#" on the URL
                e.preventDefault();

                // remove the li for the tag form
                $agencyofficeFormLi.remove();
            });
        }


        jQuery(document).ready(function () {

            var demo1 = $('select[name="webmastersafrica_licensebundle_businessagency[users][]"]').bootstrapDualListbox({'helperSelectNamePostfix': false});
            var demo2 = $('select[name="webmastersafrica_licensebundle_businessagency[industries][]"]').bootstrapDualListbox({'helperSelectNamePostfix': false});
            
            $agencyofficesCollectionHolder = $('ul.agencyoffices');

            $agencyofficesCollectionHolder.append($newAgencyofficeLinkLi);

            addAgencyofficeFormDeleteLink($(this));

            $agencyofficesCollectionHolder.data('index', $agencyofficesCollectionHolder.find(':input').length);

            $addAgencyofficeLink.on('click', function (e) {
                e.preventDefault();

                addAgencyofficeForm($agencyofficesCollectionHolder, $newAgencyofficeLinkLi);
                $(".label-required_2").append("<i style='color: red;'>*</i> ")
            });

        });
    </script>

    <style type="text/css">
        .error {
            color: red;
        }
    </style>


{% endblock %}
