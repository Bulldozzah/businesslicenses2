{# src/WebmastersAfrica/PressBundle/Resources/views/Default/index.html.twig #}

{% extends 'WebmastersAfricaAdminBundle::adminlayout.html.twig' %}

{% trans_default_domain 'WebmastersAfricaLicenseBundle' %}


{% block page_title %}{{ site_title }}, {{ 'industries.business_industries' | trans }}{% endblock %}

{% block header %}
<!-- Title area -->
<div class="titleArea">
    <div class="wrapper">
        <div class="pageTitle">
            <h5>{{ 'industries.business_industries' | trans }}</h5>
            <span>{{ 'industries.business_industries_description' | trans }}</span>
        </div>
		<div class="clear"></div>
    </div>
</div>



<div class="line"></div>




<div class="statsRow">

<div class="wrapper w3-center">
    <div class="w3-show-inline-block">
      <div class="w3-bar">
        <a href="{{ path("manageindustries_new") }}" title="" class="w3-button w3-hover-teal w3-round-large w3-green w3-medium" title="" href="#">
        <img alt="" src="{{ asset('bundles/webmastersafricaadmin/images/icons/sPlus.png') }}" alt="" />
        <span>{{ 'industries.add_new_industry' | trans }}</span>
        </a>    				   
    </div>
<div class="clear"></div>
    </div>
</div>
</div>

{% endblock %}

{% block body %} 

{% for flashMessage in app.session.flashbag.get('update') %}
    <div class="nNote nSuccess hideit">
		<p>
			<strong>Success: </strong>
        {{ 'licenses.updated_item_notice' | trans }}
        </p>
    </div>
{% endfor %}

{% for flashMessage in app.session.flashbag.get('unsuccessdelete') %}
    <div class="nNote nFailure hideit">
        <p>
            <strong>Error: </strong>
        {{ flashMessage }}
        </p>
    </div>
{% endfor %}
{% for flashMessage in app.session.flashbag.get('delete') %}
    <div class="nNote nSuccess hideit">
		<p>
			<strong>success: </strong>
        {{ 'licenses.deleted_item_notice' | trans }}
        </p>
    </div>
{% endfor %}
{% for flashMessage in app.session.flashbag.get('create') %}
    <div class="nNote nSuccess hideit">
		<p>
			<strong>success: </strong>
        {{ 'licenses.created_item_notice' | trans }}
        </p>
    </div>
{% endfor %}

<div class="widget">
    <div class="title"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/companies.png') }}" alt="" class="titleIcon" />
    <h6>{{ 'industries.list_of_industries' | trans }}</h6></div>
        <form id="batch_form" name="batch_form" action="{{ path("batch_industries") }}" method="post">
        <table cellpadding="0" cellspacing="0" width="100%" class="sTable mTable" id="industry_location">
        <thead>
            <tr>
                <td width="40"><div>&middot;&middot;&middot;</div></td>
                <td width="40"><div>#</div></td>
                <td>{{ 'industries.name' | trans }}</td>
                <td>{{ 'industries.description' | trans }}</td>
                <td>{{ 'industries.business_types' | trans }}</td>
                <td width="40">{{ 'industries.actions' | trans }}</td>
            </tr>
        </thead>
         <tfoot>
            <tr>
                <td colspan="6">
                	<div class="itemActions">
                        <select id="batch_select" name="batch_select" onChange="if(atLeastOne()){ if(confirm('{{ 'industries.batch_confirm_1' | trans }} ' + this.value + ' {{ 'industries.batch_confirm_2' | trans }}')){ document.getElementById('batch_form').submit(); } }">
                        	<option>{{ 'industries.select_batch' | trans }}...</option>
                        	<option value="unpublish">Unpublish</option>
                    	</select>
                    </div>
                    {{ knp_pagination_render(pagination) }}
                </td>
            </tr>
        </tfoot>
        <tbody>
        {% for entity in pagination %}
            <tr>
                <td><input type="checkbox" name="batch_items[]" value="{{ entity.id }}"></td>
                <td align="center"><a href="{{ path('manageindustries_edit', { 'id': entity.id }) }}">{{ entity.id }}</a></td>
                <td>{{ entity.name }}</td>
                <td>{{ entity.description }}</td>
                <td>
                {% for businesstype in entity.businesstypes %}
                {{ businesstype.name }},
                {% endfor %}
                </td>
                <td>
                <ul>
                    <li>
                         <a href="{{ path('manageindustries_edit', { 'id': entity.id }) }}" class="smallButton"  title="">
							<img alt="{{ 'industries.edit' | trans }}" src="{{ asset('bundles/webmastersafricaadmin/images/icons/color/pencil.png') }}">
						</a>
                    </li>
                </ul>
                </td>
            </tr>
        {% endfor %}
         </tbody>
    </table>
    </form>
</div>
</div>
{% endblock %}

{% block stylesheet_2 %}
<script>
    $(document).ready( function () {
      $('#industry_location').DataTable();
      // $(".dataTables_filter input").addClass("w3-input w3-border w3-animate-input");
    } );
  </script>
{% endblock %}
