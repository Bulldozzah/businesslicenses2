{# src/WebmastersAfrica/PressBundle/Resources/views/Default/index.html.twig #}

{% extends 'WebmastersAfricaAdminBundle::adminlayout.html.twig' %}

{% trans_default_domain 'WebmastersAfricaLicenseBundle' %}

{% block page_title %}
    {{ site_title }},
    {{ 'licenses.edit_business_license' | trans }}
{% endblock %}

{% block header %}
    <!-- Title area -->
    <div class="titleArea">
        <div class="wrapper">
            <div class="pageTitle">
                <h5>{{ 'licenses.edit_business_license' | trans }}</h5>
                <span>{{ 'licenses.edit_license_description' | trans }}</span>
            </div>
            <div class="clear"></div>
        </div>
    </div>
{% endblock %}

{% block body %}

    <link rel="stylesheet" type="text/css" href="{{ asset('bundles/webmastersafricaadmin/css/bootstrap-duallistbox.css') }}">
    <script src="//maxcdn.bootstrapcdn.com/bootstrap/3.2.0/js/bootstrap.min.js"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/prettify/r298/run_prettify.min.js"></script>
    <script type="text/javascript" src="{{ asset('bundles/webmastersafricaadmin/js/jquery.bootstrap-duallistbox.js') }}"></script>


    {{ form_start(edit_form, {'attr': {'class': 'form','id':'demoform','novalidate': 'novalidate'}}) }}

    <input
    type="hidden" name="_method" value="PUT"/>
    <div id="form_error_area"></div>
    <!-- Tabs -->
    <div class="widget">
        <div class="title"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/frames.png') }}" alt="" class="titleIcon"/>
            <h6>
                {{ 'licenses.edit_license_description' | trans }}
            </h6>

            <div class="num">
                <a href="{{ path('managelicenses', { 'id': entity.stage.id }) }}" title="{{ 'licenses.back_to_list' | trans }}" class="redNum">{{ 'licenses.back_to_list' | trans }}</a>
            </div>
        </div>
        <ul class="tabs">
            <li>
                <a href="#tab1">{{ 'licenses.license_details' | trans }}</a>
            </li>
            <li>
                <a href="#tab6">License Legal Basis</a>
            </li>

            {% if customfields | length > 0 %}
                <li>
                    <a href="#tab4">{{ 'licenses.license_additional_details' | trans }}</a>
                </li>
            {% endif %}
            <li>
                <a href="#tab2">{{ 'licenses.license_requirements' | trans }}</a>
            </li>
            <li>
                <a href="#tab3">{{ 'licenses.license_downloads' | trans }}</a>
            </li>
            <li>
                <a href="#tab5" id="confirm_tab">Review License Details</a>
            </li>
        </ul>
        <div class="tab_container">
            <div id="tab1" class="tab_content nopadding">
                <div id="errors">
                    {% if form_errors %}
                        <div class="nNote nFailure hideit">
                            <p>
                                Your form has some errors
                            </p>
                        </div>
                    {% endif %}
                </div>

                {{ form_row(edit_form.name) }}

                {{ form_row(edit_form.keywords) }}

                {% if ('3' in showedfields) %}
                    {{ form_row(edit_form.purpose) }}
                {% endif %}

                {% if ('4' in showedfields) %}
                    {{ form_row(edit_form.description) }}
                {% endif %}

                {% if ('6' in showedfields) %}
                    {{ form_row(edit_form.license_no) }}
                {% endif %}

                {% if ('7' in showedfields) %}
                    {{ form_row(edit_form.application_fee) }}
                {% endif %}

                {% if ('8' in showedfields) %}
                    {{ form_row(edit_form.license_fee) }}
                {% endif %}

                {% for field in customfields %}
                    {% if field.id == 4 %}
                        {% set value = '' %}
                        <div class="formRow">
                            <label class="form-label">{{ field.fieldlabel }}</label>
                            <div class="formRight">
                                {% if field.fieldtype == 1 %}
                                    <input type="text" class="form-control" id="custom[{{ field.id }}]" name="custom[{{ field.id }}]" value="{{ value }}">
                                {% endif %}
                            </div>
                            <div class="clear"></div>
                        </div>
                    {% endif %}
                {% endfor %}
                <div class="clear"></div>

                {% if ('9' in showedfields) %}
                    {{ form_row(edit_form.max_processing_time) }}
                {% endif %}

                {% if ('10' in showedfields) %}
                    {{ form_row(edit_form.gazetted_on) }}
                {% endif %}

                {% if ('11' in showedfields) %}
                    {{ form_row(edit_form.related_websites) }}
                {% endif %}

                {% if ('12' in showedfields) %}
                    {{ form_row(edit_form.validity) }}
                {% endif %}

                {% if ('13' in showedfields) %}
                    {{ form_row(edit_form.enactment) }}
                {% endif %}

                {% if ('14' in showedfields) %}
                    {{ form_row(edit_form.gazetting_ref) }}
                {% endif %}

                {% if ('15' in showedfields) %}
                    {{ form_row(edit_form.contact_office) }}
                {% endif %}

                {% if ('16' in showedfields) %}
                    {{ form_row(edit_form.resolution_criteria) }}
                {% endif %}

                {% if ('18' in showedfields) %}
                    {{ form_row(edit_form.universal) }}
                {% endif %}


                {% if ('19' in showedfields) %}
                    {{ form_row(edit_form.location) }}
                {% endif %}

                {{ form_row(edit_form.agency) }}
                {{ form_row(edit_form.activities, { 'attr': {'class': '','style':'width: 100%'} }) }}
            </div>

            <div class="tab_content nopadding" id="tab6">
                <div>
                    {% if ('24' in showedfields) %}
                        {{ form_row(edit_form.principle_legislation) }}
                        <div class="formRow">
                        	{{ form_label(edit_form.file) }}
                        	<div class="formRight" data-file-name="{{ edit_form.principle_legislation_attachment.vars.value }}">
                        		{{ form_widget(edit_form.file )}}
                        	</div>
                        </div>
                    {% endif %}
                </div>
                <hr>
                <div class="clear"></div>
                <p>Subsidiary Regulations</p>
                <div>
                    {% if ('25' in showedfields) %}
                        <ul class="subsidiary_legislation_downloads" data-prototype="{{ form_widget(edit_form.subsidiary_legislation.vars.prototype)|e }}">
                            {% set count = 0 %}
                            {% for download in edit_form.subsidiary_legislation %}
                                {% set count = count + 1 %}
                                <li id='down_{{ count }}'>
                                    <div class="formRow">
                                        {{ form_label(download.name) }}
                                        <div class="formRight">
                                            {{ form_widget(download.name) }}
                                        </div>
                                        <div class="clear"></div>
                                    </div>
                                    <div class="formRow">
                                        {{ form_label(download.file) }}
                                        <div class="formRight" data-file-name="{{ download.vars.value.filepath }}">
                                            {{ form_widget(download.file) }}
                                        </div>
                                        <div class="clear"></div>
                                    </div>
                                    <a href="#" class="wButton redwB m10 mr10 ml10 floatR" onclick="document.getElementById('down_{{ count }}').parentNode.removeChild(document.getElementById('down_{{ count }}'));">
                                        <span>{{ 'licenses.delete_this_download' | trans }}</span>
                                    </a>
                                    <div class="clear"></div>
                                    <div class="cLine"></div>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
            </div>
            <div id="tab4" class="tab_content nopadding">
                {% if ('5' in showedfields) %}
                    {{ form_row(edit_form.comments) }}
                {% endif %}
                {% set value = '' %}
                {% for field in customfields %}
                    {% if field.id != 4 %}
                        {% for data in field.fielddatas %}
                            {% if data.licenseId == entity.id %}
                                {% set value = data.fielddata %}
                            {% else %}
                                {% set value = '' %}
                            {% endif %}
                        {% endfor %}
                        <div class="formRow">
                            <label>{{ field.fieldlabel }}</label>
                            <div class="formRight">
                                {% if field.fieldtype == 1 %}
                                    <input type="text" id="custom[{{ field.id }}]" name="custom[{{ field.id }}]" value="{{ value }}">
                                {% elseif field.fieldtype == 2 %}
                                    <select id="custom[{{ field.id }}]" name="custom[{{ field.id }}]">
                                        {% set selected = '' %}
                                        {% for choice in field.fieldchoices %}
                                            {% if choice.choicename == value %}
                                                {% set selected = 'selected' %}
                                            {% endif %}
                                            <option value='{{ choice.choicename }}' {{ selected }}>{{ choice.choicename }}</option>
                                        </value>
                                        {% set selected = '' %}
                                    {% endfor %}
                                </select>
                            {% elseif field.fieldtype == 3 %}
                                <textarea id="custom_text_area_{{ field.id }}" name="custom[{{ field.id }}]">{{ value }}</textarea>
                            {% endif %}
                        </div>
                        <div class="clear"></div>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
        {% if ('22' in showedfields) %}
            <div id="tab2" class="tab_content nopadding">
            {{ form_row(edit_form.requirements) }}
            </div>
        {% endif %}
        <div id="tab3" class="tab_content nopadding">
            <ul class="downloads" data-prototype="{{ form_widget(edit_form.downloads.vars.prototype)|e }}">
                {% set count = 0 %}
                {% for download in edit_form.downloads %}
                    {% set count = count + 1 %}
                    <li id='down_{{ count }}'>
                        <div class="formRow">
                            {{ form_label(download.name) }}
                            <div class="formRight">
                                {{ form_widget(download.name) }}
                            </div>
                            <div class="clear"></div>
                        </div>
                        <div class="formRow">
                            {{ form_label(download.issuing_body) }}
                            <div class="formRight">
                                {{ form_widget(download.issuing_body) }}
                            </div>
                            <div class="clear"></div>
                        </div>
                        <div class="formRow">
                            {{ form_label(download.file) }}
                            <div class="formRight" data-file-name="{{ download.vars.value.filepath }}">
                                {{ form_widget(download.file) }}
                            </div>
                            <div class="clear"></div>
                        </div>
                        <a href="#" class="wButton redwB m10 mr10 ml10 floatR" onclick="document.getElementById('down_{{ count }}').parentNode.removeChild(document.getElementById('down_{{ count }}'));">
                            <span>{{ 'licenses.delete_this_download' | trans }}</span>
                        </a>
                        <div class="clear"></div>
                        <div class="cLine"></div>
                    </li>
                {% endfor %}
            </ul>
        </div>
        <div class="tab_content nopadding" id="tab5">
            <h3 class="block">Confirm License Content</h3>
            <div class="w3-row">
                <div class="w3-col s2">
                    <b>License Name:</b>
                </div>
                <div class="w3-col s10 text-align">
                    <span class="form-control-static" id="businesslicense_name"></span>
                </div>
            </div>
            <div class="w3-row">
                <div class="w3-col s2">
                    <b>Keywords:</b>
                </div>
                <div class="w3-col s10 text-align">
                    <span class="form-control-static" id="businesslicense_keywords"></span>
                </div>
            </div>
            <div class="w3-row">
                <div class="w3-col s2">
                    <b>Purpose:</b>
                </div>
                <div class="w3-col s10 text-align">
                    <span class="form-control-static" id="businesslicense_purpose"></span>
                </div>
            </div>
            <div class="w3-row">
                <div class="w3-col s2">
                    <b>Description:</b>
                </div>
                <div class="w3-col s10 text-align">
                    <span class="form-control-static" id="businesslicense_description"></span>
                </div>
            </div>
            <div class="w3-row">
                <div class="w3-col s2">
                    <b>Application Fee:</b>
                </div>
                <div class="w3-col s10 text-align">
                    <span class="form-control-static" id="businesslicense_application_fee"></span>
                </div>
            </div>
            <div class="w3-row">
                <div class="w3-col s2">
                    <b>License Fees:</b>
                </div>
                <div class="w3-col s10 text-align">
                    <span class="form-control-static" id="businesslicense_license_fee"></span>
                </div>
            </div>
            <div class="w3-row">
                <div class="w3-col s2">
                    <b>Renewal Fee:</b>
                </div>
                <div class="w3-col s10 text-align">
                    <span class="form-control-static" id="renewal_fee"></span>
                </div>
            </div>
            <div class="w3-row">
                    <div class="w3-col s2">
                        <b>Processing Fee:</b>
                    </div>
                    <div class="w3-col s10 text-align">
                        <span class="form-control-static" id="processing_fee"></span>
                    </div>
                </div>
            <div class="w3-row">
                <div class="w3-col s2">
                    <b>Maximum Processing time:</b>
                </div>
                <div class="w3-col s10 text-align">
                    <span class="form-control-static" id="businesslicense_max_processing_time"></span>
                </div>
            </div>
            <div class="w3-row">
                <div class="w3-col s2">
                    <b>Related Websites</b>
                </div>
                <div class="w3-col s10 text-align">
                    <span class="form-control-static" id="businesslicense_related_websites"></span>
                </div>
            </div>
            <div class="w3-row">
                <div class="w3-col s2">
                    <b>Validity:</b>
                </div>
                <div class="w3-col s10 text-align">
                    <span class="form-control-static" id="businesslicense_validity"></span>
                </div>
            </div>
            <div class="w3-row">
                <div class="w3-col s2">
                    <b>Contact Office(s):</b>
                </div>
                <div class="w3-col s10 text-align">
                    <span class="form-control-static" id="businesslicense_contact_office"></span>
                </div>
            </div>
            <div class="w3-row">
                <div class="w3-col s2">
                    <b>Agency:</b>
                </div>
                <div class="w3-col s10 text-align">
                    <span class="form-control-static" id="businesslicense_agency"></span>
                </div>
            </div>
            <div class="w3-row">
                <div class="w3-col s2">
                    <b>Principle Legislation:</b>
                </div>
                <div class="w3-col s10 text-align">
                    <span class="form-control-static" id="principle_legislation"></span>
                </div>
            </div>

            <div class="w3-row">
                <div class="w3-col s2">
                    <b>Jurisdiction:</b>
                </div>
                <div class="w3-col s10 text-align">
                    <span class="form-control-static" id="businesslicense_location"></span>
                </div>
            </div>
            <div class="w3-row">
                <div class="w3-col s2">
                    <b>Activities:</b>
                </div>
                <div class="w3-col s10 text-align">
                    <span class="form-control-static" id="businesslicense_activities"></span>
                </div>
            </div>
            <h4 class="form-section">License Additional Details</h4>
            <div class="form-group">
                <div class="col-md-12">
                    <label class="control-label col-md-3">
                        Comments: &nbsp;&nbsp;&nbsp;&nbsp;
                    </label>
                    <div class="col-md-9">
                        <b>
                            <span class="form-control-static" id="license_type"></span>
                        </b>
                    </div>
                </div>
            </div>
            <br />
            <div class="form-group">
                <label class="control-label col-md-3">Legal Basis:</label>
                &nbsp;&nbsp;&nbsp;&nbsp;
                <b>
                    <span class="form-control-static" id="legal_basis"></span>
                </b>
            </div>
            <h4 class="form-section">License Requirements</h4>
            <div class="form-group">
                <label class="control-label col-md-3">Requirement Description:</label>
                <b>
                    <span class="form-control-static" id="requirement_description"></span>
                </b>
            </div>
            <div class="cLine"></div>
            {# <div class="totalAmount">
                <button type="button" class="save-as-draft w3-left w3-center w3-button w3-red w3-round-medium">Save as a Draft</button>
                {{ form_row(form.save) }}
                <div class="clear"></div>
            </div> #}
        </div>

    </div>
    <!--Tab container-->

    <div class="clear"></div>
    <div class="cLine"></div>
    <div class="totalAmount">
        {{ form_row(edit_form.save) }}
        {% if is_expr_granted("hasRole('LICENSE_DELETE')") and entity.status == 'unpublished' %}
            <button class="w3-button w3-hover-teal w3-round-large w3-red w3-medium" type="button" onclick="if(confirm('Are you sure you want to delete this?')){ window.location='{{ path('managelicenses_delete', {'id':entity.id}) }}'; }">Delete</button>
        {% endif %}
        <div class="clear"></div>
    </div>
    <div style="display:none;">
        {{ form_rest(edit_form) }}
    </div>

</div>

{{ form_end(edit_form) }}

<script src="{{ asset('bundles/webmastersafricapress/new/assets/validate.js') }}"></script>
<script language="javascript">

    CKEDITOR.replace("webmastersafrica_licensebundle_businesslicense_purpose");
    CKEDITOR.replace("webmastersafrica_licensebundle_businesslicense_description");
    CKEDITOR.replace("webmastersafrica_licensebundle_businesslicense_comments");
    CKEDITOR.replace("webmastersafrica_licensebundle_businesslicense_related_websites");
    CKEDITOR.replace("webmastersafrica_licensebundle_businesslicense_contact_office");
    CKEDITOR.replace("webmastersafrica_licensebundle_businesslicense_resolution_criteria");
    CKEDITOR.replace("webmastersafrica_licensebundle_businesslicense_requirements");
    CKEDITOR.replace("webmastersafrica_licensebundle_businesslicense_license_fee");
    CKEDITOR.replace("custom[10]");

    // Requirements
    var $requirementCollectionHolder;
    $(".label-required").append("<i style='color: red;'>*</i> ")
    $(".form").validate();

    var $addRequirementLink = $('<a href="#" class="w3-button w3-hover-teal w3-round-large w3-green w3-medium add_requirement_link"><span class="">       {{ 'licenses.add_a_requirement' | trans }}</span></a>');
    var $newRequirementLinkLi = $('<li></li>').append($addRequirementLink);

    function addRequirementForm($requirementCollectionHolder, $newRequirementLinkLi) {
        var prototype = $requirementCollectionHolder.data('prototype');

        var index = $requirementCollectionHolder.data('index');

        var newForm = prototype.replace(/__name__/g, index);

        $requirementCollectionHolder.data('index', index + 1);

        var $newFormLi = $('<li></li>').append(newForm);
        addRequirementFormDeleteLink($newFormLi);
        $newRequirementLinkLi.before($newFormLi);
    }

    function addRequirementFormDeleteLink($requirementFormLi) {
        var $removeFormA = $('<a href="#" class="w3-button w3-hover-teal w3-round-large w3-red w3-medium floatR"><span>       {{ 'licenses.delete_this_requirement' | trans }}</span></a><div class="clear"></div><div class="cLine"></div>');
        $requirementFormLi.append($removeFormA);

        $removeFormA.on('click', function (e) { // prevent the link from creating a "#" on the URL
            e.preventDefault();

            // remove the li for the tag form
            $requirementFormLi.remove();
        });
    }


    jQuery(document).ready(function () {

        var demo1 = $('select[name="webmastersafrica_licensebundle_businesslicense[activities][]"]').bootstrapDualListbox();

        $requirementCollectionHolder = $('ul.requirements');

        $requirementCollectionHolder.append($newRequirementLinkLi);

        addRequirementFormDeleteLink($(this));

        $requirementCollectionHolder.data('index', $requirementCollectionHolder.find(':input').length);

        $addRequirementLink.on('click', function (e) {
            e.preventDefault();

            addRequirementForm($requirementCollectionHolder, $newRequirementLinkLi);
        });

    });

    // Downloads
    var $downloadCollectionHolder;

    var $addDownloadLink = $('<a href="#" class="w3-button w3-hover-teal w3-round-large w3-green w3-medium add_download_link"><span>       {{ 'licenses.add_a_download' | trans }}</span></a>');
    var $newDownloadLinkLi = $('<li></li>').append($addDownloadLink);

    function addDownloadForm($downloadCollectionHolder, $newDownloadLinkLi) {
        var prototype = $downloadCollectionHolder.data('prototype');

        var index = $downloadCollectionHolder.data('index');

        var newForm = prototype.replace(/__name__/g, index);

        $downloadCollectionHolder.data('index', index + 1);

        var $newFormLi = $('<li></li>').append(newForm);
        addDownloadFormDeleteLink($newFormLi);
        $newDownloadLinkLi.before($newFormLi);
    }


    function addDownloadFormDeleteLink($downloadFormLi) {
        var $removeFormA = $('<a href="#" class="w3-button w3-hover-teal w3-round-large w3-red w3-medium floatR"><span>       {{ 'licenses.delete_this_download' | trans }}</span></a><div class="clear"></div><div class="cLine"></div>');
        $downloadFormLi.append($removeFormA);

        $removeFormA.on('click', function (e) { // prevent the link from creating a "#" on the URL
            e.preventDefault();

            // remove the li for the tag form
            $downloadFormLi.remove();
        });
    }

    // Subsidiary Downloads
    var $subsidiaryDownloadCollectionHolder;

    var $subsidiaryAddDownloadLink = $('<a href="#" class="w3-button w3-hover-teal w3-round-large w3-green w3-medium add_download_link"><span><i class="fa fa-plus"></i> Add New Subsidiary Regulation</span></a>');
    var $subsidiaryNewDownloadLinkLi = $('<li></li>').append($subsidiaryAddDownloadLink);

    function subsidiaryAddDownloadForm($subsidiaryDownloadCollectionHolder, $subsidiaryNewDownloadLinkLi) {
        var prototype = $subsidiaryDownloadCollectionHolder.data('prototype');

        var index = $subsidiaryDownloadCollectionHolder.data('index');

        var subsidiaryNewForm = prototype.replace(/__name__/g, index);

        $subsidiaryDownloadCollectionHolder.data('index', index + 1);

        var $subsidiaryNewFormLi = $('<li></li>').append(subsidiaryNewForm);
        subsidiaryAddDownloadFormDeleteLink($subsidiaryNewFormLi);
        $subsidiaryNewDownloadLinkLi.before($subsidiaryNewFormLi);
    }

    function subsidiaryAddDownloadFormDeleteLink($subsidiaryDownloadFormLi) {
        var $subsidiaryRemoveFormA = $('<a href="#" class="wButton redwB m10 mr10 ml10 floatR"><span>         {{ 'licenses.delete_this_download' | trans }}</span></a><div class="clear"></div><div class="cLine"></div>');
        $subsidiaryDownloadFormLi.append($subsidiaryRemoveFormA);

        $subsidiaryRemoveFormA.on('click', function (e) { // prevent the link from creating a "#" on the URL
            e.preventDefault();

            // remove the li for the tag form
            $subsidiaryDownloadFormLi.remove();
        });
    }

    jQuery(document).ready(function () {
        $("#confirm_tab").click(function () {

            var name = "custom[2]";
            document.getElementById("businesslicense_name").innerHTML = $("#webmastersafrica_licensebundle_businesslicense_name").val();
            document.getElementById("businesslicense_keywords").innerHTML = $("#webmastersafrica_licensebundle_businesslicense_keywords").val();
            //document.getElementById("businesslicense_purpose").innerHTML = $("#webmastersafrica_licensebundle_businesslicense_purpose").val();
            document.getElementById("businesslicense_purpose").innerHTML = CKEDITOR.instances['webmastersafrica_licensebundle_businesslicense_purpose'].getData();
            document.getElementById("businesslicense_description").innerHTML = CKEDITOR.instances['webmastersafrica_licensebundle_businesslicense_description'].getData();
           // document.getElementById("businesslicense_comments").innerHTML = $("#webmastersafrica_licensebundle_businesslicense_comments").val();
            document.getElementById("businesslicense_application_fee").innerHTML = $("#webmastersafrica_licensebundle_businesslicense_application_fee").val();
            document.getElementById("businesslicense_max_processing_time").innerHTML = $("#webmastersafrica_licensebundle_businesslicense_max_processing_time").val();
            document.getElementById("businesslicense_related_websites").innerHTML = CKEDITOR.instances['webmastersafrica_licensebundle_businesslicense_related_websites'].getData();
            document.getElementById("principle_legislation").innerHTML = $("#webmastersafrica_licensebundle_businesslicense_principle_legislation").val();
            document.getElementById("businesslicense_validity").innerHTML = $("#webmastersafrica_licensebundle_businesslicense_validity").val();
            document.getElementById("businesslicense_contact_office").innerHTML = $("#webmastersafrica_licensebundle_businesslicense_contact_office").val();
            document.getElementById("businesslicense_location").innerHTML = $("#webmastersafrica_licensebundle_businesslicense_location :selected").text();
            document.getElementById("businesslicense_agency").innerHTML = $("#webmastersafrica_licensebundle_businesslicense_agency :selected").text();
            var activities = $('#webmastersafrica_licensebundle_businesslicense_activities option:selected').toArray().map(item => item.text).join();
            document.getElementById("businesslicense_activities").innerHTML = activities;
            var custom_2 = $('input[name="custom[2]"]')
            document.getElementById("legal_basis").innerHTML = $('select[name="' + name + '"] option:selected').val()
            document.getElementById("license_type").innerHTML = CKEDITOR.instances['webmastersafrica_licensebundle_businesslicense_comments'].getData();
