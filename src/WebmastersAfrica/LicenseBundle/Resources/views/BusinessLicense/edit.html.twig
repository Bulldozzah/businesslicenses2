    var rules = {}, messages = {}, $form = $('form.form'), validator, entityId = '';

    $form.find('select, input, textarea').each(function(){
        var $el = $(this), type = $el.attr('type'), name = $el.attr('name');

        if ( 'hidden' === type || undefined === name )
            return true;

        rules[name] = {
            required: $el.prop('required'),
        };

        messages[name] = 'This field is required';

        if ( -1 < 'email,url,date,number'.indexOf(type) ) {
            rules[name][type] = true;
        }
    });


    $form.find('button[type="submit"]').click(function(evt) {
        for ( var instance in CKEDITOR.instances )
            CKEDITOR.instances[instance].updateElement();

        evt.preventDefault(); evt.stopPropagation();
        var vailidityChecker = 0;

        $form.find('select, input, textarea').each(function(){
            var $el = $(this), type = $el.attr('type'), name = $el.attr('name'),
                tagName = $el[0].tagName,
                $err = $('<strong>This field is required</strong>');

            // if ( 'hidden' === type || undefined === name )
            //     return true;
            if ( 'TEXTAREA' === $el[0].tagName && '' === $el.val() && true === $el.data('required') ) {
                $el.closest('div.formRight').append($err);
                vailidityChecker++;
            } else if (false === this.validity.valid) {
                $el.after($err);
            }
        });
        if ( false === $form[0].checkValidity() || 0 < vailidityChecker) {
            alert("Please check if all the fields marked with an asterisk are provided.")
            $("#form_error_area").html(`<p class="nNote nFailure hideit">Please check if all the fields marked with an asterisk are provided.</p>`);
            return false;
        }

        $form.submit();
    });
    
