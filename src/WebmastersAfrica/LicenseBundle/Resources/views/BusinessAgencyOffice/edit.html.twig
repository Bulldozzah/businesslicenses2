{# src/WebmastersAfrica/PressBundle/Resources/views/Default/index.html.twig #}

{% extends 'WebmastersAfricaAdminBundle::adminlayout.html.twig' %}

{% trans_default_domain 'WebmastersAfricaLicenseBundle' %}

{% block page_title %}
    {{ site_title }},
    {{ 'agencies.edit_license_agency' | trans }}
{% endblock %}

{% block header %}
    <!-- Title area -->
    <div class="titleArea">
        <div class="wrapper">
            <div class="pageTitle">
                <h5>{{ 'agencies.edit_license_agency' | trans }}</h5>
                <span>{{ 'agencies.edit_agency_description' | trans }} office</span>
            </div>
            <div class="clear"></div>
        </div>
    </div>
{% endblock %}

{% block body %}

    <link rel="stylesheet" type="text/css" href="{{ asset('bundles/webmastersafricaadmin/css/bootstrap-duallistbox.css') }}">
    <script src="//maxcdn.bootstrapcdn.com/bootstrap/3.2.0/js/bootstrap.min.js"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/prettify/r298/run_prettify.min.js"></script>
    <script type="text/javascript" src="{{ asset('bundles/webmastersafricaadmin/js/jquery.bootstrap-duallistbox.js') }}"></script>

    <div class="widget">
        <div class="title">
            <img class="titleIcon" alt="" src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/home2.png') }}">
            <h6>{{ 'agencies.edit_agency_description' | trans }} office</h6>

            <div class="num">
                <a href="{{ path('manageagencies_show', {'id': agency}) }}" title="{{ 'agencies.back_to_list' | trans }}" class="greyNum w3-button w3-round-large w3-hover-red">{{ 'agencies.back_to_list' | trans }}</a>
            </div>
        </div>
        <div class="body nopadding ">

            {{ form_start(edit_form, {'attr': {'class': 'form','id':'demoform','novalidate': 'novalidate'}}) }}
            <!-- Tabs -->
            <div class="widget">

                <ul class="tabs">
                    <li>
                        <a href="#tab1">{{ 'agencies.edit_license_agency' | trans }}</a>
                    </li>
                </ul>
                <div class="tab_container">
                    <div id="tab1" class="tab_content nopadding">

                        <input type="hidden" name="_method" value="PUT"/>
                        {{ form_row(edit_form.name) }}
                        {{ form_row(edit_form.fax) }}
                        {{ form_row(edit_form.address) }}
                        {{ form_row(edit_form.telephone) }}
                        {{ form_row(edit_form.email) }}
                        {{ form_row(edit_form.website) }}
                        {{ form_row(edit_form.hours) }}
                        {{ form_row(edit_form.postal_address) }}
                        {{ form_row(edit_form.latitude) }}
                        {{ form_row(edit_form.longitude) }}
                        <div class="formRow">
                            {{ form_label(edit_form.file) }}
                            <div class="formRight" data-file-name="{{ edit_form.mapScan.vars.value }}">
                                {{ form_widget(edit_form.file) }}
                            </div>
                            <div class="clear"></div>
                        </div>
                        {{ form_row(edit_form.location) }}

                        {{ form_row(edit_form.update, { 'attr': {'class':'w3-right w3-center w3-button w3-blue w3-round-medium', 'style':'padding: 10px 30px 30px 30px; margin-right:15px;'} }) }}
                    </div>
                </div>
            </div>

            <div style="display: none;">
                {{ form_rest(edit_form) }}
            </div>
            {{ form_end(edit_form) }}
        </div>
    </div>

    <script src="{{ asset('bundles/webmastersafricapress/new/assets/validate.js') }}"></script>
    <script language="javascript">
        $("#businessagencyoffice_website").addClass("w3-input w3-border");
        $('#businessagencyoffice_email').clone().attr('type', 'email').insertAfter('#businessagencyoffice_email').prev().remove();
        $("#businessagencyoffice_email").addClass("w3-input w3-border");
        $(".label-required_2").append("<i style='color: red;'>*</i>")
        // $(".label-required_2").append("<i style='color: red;'>*</i>")
        $(".form").validate()
    </script>


    <style type="text/css">
        .error {
            color: red;
        }
    </style>

{% endblock %}
