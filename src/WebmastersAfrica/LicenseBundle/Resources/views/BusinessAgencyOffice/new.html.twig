{# src/WebmastersAfrica/PressBundle/Resources/views/Default/index.html.twig #}

{% extends 'WebmastersAfricaAdminBundle::adminlayout.html.twig' %}

{% trans_default_domain 'WebmastersAfricaLicenseBundle' %}

{% block page_title %}
    {{ site_title }},
    {{ 'agencies.add_new_agency' | trans }}
{% endblock %}

{% block header %}
    <!-- Title area -->
    <div class="titleArea">
        <div class="wrapper">
            <div class="pageTitle">
                <h5>Manage Issuing Authority Offices</h5>
                <span>{{ 'agencies.add_agency_description' | trans }} Office.</span>
            </div>
            <div class="clear"></div>
        </div>
    </div>
{% endblock %}

{% block body %}
    {% for flashMessage in app.session.flashbag.get('agency_create_unsuccess') %}
        <div class="nNote nFailure hideit">
            <p>
                <strong>Error:
                </strong>
                {{ flashMessage }}
            </p>
        </div>
    {% endfor %}

    <div class="widget">
        <div class="title">
            <img class="titleIcon" alt="" src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/home2.png') }}">
            <h6>{{ 'agencies.add_agency_description' | trans }} Office</h6>

            <div class="num">
                <a href="{{ path('manageagencies_show', {'id': agency }) }}" title="{{ 'agencies.back_to_list' | trans }}" class="greyNum w3-button w3-round-large w3-hover-red">{{ 'agencies.back_to_list' | trans }}</a>
            </div>
        </div>
        <div class="body nopadding ">
            <form action="{{ path('manageagencies_office_create', {'agency_id': agency}) }}" method="post" {{ form_enctype(form) }} class="form" novalidate="novalidate">

                <ul class="tabs">
                    <li>
                        <a href="#tab1">{{ 'agencies.details' | trans }} Office</a>
                    </li>
                </ul>
                <div class="tab_container">
                    <div id="tab1" class="tab_content tab_content_nopadding">
                        {{ form_row(form.name) }}
                        {{ form_row(form.fax) }}
                        {{ form_row(form.address) }}
                        {{ form_row(form.telephone) }}
                        {{ form_row(form.email) }}
                        {{ form_row(form.website) }}
                        {{ form_row(form.hours) }}
                        {{ form_row(form.postal_address) }}
                        {{ form_row(form.latitude) }}
                        {{ form_row(form.longitude) }}
                        {{ form_row(form.file) }}
                        {{ form_row(form.location) }}
                    </div>

                    <div class="formSubmit">
                        {{ form_row(form.submit, { 'attr': {'class':'w3-right w3-center w3-button w3-blue w3-round-medium', 'style':'padding: 10px 30px 30px 30px; margin-right:15px;'} }) }}
                    </div>
                    <div class="clear"></div>
                    <div style="display: none;">
                        {{ form_rest(form) }}
                    </div>
                </form>

            </div>
        </div>
    </div>

    <script src="{{ asset('bundles/webmastersafricapress/new/assets/validate.js') }}"></script>
    <script language="javascript">
        $("#businessagencyoffice_website").addClass("w3-input w3-border");
        $('#businessagencyoffice_email').clone().attr('type', 'email').insertAfter('#businessagencyoffice_email').prev().remove();
        $("#businessagencyoffice_email").addClass("w3-input w3-border");
        $(".label-required_2").append("<i style='color: red;'>*</i> ")
        $(".form").validate();

        // Agencyoffices
    </script>

    <style type="text/css">
        .error {
            color: red;
        }
    </style>


{% endblock %}

