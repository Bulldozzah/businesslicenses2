{# src/WebmastersAfrica/PressBundle/Resources/views/Default/index.html.twig #}

{% extends 'WebmastersAfricaAdminBundle::adminlayout.html.twig' %}

{% trans_default_domain 'WebmastersAfricaLicenseBundle' %}

{% block page_title %}{{ site_title }}, {{ 'activities.add_business_activity' | trans }}{% endblock %}

{% block header %}
<!-- Title area -->
<div class="titleArea">
    <div class="wrapper">
        <div class="pageTitle">
            <h5>{{ 'activities.add_business_activity' | trans }}</h5>
            <span>{{ 'activities.add_business_activity_description' | trans }}</span>
        </div>
        <div class="clear"></div>
    </div>
</div>
{% endblock %}

{% block body %}
<div class="widget">
<div class="title">
<img class="titleIcon" alt="" src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/runningMan.png') }}">
<h6>{{ 'activities.add_business_activity_description' | trans }}</h6>

<div class="num">
<a href="{{ path('manageactivities') }}" title="{{ 'activities.back_to_list' | trans }}" class="greyNum w3-button w3-round-large w3-hover-red">{{ 'activities.back_to_list' | trans }}</a>
</div>
</div>
<div class="body nopadding ">
<form action="{{ path('manageactivities_create') }}" method="post" {{ form_enctype(form) }} class="form" novalidate="novalidate">
{{ form_row(form.name) }}
{{ form_row(form.description) }}
{{ form_row(form.licenses) }}
{{ form_row(form.businesstypes) }}
<div class="formSubmit">
{{ form_row(form.submit, { 'attr': {'class':'w3-right w3-center w3-button w3-blue w3-round-medium', 'style':'padding: 10px 30px 30px 30px; margin-right:15px;'}  }) }}
</div>
<div class="clear"></div>
<div style="display: none;">
{{ form_rest(form) }}
</div>
</form>

</div>
</div>
<style type="text/css">
.error {
	color: red;
}
</style>
<script language="javascript">
jQuery(document).ready(function() {
$(".label-required").append("<i style='color: red;'>*</i> ")
$(".form").validate();
    var demo1 = $('select[name="webmastersafrica_licensebundle_businessactivity[licenses][]"]').bootstrapDualListbox();
    var demo2 = $('select[name="webmastersafrica_licensebundle_businessactivity[businesstypes][]"]').bootstrapDualListbox();
});
</script>
{% endblock %}
