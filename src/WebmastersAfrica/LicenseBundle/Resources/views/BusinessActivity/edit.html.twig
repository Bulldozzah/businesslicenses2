{# src/WebmastersAfrica/PressBundle/Resources/views/Default/index.html.twig #}

{% extends 'WebmastersAfricaAdminBundle::adminlayout.html.twig' %}

{% trans_default_domain 'WebmastersAfricaLicenseBundle' %}

{% block page_title %}{{ site_title }}, {{ 'activities.edit_business_activity' | trans }}{% endblock %}

{% block header %}
<!-- Title area -->
<div class="titleArea">
    <div class="wrapper">
        <div class="pageTitle">
            <h5>{{ 'activities.edit_business_activity' | trans }}</h5>
            <span>{{ 'activities.edit_business_activity_description' | trans }}</span>
        </div>
        <div class="clear"></div>
    </div>
</div>
{% endblock %}

{% block body %}
<div class="widget">
<div class="title">
<img class="titleIcon" alt="" src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/runningMan.png') }}">
<h6>{{ 'activities.edit_business_activity_description' | trans }}</h6>

<div class="num">
<a href="{{ path('manageactivities') }}" title="{{ 'activities.back_to_list' | trans }}" class="greyNum w3-button w3-round-large w3-hover-red">{{ 'activities.back_to_list' | trans }}</a>
</div>
</div>
<div class="body nopadding ">
 <form action="{{ path('manageactivities_update', { 'id': entity.id }) }}" method="post" {{ form_enctype(edit_form) }} class="form" novalidate="novalidate">
	<input type="hidden" name="_method" value="PUT" />
        {{ form_row(edit_form.name) }}
        {{ form_row(edit_form.description) }}
        {{ form_row(edit_form.licenses) }}
        {{ form_row(edit_form.businesstypes) }}

{{ form_row(edit_form.update, { 'attr': {'class':'w3-right w3-center w3-button w3-blue w3-round-medium', 'style':'padding: 10px 30px 30px 30px; margin-right:15px;'} }) }}
<div class="clear"></div>
<div style="display: none;">
{{ form_rest(edit_form) }}
</div>
</form>

</div>
</div>


<script language="javascript">
jQuery(document).ready(function() {
$(".label-required").append("<i style='color: red;'>*</i> ")
$(".form").validate();

    var demo1 = $('select[name="webmastersafrica_licensebundle_businessactivity[licenses][]"]').bootstrapDualListbox();
    var demo2 = $('select[name="webmastersafrica_licensebundle_businessactivity[businesstypes][]"]').bootstrapDualListbox();
});
</script>
{% endblock %}
