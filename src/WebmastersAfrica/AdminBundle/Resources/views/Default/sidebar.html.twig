        {% endif %}
        {% if is_expr_granted("hasRole('MANAGE_SECURITY')") %}
            <li class="ui">
                <a href="#" title="" class="exp {% if managegroups or routename == 'setting_edit' or routename == 'manageuserslogs' %}active{% endif %}" {% if managegroups or routename == 'setting_edit' or routename == 'manageuserslogs' %} id="current" {% endif %}>
                    <span>{{ 'sidebar.manage_security.title'|trans }}</span>
                </a>
                <ul class="sub">
                    {% if is_expr_granted("hasRole('GROUPS_MANAGE')") %}
                        <li {% if managegroups %} class="this" {% endif %}>
                            <a href="{{ path('managegroups') }}" title="{{ 'sidebar.manage_security.groups'|trans }}">{{ 'sidebar.manage_security.groups'|trans }}</a>
                        </li>
                    {% endif %}
                    {% if is_expr_granted("hasRole('SETTINGS_MANAGE')") %}
                        <li {% if routename == 'setting_edit' %} class="this" {% endif %}>
                            <a href="{{ path('setting_edit', {'id':'1'}) }}" title="{{ 'sidebar.manage_security.settings'|trans }}">{{ 'sidebar.manage_security.settings'|trans }}</a>
                        </li>
                    {% endif %}
                    {% if is_expr_granted("hasRole('LOGS_VIEW')") %}
                        <li class="last {% if routename == 'manageuserslogs' %}this{% endif %}">
                            <a href="{{ path('manageuserslogs') }}" title="{{ 'sidebar.manage_security.logs'|trans }}">{{ 'sidebar.manage_security.logs'|trans }}</a>
                        </li>
                    {% endif %}
                </ul>
            </li>
        {% endif %}
        <ul>
            <li class="errors">
                <a href="#" title="Help" class="exp {% if routename == 'help_manuals' or routename == 'help_videos' %}active{% endif %}" {% if routename == 'help_manuals' or routename == 'help_videos' %} id="current" {% endif %}>
                    <span>{{ 'sidebar.help.title'|trans }}</span>
                </a>
                <ul class="sub">
                    <li {% if routename == 'help_manuals' %} class="this" {% endif %}>
                        <a href="{{ path("help_manuals") }}" title="{{ 'sidebar.help.manuals'|trans }}">{{ 'sidebar.help.manuals'|trans }}</a>
                    </li>
                    {# <li class="last {% if routename == 'help_videos' %}this{% endif %}">
                        <a href="{{ path("help_videos") }}" title="{{ 'sidebar.help.videos'|trans }}">{{ 'sidebar.help.videos'|trans }}</a>
                    </li> #}
                </ul>
            </li>
        </ul>
        <br />
        <br />
        <select id='languages' name='languages' onchange="window.location='/setlocale/' + this.value;">
            <option>{{ 'topbar.languages'|trans }}</option>
            {% for language in languages %}
                <option value="{{ language.localeCode }}" {% if currentlocale == language.localeCode %} selected {% endif %}>
                    {{ language.title }}
                </option>
            {% endfor %}
        </select>
    </ul>
</div>
