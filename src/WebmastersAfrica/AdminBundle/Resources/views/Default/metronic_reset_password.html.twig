{% extends 'WebmastersAfricaAdminBundle:Default:metronic_base.html.twig' %}

{% block metronic_title %}
<title>Zambia | Eregistry portal - Reset Password </title>
{% endblock %}

{% block metronic_content %}
<!-- BEGIN LOGIN -->
<div class="content">
	<!-- BEGIN FORGOT PASSWORD FORM -->
	<form class="login-form" action="/reset/send/code" method="post">
	    
		<div class="form-title">
			<span class="form-title">Forget Password ?</span>
			<span class="form-subtitle">Enter your username or email to reset it.</span>
		</div>
		<div class="form-group">
			<input class="form-control placeholder-no-fix" type="text" autocomplete="off" placeholder="enter your username or email" id="username" name="username"/>
		</div>
		<div class="form-actions">
			<button type="submit" class="btn btn-warning uppercase pull-right">Send</button>
		</div>
	</form>
	<!-- END FORGOT PASSWORD FORM -->
	
</div>
{% endblock %}
