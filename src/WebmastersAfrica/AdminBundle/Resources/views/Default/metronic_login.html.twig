{% extends 'WebmastersAfricaAdminBundle:Default:metronic_base.html.twig' %}

{% block metronic_title %}
	<title>Zambia | Eregistry portal - Login
	</title>
{% endblock %}

{% block metronic_content %}
	<!-- BEGIN LOGIN -->
	<div
		class="content">
		<!-- BEGIN LOGIN FORM -->

		<form class="login-form" action="{{ path('admin_login_check') }}" method="post">

			<input type="hidden" name="_csrf_token" value="{{ csrf_token }}"/>
			<div class="form-title">
				<span class="form-title text-center">Welcome to E-Registry and Notice & Comment Admin Portal.</span>
				<br/>
				<span class="form-subtitle">Please login.</span>
			</div>
			{% if error %}


				<div class="alert alert-danger">
					<button class="close" data-close="alert"></button>
					<span>
						{{ error|trans }}</span>
				</div>
			{% endif %}
			<div
				class="form-group">
				<!--ie8, ie9 does not support html5 placeholder, so we just show field title for that-->
				<label class="control-label visible-ie8 visible-ie9">Username</label>
				<input id="user_login" name="_username" class="form-control form-control-solid placeholder-no-fix" type="text" autocomplete="off" placeholder="Username" name="username"/>
			</div>
			<div class="form-group">
				<label class="control-label visible-ie8 visible-ie9">Password</label>
				<input id="user_pass" name="_password" class="form-control form-control-solid placeholder-no-fix" type="password" autocomplete="off" placeholder="Password" name="password"/>
			</div>
			<div class="form-actions">
				<button type="submit" class="btn btn-warning btn-block uppercase">Login</button>
			</div>
			<div class="form-actions">
				<div class="pull-right forget-password-block">
					<a href="/reset/backend/password" id="forget-password" class="forget-password">Forgot your Password?</a>
				</div>
			</div>

		</form>
		<!-- END LOGIN FORM -->

	</div>
{% endblock %}
