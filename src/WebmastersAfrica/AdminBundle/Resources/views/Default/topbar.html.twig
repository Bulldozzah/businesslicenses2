      <span>{{ 'topbar.welcome'|trans }},
        {{ app.security.getToken().getUser().getUsername() }}!</span>
    </div>
    <div class="userNav">
      <ul>
        <li>
          <a href="{{ path('homepage') }}" target="__blank"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/topnav/logout.png') }}" alt=""/><span>eRegistry</span></a>
        </li>
        <li>
            <a href="{{ path('homepage_notice_comments') }}" target="__blank"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/topnav/logout.png') }}" alt=""/><span>
              Notice and Comments</span></a>
        </li>
