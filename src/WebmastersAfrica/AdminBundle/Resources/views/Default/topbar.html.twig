          </a>
        </li>

        <li class="dd">
          <a title="{{ 'topbar.messages.messages_title'|trans }}"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/topnav/messages.png') }}" alt=""/><span>{{ 'topbar.messages.messages_title'|trans }}</span>
