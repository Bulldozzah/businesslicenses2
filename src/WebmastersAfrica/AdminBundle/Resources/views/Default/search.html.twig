                        <td>{{ 'search.business_types.is_common' | trans }}</td>
                        <td>{{ 'search.business_types.actions' | trans }}</td>
                    </tr>
                </thead>
                <tbody>
                    {% for entity in businesstypes %}
                    <tr>
                        <td><a href="{{ path('managebusinesstypes_show', { 'id': entity.id }) }}">{{ entity.id }}</a></td>
