            <table cellpadding="0" cellspacing="0" width="100%" class="sTable" id="res">
                <thead>
                    <tr>
                        <td>#</td>
                        <td>{{ 'search.news.title' | trans }}</td>
                        <td>{{ 'search.news.hits' | trans }}</td>
                        <td>{{ 'search.news.published' | trans }}</v>
                        <td>{{ 'search.news.actions' | trans }}</td>
                    </tr>
                </thead>
                <tbody>
                    {% for entity in news %}
                    <tr>
                        <td><a href="{{ path('managenews_show', { 'id': entity.id }) }}">{{ entity.id }}</a></td>
                        <td>{{ entity.title }}</td>
                        <td>{{ entity.hits }}</td>
