            <h6>{{ 'search.activities.activities' | trans }} ({{ activities | length }})</h6>
        </div>
        <div class="menu_body p-0">
            <table cellpadding="0" cellspacing="0" width="100%" class="sTable" id="res">
                <thead>
                    <tr>
                        <td>#</td>
                        <td>{{ 'search.activities.name' | trans }}</td>
                        <td>{{ 'search.activities.description' | trans }}</td>
                        <td>{{ 'search.activities.business_types' | trans }}</td>
                        <td>{{ 'search.activities.licenses' | trans }}</td>
                        <td>{{ 'search.activities.actions' | trans }}</td>
                    </tr>
                </thead>
                <tbody>
                    {% for entity in activities %}
                    <tr>
                        <td><a href="{{ path('manageactivities_show', { 'id': entity.id }) }}">{{ entity.id }}</a></td>
                        <td>{{ entity.name }}</td>
                        <td>{{ entity.description }}</td>
                        <td>
                            {% for businesstype in entity.businesstypes %}
                            {{ businesstype.name }},
                            {% endfor %}
                        </td>
                        <td>
                            {% for license in entity.licenses %}
                            {{ license.name }},
                            {% endfor %}
                        </td>
                        <td>
                            <ul>
                                <li>
                                    <a class="smallButton" href="{{ path('manageactivities_edit', { 'id': entity.id }) }}"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/color/pencil.png') }}" alt="Edit"></a>
                                </li>
                            </ul>
                        </td>
                    </tr>
                    {% endfor %}
