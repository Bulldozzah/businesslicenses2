        <div class="title"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/tags.png') }}" alt="" class="titleIcon" />
            <h6>{{ 'search.newsletters.newsletters' | trans }} ({{ newsletters | length }})</h6>
        </div>
        <div class="menu_body p-0">
            <table cellpadding="0" cellspacing="0" width="100%" class="sTable" id="res">
                <thead>
                    <tr>
                        <td>#</td>
                        <td>{{ 'search.newsletters.subject' | trans }}</td>
                        <td>{{ 'search.newsletters.sent' | trans }}</td>
                        <td>{{ 'search.newsletters.actions' | trans }}</td>
                    </tr>
                </thead>
                <tbody>
                    {% for entity in newsletters %}
