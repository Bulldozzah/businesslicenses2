            <h6>{{ 'search.users.users' | trans }} ({{ users | length }})</h6>
        </div>
        <div class="menu_body p-0">
            <table cellpadding="0" cellspacing="0" width="100%" class="sTable" id="res">
                <thead>
                    <tr>
                        <td>#</td>
                        <td>{{ 'search.users.first_name' | trans }}</td>
                        <td>{{ 'search.users.last_name' | trans }}</td>
                        <td>{{ 'search.users.username' | trans }}</td>
                        <td>{{ 'search.users.email' | trans }}</td>
                        <td>{{ 'search.users.actions' | trans }}</td>
                    </tr>
                </thead>
                <tbody>
                    {% for entity in users %}
                    <tr>
                        <td><a href="{{ path('manageusers_show', { 'id': entity.id }) }}">{{ entity.id }}</a></td>
                        <td>{{ entity.firstName }}</td>
                        <td>{{ entity.lastName }}</td>
                        <td>{{ entity.username }}</td>
                        <td>{{ entity.email }}</td>
                        <td>
                            <ul>
                                <li>
                                    <a class="smallButton" href="{{ path('manageusers_edit', { 'id': entity.id }) }}"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/color/pencil.png') }}" alt="Edit"></a>
                                </li>
