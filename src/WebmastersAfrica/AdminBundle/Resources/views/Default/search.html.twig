                        <td>{{ 'search.frequently_asked_questions.answer' | trans }}</td>
                        <td>{{ 'search.frequently_asked_questions.published' | trans }}</td>
                        <td>{{ 'search.frequently_asked_questions.actions' | trans }}</td>
                    </tr>
                </thead>
                <tbody>
                    {% for entity in faqs %}
                    <tr>
                        <td><a href="{{ path('managefaq_show', { 'id': entity.id }) }}">{{ entity.id }}</a></td>
                        <td>{{ entity.question }}</td>
                        <td>{{ entity.answer }}</td>
                        <td>
                            {% if entity.published == true %}
                            <img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/check.png') }}" alt="Published">
                            {% else %}
