{# src/WebmastersAfrica/PressBundle/Resources/views/Default/index.html.twig #}
{% extends 'WebmastersAfricaAdminBundle::adminlayout.html.twig' %}
{% trans_default_domain 'WebmastersAfricaAdminBundle' %}
{% block page_title %}{{ site_title}}, {{ 'search.search' | trans }}{% endblock %}
{% block header %}
<!-- Title area -->
<div class="titleArea">
    <div class="wrapper">
        <div class="pageTitle">
            <h5>{{ 'search.search' | trans }}</h5>
            <span>
                {{ 'search.search_description' | trans }}<br>
                <div class="searchWidget">
                    <form action="{{ path('search') }}" method='post'>
                        <input type="text" name="search" placeholder="{{ 'search.enter_search_term' | trans }}..." value="{{ searchterm }}" />
                        <input type="submit" name="find" value="" />
                        {% if is_expr_granted("hasRole('LICENSE_DELETE')") %}
                        <label class="" style="margin-top:10px; float:left;pa"><input class="m-t-10" type="checkbox" name="_with_trashed" {{ trashed ?  'checked' :  ''}} value="1"> <span> Include Removed Licenses<span></label>
                        {% endif %}
                    </form>
                </div>
            </span>
        </div>
        <div class="clear"></div>
        <div class="clear"></div>
    </div>
</div>
{% endblock %}
{% block body %}
    {% set found = 0 %}
    <!-- Accordion -->
    <div class="toggle acc">
        {% if licenses | length > 0 %}
            {% set found = 1 %}
            <div class="title"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/tags.png') }}" alt="" class="titleIcon" >
                <h6>{{ 'search.licenses.licenses' | trans }} ({{ licenses | length }})</h6>
            </div>
            <div class="menu_body p-0">
                <table cellpadding="0" cellspacing="0" width="100%" class="sTable" id="res">
                    <thead>
                        <tr>
                            <td>#</td>
                            <td>{{ 'search.licenses.name' | trans }}</td>
                            <td>{{ 'search.licenses.purpose' | trans }}</td>
                            <td>{{ 'search.licenses.description' | trans }}</td>
                            <td>{{ 'search.licenses.agency' | trans }}</td>
                            <td>{{ 'search.licenses.status' | trans }}</td>
                            <td>{{ 'search.licenses.universal' | trans }}</td>
                            <td>{{ 'search.licenses.views' | trans }}</td>
                            <td>{{ 'search.licenses.actions' | trans }}</td>
                        </tr>
                    </thead>
                    <tbody>
                        {% for entity in licenses %}
                        <tr>
                            <td><a href="{{ path('managelicenses_show', { 'id': entity.id }) }}">{{ entity.id }}</a></td>
                            <td>{{ entity.name }}</td>
                            <td>{{ entity.purpose | raw }}</td>
                            <td>{{ entity.description | raw }}</td>
                            <td>{{ entity.agency }}</td>
                            <td>{{ entity.status }}</td>
                            <td>{{ entity.universal }}</td>
                            <td>{{ entity.views }}</td>
                            <td>
                                <ul>
                                    <li>
                                        <a class="smallButton" href="{{ path('managelicenses_edit', { 'id': entity.id }) }}"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/color/pencil.png') }}" alt="Edit"></a>
                                    </li>
                                </ul>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}

        {# Business Agency #}
        {% if business_agency|length > 0 %}
            {% set found = 1 %}
            <div class="title"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/tags.png') }}" alt="" class="titleIcon" >
                <h6>{{ 'search.business_agency.business_agency' | trans }} ({{ business_agency | length }})</h6>
            </div>
            <div class="menu_body p-0">
                <table cellpadding="0" cellspacing="0" width="100%" class="sTable" id="res">
                    <thead>
                        <tr>
                            <td>#</td>
                            <td>{{ 'search.business_agency.name' | trans }}</td>
                            <td>{{ 'search.business_agency.actions' | trans }}</td>
                        </tr>
                    </thead>
                    <tbody>
                        {% for entity in business_agency %}
                        <tr>
                            <td><a href="{{ path('manageagencies_show', { 'id': entity.id }) }}">{{ entity.id }}</a></td>
                            <td>{{ entity.name }}</td>
                            
                            <td>
                                <ul>
                                    <li>
                                        <a class="smallButton" href="{{ path('manageagencies_edit', { 'id': entity.id }) }}"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/color/pencil.png') }}" alt="Edit"></a>
                                    </li>
                                </ul>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}

        {% if locations | length > 0 %}
