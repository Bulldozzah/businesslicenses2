        <div class="title"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/tags.png') }}" alt="" class="titleIcon" />
            <h6>{{ 'search.pages.pages' | trans }} ({{ pages | length }})</h6>
        </div>
        <div class="menu_body p-0">
            <table cellpadding="0" cellspacing="0" width="100%" class="sTable" id="res">
                <thead>
                    <tr>
                        <td>#</td>
                        <td>{{ 'search.pages.page_title' | trans }}</td>
                        <td>{{ 'search.pages.published' | trans }}</td>
                        <td>{{ 'search.pages.actions' | trans }}</td>
                    </tr>
                </thead>
                <tbody>
                    {% for entity in pages %}
                    <tr>
                        <td width="5%"><a href="{{ path('managepages_show', { 'id': entity.id }) }}">{{ entity.id }}</a></td>
                        <td>{{ entity.pagetitle }}</td>
