                            <img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/check.png') }}" alt="Common">
                            {% else %}
                            <img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/close.png') }}" alt="Not Common">
