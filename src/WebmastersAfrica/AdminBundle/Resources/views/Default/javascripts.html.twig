<script language="javascript">
  function atLeastOne() {
    var checkedAtLeastOne = false;

    var inputs = document.getElementById('batch_form').getElementsByTagName('input');

    for (var i = inputs.length; i--;) {
      if (inputs[i].type.toLowerCase() == 'checkbox' && inputs[i].checked) 
        checkedAtLeastOne = true;
      


    }

    if (checkedAtLeastOne == false) {
      alert("Please select atleast one item");
      document.getElementById("batch_select").selectedIndex = 0;
    }


    return checkedAtLeastOne;
  }
</script>
