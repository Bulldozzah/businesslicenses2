                            <div class="row clearfix panels_A_in">
                              <div class="pB col-md-12 clearfix">
                                <h5>{{ item.regulationCount.count }}</h5>
                                <p>{{ item.name|capitalize|slice(0, 20) ~ '...' }}</p>
