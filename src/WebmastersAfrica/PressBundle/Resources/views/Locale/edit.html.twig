{# src/WebmastersAfrica/PressBundle/Resources/views/Default/index.html.twig #}

{% extends 'WebmastersAfricaAdminBundle::adminlayout.html.twig' %}

{% trans_default_domain 'WebmastersAfricaPressBundle' %}

{% block page_title %}{{ site_title }}, {{ 'languages.manage_languages' | trans }}{% endblock %}

{% block header %}
<!-- Title area -->
<div class="titleArea">
    <div class="wrapper">
        <div class="pageTitle">
            <h5>{{ 'languages.edit_language' | trans }}</h5>
            <span>{{ 'languages.edit_language_description' | trans }}</span>
        </div>
        <div class="clear"></div>
    </div>
</div>
{% endblock %}

{% block body %}
<div class="widget">
    <div class="title"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/frames.png') }}" alt="" class="titleIcon" />
    <h6>
      {{ 'languages.edit_language' | trans }}
    </h6>

    <div class="num">
      <a href="{{ path('locale') }}" title="{{ 'languages.back_to_list' | trans }}" class="greyNum w3-button w3-round-large w3-hover-red"><span>{{ 'languages.back_to_list' | trans }}</span></a>
	  </div>
    </div>
 <form action="{{ path('locale_update', { 'id': entity.id }) }}" method="post" {{ form_enctype(edit_form) }} class="form">
        <input type="hidden" name="_method" value="PUT" />
        {{ form_row(edit_form.title) }}
        {{ form_row(edit_form.localeCode) }}
        {{ form_row(edit_form.enabled) }}
        {{ form_row(edit_form.is_default) }}
        <div class="formSubmit">
        {{ form_row(edit_form.update, { 'attr': {'class':'w3-right w3-center w3-button w3-blue w3-round-medium', 'style':'padding: 10px 30px 30px 30px; margin-right:15px;'} }) }}
        <div style="display: none;">
        {{ form_rest(edit_form) }}
        </div>
    </form>
    {% if entity.isDefault == 0 %}
        {{ form(delete_form) }}
    {% endif %}
        </div>
  <div class="clear"></div>
    </div>
{% endblock %}
