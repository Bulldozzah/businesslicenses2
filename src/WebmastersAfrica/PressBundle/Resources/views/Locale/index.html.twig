{# src/WebmastersAfrica/PressBundle/Resources/views/Default/index.html.twig #}

{% extends 'WebmastersAfricaAdminBundle::adminlayout.html.twig' %}

{% trans_default_domain 'WebmastersAfricaPressBundle' %}

{% block page_title %}{{ site_title }}, {{ 'languages.manage_languages' | trans }}{% endblock %}

{% block header %}
<!-- Title area -->
<div class="titleArea">
    <div class="wrapper">
        <div class="pageTitle">
            <h5>{{ 'languages.languages' | trans }}</h5>
            <span>{{ 'languages.languages_description' | trans }}</span>
        </div>
		<div class="clear"></div>
    </div>
</div>


<div class="line"></div>


<div class="statsRow">

<div class="wrapper w3-center">
  <div class="controlC">
                <ul>
				    <li>
					<a href="{{ path("locale_new") }}" title="" class="w3-button w3-hover-teal w3-round-large w3-green w3-medium " title="" href="#">
				    <img alt="" src="{{ asset('bundles/webmastersafricaadmin/images/icons/sPlus.png') }}" alt="" />
					<span>{{ 'languages.add_new_language' | trans }}</span>
					</a>
				    </li>
                </ul>
                <div class="clear"></div>
            </div>
        <div class="clear"></div>
</div>
</div>

{% endblock %}

{% block body %}

{% for flashMessage in app.session.flashbag.get('update') %}
    <div class="nNote nSuccess hideit">
		<p>
			<strong>Success: </strong>
        {{ 'updated_item_notice' | trans }}
        </p>
    </div>
{% endfor %}
{% for flashMessage in app.session.flashbag.get('delete') %}
    <div class="nNote nSuccess hideit">
		<p>
			<strong>Success: </strong>
        {{ 'deleted_item_notice' | trans }}
        </p>
    </div>
{% endfor %}

<div class="widget">
    <div class="title"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/frames.png') }}" alt="" class="titleIcon" />
    <h6>{{ 'languages.list_of_languages' | trans }}</h6></div>
        <form id="batch_form" name="batch_form" action="{{ path("batch_languages") }}" method="post">
        <table cellpadding="0" cellspacing="0" width="100%" class="sTable mTable w3-table-all w3-card-4" id="language_table">
        <thead>
            <tr>
                <td width="3%"><div>&middot;&middot;&middot;</div></td>
                <td width="3%"><div>#</div></td>
                <td>{{ 'languages.title' | trans }}</td>
                <td align="center" width="60px">{{ 'languages.locale_code' | trans }}</td>
                <td align="center" width="60px">{{ 'languages.enabled' | trans }}</td>
                <td align="center" width="100px">{{ 'languages.actions' | trans }}</td>
            </tr>
        </thead>
        <tbody>
        {% for entity in pagination %}
            <tr>
                <td><input type="checkbox" name="batch_items[]" value="{{ entity.id }}"></td>
                <td><a href="{{ path('locale_edit', { 'id': entity.id }) }}">{{ entity.id }}</a></td>
                <td>{{ entity.title }}</td>
                <td align="center"><span class="smallButton">{{ entity.localeCode }}</span></td>
                <td align="center">
                {% if entity.enabled == true %}
                <span class="smallButton"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/check.png') }}" alt="Enabled"></span>
                {% else %}
                <span class="smallButton"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/close.png') }}" alt="Not Enabled"></span>
                {% endif %}
                </td>
                <td>
                  <ul>
                      <li>
                           <a href="{{ path('locale_edit', { 'id': entity.id }) }}" title="Edit Language" class="smallButton">
                           <img alt="Edit Language" src="{{ asset('bundles/webmastersafricaadmin/images/icons/color/pencil.png') }}">
                           </a>
                      </li>
                      <li>
                           <a href="{{ path('locale_edit_files', { 'id': entity.id }) }}" title="Edit Language Files" class="smallButton">
                           <img alt="Edit Language Files" src="{{ asset('bundles/webmastersafricaadmin/images/icons/color/report-paper.png') }}">
                           </a>
                      </li>
                  </ul>
                </td>
            </tr>
        {% endfor %}
        </tbody>
        <thead>
             <tr style="border-top:1px solid #CDCDCD">
                <td colspan="6" style="padding:10px;">
                    <select id="batch_select" name="batch_select" onChange="if(atLeastOne()){ if(confirm('{{ 'languages.batch_confirm_1' | trans }} ' + this.value + ' {{ 'languages.batch_confirm_2' | trans }}')){ document.getElementById('batch_form').submit(); } }">
                        <option>{{ 'languages.select_batch' | trans }}...</option>
                        <option value="enable">{{ 'languages.enable' | trans }}</option>
                        <option value="disable">{{ 'languages.disable' | trans }}</option>
                        <option value="delete">{{ 'languages.delete' | trans }}</option>
                    </select>
                </td>
            </tr>
        </thead>
    </table>
    </form>
</div>
    <div class="navigation">
        {{ knp_pagination_render(pagination) }}
    </div>
</div>
    {% endblock %}
{% block stylesheet_2 %}
    <script>
        $(document).ready(function () {
            $('#language_table').DataTable();
        });
    </script>
{% endblock %}

