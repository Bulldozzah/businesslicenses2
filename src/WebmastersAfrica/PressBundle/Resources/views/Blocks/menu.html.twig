{% for page in pages %}
    {% if page.pageLayout == 2  %}
        <li><a {% if page.url == route %} class="active" {% endif %} href="{{ app.request.basepath }}{{ page.url }}">{{ page.pageTitle }}</a></li>
    {% else %}
        <li><a {% if "/press/" ~ page.id == route %} class="active" {% endif %} href="{{ app.request.basepath }}/press/{{ page.id}}">{{ page.pageTitle }}</a></li>
    {% endif %}
{% endfor %}