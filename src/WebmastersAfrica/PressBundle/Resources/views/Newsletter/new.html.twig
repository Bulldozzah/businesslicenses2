{# src/WebmastersAfrica/PressBundle/Resources/views/Default/index.html.twig #}

{% extends 'WebmastersAfricaAdminBundle::adminlayout.html.twig' %}

{% trans_default_domain 'WebmastersAfricaPressBundle' %}

{% block page_title %}{{ site_title }}, {{ 'newsletters.add_newsletter' | trans }}{% endblock %}

{% block header %}
<!-- Title area -->
<div class="titleArea">
    <div class="wrapper">
        <div class="pageTitle">
            <h5>{{ 'newsletters.add_newsletter' | trans }}</h5>
            <span>{{ 'newsletters.add_newsletter_description' | trans }}</span>
        </div>

        <div class="clear"></div>
    </div>
</div>
{% endblock %}

{% block body %}
<div class="widget">
    <div class="title"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/frames.png') }}" alt="" class="titleIcon" />
    <h6>
    {{ 'newsletters.add_newsletter' | trans }}
    </h6>

    <div class="num">
      <a href="{{ path('managenewsletters') }}" title="{{ 'newsletters.back_to_list' | trans }}" class="greyNum w3-button w3-round-large w3-hover-red"><span>{{ 'newsletters.back_to_list' | trans }}</span></a>
	  </div>
    </div>

    <form action="{{ path('managenewsletters_create') }}" method="post" {{ form_enctype(form) }} class="form" novalidate>
        {{ form_row(form.subject) }}
        {{ form_row(form.content) }}
        {{ form_row(form.sent) }}
        <div class="formSubmit">
        {{ form_row(form.update, { 'attr': {'class':'w3-right w3-center w3-button w3-blue w3-round-medium', 'style':'padding: 10px 30px 30px 30px; margin-right:15px;'} }) }}
        <div style="display: none;">
            {{ form_rest(form) }}
        </div>
    </form>
  </div>
  <div class="clear"></div>
</div>

<script src="{{ asset('bundles/webmastersafricapress/new/assets/validate.js') }}"></script>
   <script language="javascript">

      $(".label-required").append("<i style='color: red;'>*</i> ")
      $(".form").validate();
    // Requirements
    
</script>
{% endblock %}
