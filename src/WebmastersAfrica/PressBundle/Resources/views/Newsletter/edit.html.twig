{# src/WebmastersAfrica/PressBundle/Resources/views/Default/index.html.twig #}

{% extends 'WebmastersAfricaAdminBundle::adminlayout.html.twig' %}

{% trans_default_domain 'WebmastersAfricaPressBundle' %}

{% block page_title %}{{ site_title }}, {{ 'newsletters.edit_newsletter' | trans }}{% endblock %}

{% block header %}
<!-- Title area -->
<div class="titleArea">
    <div class="wrapper">
        <div class="pageTitle">
            <h5>{{ 'newsletters.edit_newsletter' | trans }}</h5>
            <span>{{ 'newsletters.edit_newsletter_description' | trans }}</span>
        </div>

        <div class="clear"></div>
    </div>
</div>
{% endblock %}

{% block body %}
<div class="widget">
    <div class="title"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/frames.png') }}" alt="" class="titleIcon" />
    <h6>
      {{ 'newsletters.edit_newsletter' | trans }}
    </h6>

    <div class="num">
      <a href="{{ path('managenewsletters') }}" title="{{ 'newsletters.back_to_list' | trans }}" class="greyNum w3-button w3-round-large w3-hover-red"><span>{{ 'newsletters.back_to_list' | trans }}</span></a>
	  </div>
    </div>

    <form action="{{ path('managenewsletters_update', { 'id': entity.id }) }}" method="post" {{ form_enctype(edit_form) }} class="form" novalidate>
        <input type="hidden" name="_method" value="PUT" />
		{{ form_row(edit_form.subject) }}
        {{ form_row(edit_form.content) }}
        {{ form_row(edit_form.sent) }}


        {{ form_row(edit_form.update, { 'attr': {'class':'w3-right w3-center w3-button w3-blue w3-round-medium', 'style':'padding: 10px 30px 30px 30px; margin-right:15px;'} }) }}
        <div class="clear"></div>
        <div style="display: none;">
            {{ form_rest(edit_form) }}
        </div>
	</form>
    	
  <div class="clear"></div>
</div>
<script src="{{ asset('bundles/webmastersafricapress/new/assets/validate.js') }}"></script>
   <script language="javascript">

      $(".label-required").append("<i style='color: red;'>*</i> ")
      $(".form").validate();
    // Requirements
 </script>

{% endblock %}
