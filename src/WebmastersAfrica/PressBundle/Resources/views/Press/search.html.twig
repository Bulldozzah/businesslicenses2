{% trans_default_domain 'WebmastersAfricaPressBundle' %}

<div class="my-search">
  <div class="row">
  <form onSubmit="if(document.getElementById('speedB').value == '0'){  alert('Please {{ 'select'|trans }} a Business Location'); return false; } if(document.getElementById('speedC').value == '0'){  alert('Please {{ 'select'|trans }} a Project Type'); return false; } if(document.getElementById('speedD').value == '0'){  alert('Please {{ 'select'|trans }} a {{ 'businesslocation'|trans }}'); return false; }" action="{{ app.request.basepath }}/browse/listactivities" method="post">
     <div class="col col_1_3 alpha">
   <div class="inner">
                  <img src="{{ asset('bundles/webmastersafricapress/images/ico3.jpg') }}"/>
                   <select name="speedB" id="speedB"  onchange='getIndustries("{{ app.request.basepath }}/browse/listindustries", this.value)'>
      <option value="0" selected="selected">{{ 'select'|trans }} {{ 'businesslocation'|trans }}</option>
      {% set selected = '' %}
      {% for location in locations %}
      {% if location.id == speedB %}
        {% set selected = 'selected' %}
      {% endif %}
      <option value='{{ location.id }}' {{ selected }}>{{ location.name }}</option>
      {% set selected = '' %}
      {% endfor %}
  </select>
                  <p>
                  {{ 'locationdescription'|trans }}
                  </p>

  </div>
    </div>
     <div class="col col_1_3 alpha">
  <div class="inner">
                  <img src="{{ asset('bundles/webmastersafricapress/images/ico2.jpg') }}"/>
                  <div id='industries'>
                  <select name="speedC" id="speedC"  onchange='getBusinesstypes("{{ app.request.basepath }}/browse/listbusinesstypes", this.value)'>
                  <option>{{ 'select'|trans }} {{ 'industry'|trans }}</option>
                  {% if industry is empty %}

                  {% else %}
                    <option value='{{ industry.id }}' selected>{{ industry.name }}</option>
                  {% endif %}
                  </select> </div>
                  <p>
                  {{ 'industrydescription'|trans }}
                  </p>
   </div>
    </div>
     <div class="col col_1_3 alpha">
  <div class="inner">
                  <img src="{{ asset('bundles/webmastersafricapress/images/ico1.jpg') }}"/>
                  <div id="businesstypes">
                  <select name="speedD" id="speedD">
                  <option>{{ 'select'|trans }} {{ 'businesstype'|trans }}</option>
                  {% if businesstype is empty %}

                  {% else %}
                    <option value='{{ businesstype.id }}' selected>{{ businesstype.name }}</option>
                  {% endif %}
                  </select></div>
                  <p>
                  {{ 'businesstypedescription'|trans }}
                  </p>
    </div>
    </div>

     <div class="col_1_s2">
          <button style="width:100%; height:40px;" type="submit" name = "submit" class=" btn btn- btn_blue">{{ 'getresults'|trans }}</button>
        </div>
       <div class="clear"></div>
  </form>
   </div><!-- /.row -->
  </div><!-- /my-search -->
