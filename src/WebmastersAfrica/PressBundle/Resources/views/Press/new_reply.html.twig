<!DOCTYPE html>
<html>
<head>
	<title>New Message</title>
</head>
<body>
	<main>
		<div class="card">
		  <div class="card-body">
		  	{% if comment.user %}
		  		{% if comment.user.aliasName %}
		  		{% set fullname = comment.user.aliasName %}
		  		{% else %}
		  			{% set fullname = comment.user.fullname %}
		  		{% endif %}
					<h3 class="card-title"><a class="fa fa-inbox"> New Reply From <span class="card-subtitle mb-2 text-muted">{{ fullname }}</span></a></h3>
				{% else %}
					<h3 class="card-title"><a class="fa fa-inbox"> New Reply From <span class="card-subtitle mb-2 text-muted">GUEST USER</span></a></h3>
				{% endif %}
		    <p class="card-text">{{comment.comment}}</p>
		    <a href="http://68.183.237.236:8083{{path('regulation_comments', {'slug': comment.regulation.slug })}}" class="card-link">Link to consultation</a>
		    <a href="http://68.183.237.236:8083{{path('nc_edit_profile')}}" class="card-link">Unsubscribe here</a>
		  </div>
		</div>
	</main>

<script src="https://code.jquery.com/jquery-3.3.1.slim.min.js" integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo" crossorigin="anonymous"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js" integrity="sha384-UO2eT0CpHqdSJQ6hJty5KVphtPhzWj9WO1clHTMGa3JDZwrnQq4sF86dIHNDz0W1" crossorigin="anonymous"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js" integrity="sha384-JjSmVgyd0p3pXB1rRibZUAYoIIy6OrQ6VrjIEaFf/nJGzIxFDsf4x0xIM+B07jRM" crossorigin="anonymous"></script>
</body>
</html>