{# src/Webmasters/ContentBundle/Resources/views/Content/index.html.twig #}

{% trans_default_domain 'WebmastersAfricaPressBundle' %}

{% extends 'WebmastersAfricaPressBundle:Layouts:base.html.twig' %}

{% block page_title %}Licenses{% endblock %}

{% block breadcrumb %}
<ul class="breadcrumb">
    <li>
        <a href="{{ app.request.basepath }}">Home</a>
    </li>
    <li>
        /
    </li>
    <li class="last-child">Licenses</li>
    <li>
        /
    </li>
    <li class="last-child">View License</li>
</ul><!--breadcrumb-->
{% endblock%}

{% block pageheader %}{{ license.name }}{% endblock %}

{% block body %}


<div class="my-search" style="background:#868e8f; padding:20px;">
        <a class="print" target="_blank" href="{{ app.request.basepath }}/printlicense/id/{{ license.id }}" title="Print"> <i class="icon-pdf-icon"></i></a>

            
        <h2 style="color:#fff;">{{ license.name }}</h2>
        
        <p style="color:#e2e2e2;"><strong>Purpose:</strong>{{ license.purpose }}</p>

        <h3 class="toggle box">Details <span class="ico"></span></h3>
                <div class="toggle_content boxed">
                <ul class="list_check">
        {% if ('6' in showedfields) %}
        <li> <span> {{ 'licenses.fieldnames.licenseno'|trans }}: </span>{{ license.licenseNo }}</li>
        {% endif %}
        
        {% if ('20' in showedfields) %}
        <li> <span> {{ 'licenses.fieldnames.agency'|trans }}: </span>{{ license.agency }}</li>
        {% endif %}
        
        {% if ('3' in showedfields) %}
        <li> <span> {{ 'licenses.fieldnames.purpose'|trans }}: </span>{{ license.purpose }}</li>
        {% endif %}
        
        {% if ('19' in showedfields) %}
          {% if license.location is sameas("") %}
           <li> <span> {{ 'licenses.fieldnames.jurisdiction'|trans }}: </span>{{ license.location.name }}</li>
          {% endif %}
        {% endif %}
        
        {% if ('7' in showedfields) %}
        <li> <span> {{ 'licenses.fieldnames.applicationfee'|trans }}: </span>{{ license.applicationFee }}</li>
        {% endif %}
        
        {% if ('8' in showedfields) %}
        <li> <span> {{ 'licenses.fieldnames.licensefee'|trans }}: </span>{{ license.licenseFee }}</li>
        {% endif %}
        
        {% if ('9' in showedfields) %}
        <li> <span> {{ 'licenses.fieldnames.maximumprocessingtime'|trans }}: </span>{{ license.maxProcessingTime }}</li>
        {% endif %}
        
        {% if ('10' in showedfields) %}
        <li> <span> {{ 'licenses.fieldnames.gazettedon'|trans }}: </span>{{ license.gazettedOn | date("d-m-Y") }}</li>
        {% endif %}
        
        {% if ('11' in showedfields) %}
        <li> <span> {{ 'licenses.fieldnames.relatedwebsites'|trans }}: </span>{{ license.relatedWebsites }}</li>
        {% endif %}
        
        {% if ('12' in showedfields) %}
        <li> <span> {{ 'licenses.fieldnames.validity'|trans }}: </span>{{ license.validity }}</li>
        {% endif %}
        
        {% if ('13' in showedfields) %}
        <li> <span> {{ 'licenses.fieldnames.enactment'|trans }}: </span>{{ license.enactment | date("d-m-Y") }}</li>
        {% endif %}
        
        {% if ('15' in showedfields) %}
        <li> <span> {{ 'licenses.fieldnames.contactoffice'|trans }}: </span>{{ license.contactOffice }}</li>
        {% endif %}
        
        {% if ('16' in showedfields) %}
        <li> <span> {{ 'licenses.fieldnames.resolutioncriteria'|trans }}: </span>{{ license.resolutionCriteria }}</li>
        {% endif %}
        
        {% for field in licensefields %}
        <li> <span> {{ field.fieldlabel }}: </span> {% for datafield in fielddatas %}{% if (datafield.fieldId == field.id) %}{{ datafield.fielddata }}{% endif %}{% endfor %}</li>
        {% endfor %}
        </ul>
        </div>
                    
                    
        <h3 class="toggle box">License Requirements <span class="ico"></span></h3>
        <div class="toggle_content boxed">
        <ul class="list_check">
        {% for requirement in license.requirements %}
            <li>{{ requirement.description }}</li>
        {% endfor %}
        </ul>
        </div>
        
        <h3 class="toggle box">Download Forms/Info <span class="ico"></span></h3>
        <div class="toggle_content boxed">
        <ul class="list_check">
        {% for download in license.downloads %}
            <li><a href="{{ app.request.basepath }}/uploads/documents/{{ download.filepath }}">{{ download.name }}</a></li>
        {% endfor %}
        </ul>
        </div>
        
        <h3 class="toggle box">Issuing agency <span class="ico"></span></h3>
        <div class="toggle_content boxed">
        <ul class="list_check">
                            <li id="no_bglist">
                        <h4><a>{{ license.agency.name }} - Head Office</a></h4>
                        <div class="tbbd-acc_acc-section">
                            <div class="tbbd-acc_acc-content">
                            
                        <ul>
                          <li>Tel: {{ license.agency.telephone }} </li>
                          <li>Physical Address:  {{ license.agency.address }} </li>
                          <li>Postal Address:  {{ license.agency.postalAddress }} </li>
                          <li>City: {{ license.agency.location.name }} </li>
                          <li>
                          <div id='basic-modal'>Email Address: {{ license.agency.email }} <a href="{{ app.request.basepath }}/email/agency/{{ license.agency.id }}" title="Email this Agency" class="basic">Email this Agency</a> </div> </li>
                          <li>Website: <a href="{% if  'http' in license.agency.website %}{{ license.agency.website }}{% else %}http://{{ license.agency.website }}{% endif %}" target="_blank">{{ license.agency.website }}</a> </li>
                          <li>Operating Hours: {{ license.agency.hours }} </li>
                          
                          {% if license.agency.mapScan!= '' %} 
                          
                            <li>Directions: 
                            <a href="{{ app.request.basepath }}/uploads/map_scans/{{ license.agency.mapScan }}" title="Get Directions" alt="Get Directions" target="_blank">View Directions</a>
                          </li>
                          
                          {% endif %}
                          
                            
                          {% if license.agency.latitude and license.agency.longitude %} 
                          
                          <li>Directions:
                          <a href="{{ app.request.basepath }}/agency/viewmap/{{ license.agency.id }}" title="View Directions" onclick="
                        Modalbox.show(this.href, {title: this.title, width: 460, afterLoad: function(){initialize({{ license.agency.latitude }}, {{ license.agency.longitude }});}}); return false;">View Directions</a>
                          </li>
                          
                          {% endif  %}
                        </ul>
                                                    </div>
                                                </div>
                        </li>

                        {% for agencyoffice in license.agency.agencyoffices %}
                        <li id="no_bglist">
                                                <h4><a>{{ agencyoffice.name }}</a></h4>
                                                <div class="tbbd-acc_acc-section">
                                                    <div class="tbbd-acc_acc-content">
                         <ul>
                          <li>Tel: {{ agencyoffice.tel }} </li>
                          <li>Physical Address: {{ agencyoffice.address }} </li>
                          <li>Postal Address:  {{ agencyoffice.postalAddress }} </li>
                          
                          <li>
                          <div id='basic-modal'>Email Address: {{ agencyoffice.email }} <a href="{{ app.request.basepath }}/email/agency/{{ agencyoffice.id }}" title="Email this Agency" class="basic">Email this Agency</a> </div> </li>
                          <li>Website: <a href="{{ agencyoffice.website }}" target="_blank">{{ agencyoffice.website }}</a> </li>
                          <li>Operating Hours: {{ agencyoffice.hours }} </li>
                          
                         
                          {% if license.agency.mapScan!= '' %} 
                          
                            <li>Directions: 
                            <a href="{{ app.request.basepath }}/uploads/map_scans/{{ agencyoffice.mapScan }}" title="Get Directions" alt="Get Directions" target="_blank">View Directions</a>
                          </li>
                          
                          {% endif %}
                          
                           {% if license.agency.latitude and license.agency.longitude %} 
                          
                          <li>Directions:
                          <a href="{{ app.request.basepath }}/agency/viewmap/{{ agencyoffice.id }}" title="View Directions" onclick="
                        Modalbox.show(this.href, {title: this.title, width: 460, afterLoad: function(){initialize({{ agencyoffice.latitude }}, {{ agencyoffice.longitude }});}}); return false;">View Directions</a>
                          </li>
                          
                          {% endif  %}
                        </ul>                           </div>
                                                </div>
                                            </li>
                        {% endfor %}
        </ul>
        </div>
                  
    </div>
    
        
{% endblock %}
