{# src/Webmasters/ContentBundle/Resources/views/Content/index.html.twig #}

{% trans_default_domain 'WebmastersAfricaPressBundle' %}

{% extends 'WebmastersAfricaPressBundle:Layouts:base.html.twig' %}

{% block page_title %}{{ 'newsletter_sign_up'|trans }}{% endblock %}

{% block breadcrumb %}
<ul class="breadcrumb">
    <li>
        <a href="{{ app.request.basepath }}">Home</a>
    </li>
    <li>
        /
    </li>
    <li class="last-child">{{ 'newsletter_sign_up'|trans }}</li>
</ul><!--breadcrumb-->
{% endblock%}

{% block pageheader %}{{ 'newsletter_sign_up'|trans }}{% endblock %}

{% block body %}
<!-- middle -->
<div class="white-background">
    <div class="container ">
            <!-- content -->
            <div class="content" role="main">
            
				{{ 'subscription_fail' | trans }}

                <br> <br>
                <h3 class="widget-title">{{ 'newsletter_sign_up'|trans }}</h3>
                <ul>
                <li>
                <div class="widget_login">
                    <form id="form-comments"  action="{{ app.request.basepath }}/newsletter/subscriptioncheck" method="post" autocomplete="off">
                        {{ form_errors(form) }}

                        {{ form_widget(form.subscriber_name, { 'attr': {'placeholder': 'newsletter_name'|trans,'class':'inputtext input_middle required'} }) }}
                        <br>
                        <div style="color: #FF0000;">
                            {{ form_errors(form.subscriber_name) }}
                        </div>
                        <br>
                        {{ form_widget(form.subscriber_email, { 'attr': {'placeholder': 'newsletter_email'|trans,'class':'inputtext input_middle required'} }) }}
                        <br>
                        <div style="color: #FF0000;">
                            {{ form_errors(form.subscriber_email) }}
                        </div>
                        <br>

                        {{ form_rest(form) }} 

                        <p class="submit">
                         <input type="submit" name="wp-submit" id="wp-submit" class="btn-submit"  name="submitbuttonname" value="{{ 'feedback_submit'|trans }}" tabindex="100">
                        </p>
                    </form> 
                </div>
                </li>
                </ul>
                <div class="clear"></div>

			</div>

	</div>
</div>

{% endblock %}