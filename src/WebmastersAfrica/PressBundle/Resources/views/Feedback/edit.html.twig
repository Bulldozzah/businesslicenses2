{# src/WebmastersAfrica/PressBundle/Resources/views/Default/index.html.twig #}

{% extends 'WebmastersAfricaAdminBundle::adminlayout.html.twig' %}

{% trans_default_domain 'WebmastersAfricaPressBundle' %}

{% block page_title %}{{ site_title }}, {{ 'feedback.edit_feedback' | trans }}{% endblock %}

{% block header %}
<!-- Title area -->
<div class="titleArea">
    <div class="wrapper">
        <div class="pageTitle">
            <h5>{{ 'feedback.edit_feedback' | trans }}</h5>
            <span>{{ 'feedback.edit_feedback_description' | trans }}</span>
        </div>

        <div class="clear"></div>
    </div>
</div>
{% endblock %}

{% block body %}
<div class="widget">
    <div class="title"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/frames.png') }}" alt="" class="titleIcon" />
    <h6>
      {{ 'feedback.edit_feedback' | trans }}
    </h6>

    <div class="num">
      <a href="{{ path('managefeedback') }}" title="{{ 'feedback.back_to_list' | trans }}" class="greyNum w3-button w3-round-large w3-hover-red"><span>{{ 'feedback.back_to_list' | trans }}</span></a>
	  </div>
    </div>

 <form action="{{ path('managefeedback_update', { 'id': entity.id }) }}" method="post" {{ form_enctype(edit_form) }} class="form">
        <input type="hidden" name="_method" value="PUT" />
		{{ form_row(edit_form.first_name) }}
        {{ form_row(edit_form.last_name) }}
        {{ form_row(edit_form.email) }}
        {{ form_row(edit_form.subject) }}
        {{ form_row(edit_form.message) }}
        <div class="formSubmit">
          {{ form_row(edit_form.update, { 'attr': {'class':'w3-right w3-center w3-button w3-blue w3-round-medium', 'style':'padding: 10px 30px 30px 30px; margin-right:15px;'} }) }}
        <div style="display: none;">
        {{ form_rest(edit_form) }}
        </div>
	</form>
    <div>
    	{{ form(delete_form) }}
	</div>
</div>
<div class="clear"></div>
</div>

<script src="{{ asset('bundles/webmastersafricapress/new/assets/validate.js') }}"></script>
<script>
    $("#form_message").cleditor({width: "100%", height: "100%", bodyStyle: "margin: 10px; font: 12px Arial,Verdana; cursor:text"});
  
    $(".label-required").append("<i style='color: red;'>*</i> ")
    $(".form").validate();
    // Requirements
    
</script>

{% endblock %}
