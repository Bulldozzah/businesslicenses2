{# src/WebmastersAfrica/PressBundle/Resources/views/Default/index.html.twig #}

{% extends 'WebmastersAfricaAdminBundle::adminlayout.html.twig' %}

{% trans_default_domain 'WebmastersAfricaPressBundle' %}

{% block page_title %}{{ site_title }}, {{ 'subscribers.edit_subscribers' | trans }}{% endblock %}

{% block header %}
<!-- Title area -->
<div class="titleArea">
    <div class="wrapper">
        <div class="pageTitle">
            <h5>{{ 'subscribers.edit_subscribers' | trans }}</h5>
            <span>{{ 'subscribers.edit_subscribers_description' | trans }}</span>
        </div>

        <div class="clear"></div>
    </div>
</div>
{% endblock %}

{% block body -%}
<div class="widget">
    <div class="title"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/frames.png') }}" alt="" class="titleIcon" />
    <h6>
      {{ 'subscribers.edit_subscribers' | trans }}
    </h6>

    <div class="num">
      <a href="{{ path('managesubscribers') }}" title="{{ 'subscribers.back_to_list' | trans }}" class="greyNum w3-button w3-round-large w3-hover-red"><span>{{ 'subscribers.back_to_list' | trans }}</span></a>
	  </div>
    </div>

 <form action="{{ path('managesubscribers_update', { 'id': entity.id }) }}" method="post" {{ form_enctype(edit_form) }} class="form">
        <input type="hidden" name="_method" value="PUT" />
		{{ form_row(edit_form.name) }}
        {{ form_row(edit_form.email) }}
        {{ form_row(edit_form.organisation) }}
        {{ form_row(edit_form.confirmed) }}

        {{ form_row(edit_form.update, { 'attr': {'class':'w3-right w3-center w3-button w3-blue w3-round-medium', 'style':'padding: 10px 30px 30px 30px; margin-right:15px;'} }) }}
        <div style="display: none;">
            {{  form_rest(edit_form) }}
        </div>
	</form>
    	<button onClick="if(confirm('Are you sure you want to delete this?')){ window.location='{{ path('managesubscribers_delete', { 'id': entity.id }) }}'; }" class='w3-left w3-center w3-button w3-red w3-round-medium' style ='padding: 10px 30px 30px 30px; margin-right:15px;'>Delete</button>
    <div class="clear"></div>
</div>

<script src="{{ asset('bundles/webmastersafricapress/new/assets/validate.js') }}"></script>
      <script language="javascript">

      $(".label-required").append("<i style='color: red;'>*</i> ")
      $(".form").validate();
    // Requirements
    $(document).ready(function() {
        $('#webmastersafrica_pressbundle_newslettersubscriber_email').clone().attr('type', 'email').insertAfter('#webmastersafrica_pressbundle_newslettersubscriber_email').prev().remove();
        $("#webmastersafrica_pressbundle_newslettersubscriber_email").addClass('w3-input w3-border');
    });
</script>
{% endblock %}
