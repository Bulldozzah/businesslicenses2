{% extends '::base.html.twig' %}

{% block body -%}
    <h1>NewsletterSubscriber</h1>

    <table class="record_properties">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ entity.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ entity.name }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ entity.email }}</td>
            </tr>
            <tr>
                <th>Organisation</th>
                <td>{{ entity.organisation }}</td>
            </tr>
            <tr>
                <th>Skey</th>
                <td>{{ entity.skey }}</td>
            </tr>
            <tr>
                <th>Confirmed</th>
                <td>{{ entity.confirmed }}</td>
            </tr>
            <tr>
                <th>Created</th>
                <td>{{ entity.created|date('Y-m-d H:i:s') }}</td>
            </tr>
            <tr>
                <th>Updated</th>
                <td>{{ entity.updated|date('Y-m-d H:i:s') }}</td>
            </tr>
            <tr>
                <th>Contentchanged</th>
                <td>{{ entity.contentChanged|date('Y-m-d H:i:s') }}</td>
            </tr>
        </tbody>
    </table>

        <ul class="record_actions">
    <li>
        <a href="{{ path('managesubcribers') }}">
            Back to the list
        </a>
    </li>
    <li>
        <a href="{{ path('managesubcribers_edit', { 'id': entity.id }) }}">
            Edit
        </a>
    </li>
    <li>{{ form(delete_form) }}</li>
</ul>
{% endblock %}
