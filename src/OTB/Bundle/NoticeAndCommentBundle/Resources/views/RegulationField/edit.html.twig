{# src/WebmastersAfrica/PressBundle/Resources/views/Default/index.html.twig #}

{% extends 'WebmastersAfricaAdminBundle::adminlayout.html.twig' %}

{% trans_default_domain 'WebmastersAfricaLicenseBundle' %}

{% block page_title %}{{ site_title }}, {{ 'custom_license_fields.edit_custom_field' | trans }}{% endblock %}

{% block header %}
<!-- Title area -->
<div class="titleArea">
    <div class="wrapper">
        <div class="pageTitle">
            <h5>{{ 'custom_license_fields.edit_custom_field' | trans }}</h5>
            <span>{{ 'custom_license_fields.edit_custom_field_description' | trans }}</span>
        </div>
        {# <div class="middleNav" style="border: none;">
                <a href="{{ path('manageregulationcustomfields') }}" title="{{ 'custom_license_fields.back_to_list' | trans }}" class="w3-button w3-round-large w3-red w3-medium"><span>{{ 'custom_license_fields.back_to_list' | trans }}</span></a>
            <div class="clear"></div>
        </div> #}
        <div class="clear"></div>
    </div>
</div>
{% endblock %}

{% block body %}


<div class="widget">
<div class="title">
<img class="titleIcon" alt="" src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/cog.png') }}">
<h6>{{ 'custom_license_fields.edit_custom_field_description' | trans }}</h6>

<div class="num">
<a href="{{ path('manageregulationcustomfields') }}" title="{{ 'custom_license_fields.back_to_list' | trans }}" class="greyNum w3-button w3-round-large w3-hover-red">{{ 'custom_license_fields.back_to_list' | trans }}</a>
</div>
</div>
<div class="body nopadding ">
{{ form_start(edit_form, {'attr': {'class': 'form'}}) }}
        <input type="hidden" name="_method" value="PUT" />
		{{ form_row(edit_form.fieldlabel) }}
        {{ form_row(edit_form.fieldtype) }}
        <div class="formRow" style="padding:0;">
            <label class="m10 ml20">Field Choices</label>

            <ul class="fieldchoices" data-prototype="{{ form_widget(edit_form.fieldchoices.vars.prototype)|e }}">
                {% set count = 0 %}
                {% for choice in edit_form.fieldchoices %}
                {% set count = count + 1 %}
                    <li id='choice_{{ count }}'>
                    	<div class="formRow">
                    		{{ form_label(choice.choicename) }}
                    			<div class="formRight">{{ form_widget(choice.choicename) }}
                   					<div style="float: right;">
                    					<a href="#" onClick="document.getElementById('choice_{{ count }}').parentNode.removeChild(document.getElementById('choice_{{ count }}'));" class="w3-button w3-hover-blue w3-round-large w3-red w3-medium">Delete</a>
                    				</div>
                    				<div class="clear"></div>
                    			</div>
                    	</div>
                    </li>
                {% endfor %}
            </ul>

        <div class="clear"></div>
        </div>
        {{ form_row(edit_form.order) }}
        {{ form_row(edit_form.showed) }}

{{ form_row(edit_form.update, { 'attr': {'class':'w3-right w3-center w3-button w3-blue w3-round-medium', 'style':'padding: 10px 30px 30px 30px; margin-right:15px;'} }) }}

<br>
<br>
<div class="clear"></div>
<div style="display: none;">
{{ form_rest(edit_form) }}
</div>
{{ form_end(edit_form) }}
</form>
</div>
</div>


<script src="{{ asset('bundles/webmastersafricapress/new/assets/validate.js') }}"></script>
  <script language="javascript">

  $(".label-required").append("<i style='color: red;'>*</i> ")
  $(".form").validate();
    // Requirements
//Fieldchoices
var $choiceCollectionHolder;

var $addChoiceLink = $('<a href="#" style="float: right;" class="w3-button w3-hover-teal w3-round-large w3-green w3-medium"><span class="">Add a Field Choice</span></a>');
var $newChoiceLinkLi = $('<li></li>').append($addChoiceLink);

function addChoiceForm($choiceCollectionHolder, $newChoiceLinkLi) {
    var prototype = $choiceCollectionHolder.data('prototype');

    var index = $choiceCollectionHolder.data('index');

    var newForm = prototype.replace(/__name__/g, index);

    $choiceCollectionHolder.data('index', index + 1);

    var $newFormLi = $('<li></li>').append(newForm);
    addChoiceFormDeleteLink($newFormLi);
    $newChoiceLinkLi.before($newFormLi);
}

function addChoiceFormDeleteLink($choiceFormLi) {
    var $removeFormA = $('<a href="#" style="float: right;" class="w3-button w3-red w3-round-large w3-medium"><span>delete this choice</span></a><div class="clear"></div><div class="cLine"></div>');
    $choiceFormLi.append($removeFormA);

    $removeFormA.on('click', function(e) {
        // prevent the link from creating a "#" on the URL
        e.preventDefault();

        // remove the li for the tag form
        $choiceFormLi.remove();
    });
}


jQuery(document).ready(function() {
    $choiceCollectionHolder = $('ul.fieldchoices');

    $choiceCollectionHolder.append($newChoiceLinkLi);

    addChoiceFormDeleteLink($(this));

    $choiceCollectionHolder.data('index', $choiceCollectionHolder.find(':input').length);

    $addChoiceLink.on('click', function(e) {
        e.preventDefault();

        addChoiceForm($choiceCollectionHolder, $newChoiceLinkLi);
    });

});

</script>
{% endblock %}
