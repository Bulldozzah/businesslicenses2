{% extends 'WebmastersAfricaAdminBundle::adminlayout.html.twig' %}
{% trans_default_domain 'WebmastersAfricaLicenseBundle' %}
{% block page_title %}
  Eregistry | Add
  {{ 'forward_plans.forward_plans' | trans }}
{% endblock %}

{% block header %}
  <!-- Title area -->
  <div class="titleArea">
    <div class="wrapper">
      <div class="pageTitle">
        <h5>Manage Forward Plan</h5>
        <span>Add Forward Plan</span>
      </div>
      <div class="clear"></div>
    </div>
  </div>
{% endblock %}


{% block body %}
  {{ form_start(form, {'attr': {'class': 'form', 'novalidate':'novalidate'}}) }}
  {{ form_errors(form) }}

  <div id="forward-plans-form">
    <section>
      <div>
        {{ form_row(form.name, { 'attr': {'class': 'w3-input w3-border form-control'} }) }}
      </div>
      <div>
        {{ form_row(form.period, { 'attr': {'class': 'w3-input w3-border form-control'} }) }}
      </div>
      <div>
        {{ form_row(form.period2, { 'attr': {'class': 'w3-input w3-border form-control'} }) }}
      </div>
      <div>{{ form_row(form.description, { 'attr': {'class': 'w3-input w3-border form-control'} }) }}</div>
      <div>{{ form_row(form.agency, { 'attr': {'class': 'w3-select w3-border form-control'} }) }}</div>
      <div>{{ form_row(form.published, { 'attr': {'class': 'w3-check form-control'} }) }}</div>
    </section>
    {{ form_row(form.submit) }}
    <div style="display:none;">
      {{ form_rest(form) }}
    </div>
    {{ form_end(form) }}
  </div>    
{% endblock %}

{% block stylesheet_2 %}
      <script src="{{ asset('bundles/webmastersafricapress/new/assets/validate.js') }}"></script>
	    <script language="javascript">

      $(".label-required").append("<i style='color: red;'>*</i> ")
      $(".form").validate();

    	$(document).ready(function() {
      	$("#forwardplanmaincategory_period").datepicker({ changeMonth: true, changeYear: true });
      	$("#forwardplanmaincategory_period2").datepicker({minDate: new Date()});
      });
      </script>

{% endblock %}
