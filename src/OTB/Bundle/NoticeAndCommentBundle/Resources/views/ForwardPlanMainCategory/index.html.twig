{% extends 'WebmastersAfricaAdminBundle::adminlayout.html.twig' %}

{% trans_default_domain 'WebmastersAfricaLicenseBundle' %}


{% block page_title %}
	{{ site_title }}, Manage Forward Plans
{% endblock %}

{% block header %}
	<!-- Title area -->
	<div class="titleArea">
		<div class="wrapper">
			<div class="pageTitle">
				<h5>Manage Forward Plans</h5>
				<span>List of Forward Plans</span>
			</div>
			<div class="clear"></div>
		</div>
	</div>


	<div class="line"></div>


	<div class="statsRow">

		<div class="wrapper w3-center">
			<div class="w3-show-inline-block">
				<div class="controlC">
					<a href="{{ path("forwardplanmaincategory_new") }}" title="" class="w3-button w3-hover-teal w3-round-large w3-green w3-medium" title="" href="#">
						<img alt="" src="{{ asset('bundles/webmastersafricaadmin/images/icons/sPlus.png') }}" alt=""/>
						<span>Add New Forward Plan</span>
					</a>
					<a href="{{ path("forward_plans") }}" title="" class="w3-button w3-hover-teal w3-round-large w3-blue w3-medium" title="" href="#">
						<i class="fa fa-bars"></i>
						<span>Forward Plan Regulations</span>
					</a>
					<div class="clear"></div>
				</div>
				<div class="clear"></div>
			</div>
		</div>
	</div>

{% endblock %}
{% block body %}
	{% for flashMessage in app.session.flashbag.get('update') %}
		<div class="nNote nSuccess hideit">
			<p>
				<strong>Success:
				</strong>
				{{ 'licenses.updated_item_notice' | trans }}
			</p>
		</div>
	{% endfor %}
	{% for flashMessage in app.session.flashbag.get('create') %}
		<div class="nNote nSuccess hideit">
			<p>
				<strong>Success:
				</strong>
				{{ 'licenses.updated_item_notice' | trans }}
			</p>
		</div>
	{% endfor %}
	{% for flashMessage in app.session.flashbag.get('delete') %}
		<div class="nNote nSuccess hideit">
			<p>
				<strong>Success:
				</strong>
				{{ 'licenses.deleted_item_notice' | trans }}
			</p>
		</div>
	{% endfor %}
	<div class="widget">
		<div class="title"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/home2.png') }}" alt="" class="titleIcon"/>
			<h6>List of all Forward Plans</h6>
		</div>
		<table cellpadding="0" cellspacing="0" width="100%" class="sTable mTable" id="business_agency">
			<thead>
				<tr>
					<td width="40">
						<div>&middot;&middot;&middot;</div>
					</td>
					<td>Name</td>
					<td>Period</td>
					<td>Agency</td>
					<td>Regulations Count</td>
					<td>Action</td>
				</tr>
			</thead>
			<tbody>
				{% for entity in entities %}
					<tr>
						<td align="center">
							<a href="{{ path('forwardplanmaincategory_show', { 'id': entity.id }) }}">{{ entity.id }}</a>
						</td>
						<td>{{ entity.name }}</td>
						<td>{{ entity.period }}</td>
						<td>{{ entity.agency }}</td>
						<td>{{ entity.forwardPlans|length }}</td>
						<td>
							<ul>
								<li>
									<a href="{{ path('forwardplanmaincategory_edit', { 'id': entity.id }) }}" class="smallButton" title="Edit Forward Plan Details">
										<img alt="Edit this forward plan" src="{{ asset('bundles/webmastersafricaadmin/images/icons/color/pencil.png') }}">
									</a>
									|
									<a href="{{ path('forwardplanmaincategory_show', { 'id': entity.id }) }}" class="smallButton" title="List of Forward Plan Regulations">
										<i class="fa fa-eye"></i>
									</a>
								</li>
							</ul>
						</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>
</div>{% endblock %}
