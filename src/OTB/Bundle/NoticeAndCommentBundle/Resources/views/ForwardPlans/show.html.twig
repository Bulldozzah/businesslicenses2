{% extends '::base.html.twig' %}

{% block body -%}
    <h1>ForwardPlans</h1>

    <table class="record_properties">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ entity.id }}</td>
            </tr>
            <tr>
                <th>Title</th>
                <td>{{ entity.title }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ entity.description }}</td>
            </tr>
            <tr>
                <th>Problemaddressed</th>
                <td>{{ entity.problemAddressed }}</td>
            </tr>
            <tr>
                <th>Publicconsultation</th>
                <td>{{ entity.publicConsultation }}</td>
            </tr>
            <tr>
                <th>Attachmentid</th>
                <td>{{ entity.attachmentId }}</td>
            </tr>
            <tr>
                <th>Agencyid</th>
                <td>{{ entity.agencyId }}</td>
            </tr>
            <tr>
                <th>Offlineoffice</th>
                <td>{{ entity.offlineOffice }}</td>
            </tr>
        </tbody>
    </table>

        <ul class="record_actions">
    <li>
        <a href="{{ path('forwardplans') }}">
            Back to the list
        </a>
    </li>
    <li>
        <a href="{{ path('forwardplans_edit', { 'id': entity.id }) }}">
            Edit
        </a>
    </li>
    <li>{{ form(delete_form) }}</li>
</ul>
{% endblock %}
