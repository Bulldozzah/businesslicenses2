{# src/WebmastersAfrica/PressBundle/Resources/views/Default/index.html.twig #}

{% extends 'WebmastersAfricaAdminBundle::adminlayout.html.twig' %}

{% trans_default_domain 'WebmastersAfricaLicenseBundle' %}

{% block page_title %}{{ site_title }}, {{ 'fixed_license_fields.edit_fixed_fields' | trans }}{% endblock %}

{% block header %}
<!-- Title area -->
<div class="titleArea">
    <div class="wrapper">
        <div class="pageTitle">
            <h5>{{ 'fixed_license_fields.edit_fixed_fields' | trans }}</h5>
            <span>{{ 'fixed_license_fields.edit_field_description' | trans }}</span>
        </div>
        <div class="clear"></div>
    </div>
</div>
{% endblock %}

{% block body %} 
<div class="widget">
<div class="title">
<img class="titleIcon" alt="" src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/cog2.png') }}">
<h6>{{ 'fixed_license_fields.edit_field_description' | trans }}</h6>
</div>
<div class="body nopadding ">
 <form action="{{ path('regulation_managefixedfields_update', { 'id': entity.id }) }}" method="post" {{ form_enctype(edit_form) }} class="form">
        <input type="hidden" name="_method" value="PUT" />
        {{ form_row(edit_form.fieldlabel) }}
        {{ form_row(edit_form.showed) }}
        {{ form_row(edit_form.required) }}
<div class="formSubmit">
{{ form_row(edit_form.update, { 'attr':{'class':'w3-right w3-center w3-button w3-blue w3-round-medium', 'style':'padding: 10px 30px 30px 30px; margin-right:15px;'} }) }}
</div>
<div class="clear"></div>
<div style="display: none;">
{{ form_rest(edit_form) }}
</div>
</form>
</div>
</div>

<script src="{{ asset('bundles/webmastersafricapress/new/assets/validate.js') }}"></script>
      <script language="javascript">

      $(".label-required").append("<i style='color: red;'>*</i> ")
      $(".form").validate();
    // Requirements

</script>
{% endblock %}
