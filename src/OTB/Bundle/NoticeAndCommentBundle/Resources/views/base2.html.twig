    {% block genemu_captcha_javascript %}{% endblock %}
    {% block custom_js %}
      <script>
        var placeholder = "Search By Keyword";
        $(".select2-single").select2({placeholder: placeholder, width: null, containerCssClass: ':all:'});
      </script>
    {% endblock %}

    {% block comments %}{% endblock %}

    <!-- /js -->

    <script>
      $(document).ready(function() {
        // $("#regulation_search_agency_id").select2();
      });
      (function (i, s, o, g, r, a, m) {
        i['GoogleAnalyticsObject'] = r;
        i[r] = i[r] || function () {
          (i[r].q = i[r].q || []).push(arguments)
        },
        i[r].l = 1 * new Date();
        a = s.createElement(o),
        m = s.getElementsByTagName(o)[0];
        a.async = 1;
        a.src = g;
