{% extends 'WebmastersAfricaAdminBundle::adminlayout.html.twig' %}
{% trans_default_domain 'WebmastersAfricaLicenseBundle' %}
{% block page_title %}
    Eregistry | show
    {{ entity.surveyName }}
{% endblock %}

{% block header %}
    <!-- Title area -->
    <div class="titleArea">
        <div class="wrapper">
            <div class="pageTitle">
                <h3>
                    <b>Survey Title:</b>
                    {{ entity.surveyName }}
                </h3>
                {% if entity.questions|length > 0 %}
                    <h3>
                    	<a target="_blank" href="{{path('manage_surveys_preview', {'survey_id': entity.id })}}" class="w3-button w3-black w3-medium w3-hover-black">Preview</a>
                        <span style="margin: 0 30px 0 30px;"></span>
                        <span id="js-alert-messages">
                            {% if entity.published %}
                                <a href="#" onclick="unpublishSurvey({{ entity.id }})" class="w3-button w3-red w3-medium w3-hover-red">Unpublish</a>
                            {% else %}
                                <a href="#" onclick="publishSurvey({{ entity.id }})" class="w3-button w3-blue w3-medium w3-hover-blue">Publish</a>
                            {% endif %}
                        </span>
                    </h3>
                {% endif %}
            </div>
            <div class="clear"></div>
        </div>
        <div class="statsRow">
            <div class="wrapper w3-center">
                <div class="w3-show-inline-block">
                    <div class="w3-bar">

                        <a href="{{ path("manage_surveys_new_question", {'id': entity.id }) }}" title="" class="w3-button w3-hover-red w3-round-large w3-green w3-medium" title="" href="#">
                            <img alt="" src="{{ asset('bundles/webmastersafricaadmin/images/icons/sPlus.png') }}" alt=""/>
                            <span>Add new question</span>
                        </a>

                        {% if entity.surveyResponses|length > 0 %}
		                        <a href="{{ path("manage_surveys_responses_download", {'survey_id': entity.id }) }}" title="" class="w3-button w3-hover-green w3-round-large w3-blue w3-medium" title="" href="#">
												    <span><i class="fa fa-download"></i> Download Excel Document</span>
												    </a>

												    <a href="{{ path("manage_surveys_responses_show", {'survey_id': entity.id }) }}" title="" class="w3-button w3-hover-green w3-round-large w3-red w3-medium" title="" href="#">
												    <span><i class="fa fa-eye"></i> View Responses</span>
												    </a>
										    {% endif %}

                        <div class="clear"></div>
                    </div>
                </div>
                <div class="clear"></div>
            </div>
        </div>
    </div>
{% endblock %}

{% block body %}
    {% for flashMessage in app.session.flashbag.get('update') %}
        <div class="nNote nSuccess hideit">
            <p>
                <strong>Success:
                </strong>
                {{ 'licenses.updated_item_notice' | trans }}
            </p>
        </div>
    {% endfor %}
    {% for flashMessage in app.session.flashbag.get('create') %}
        <div class="nNote nSuccess hideit">
            <p>
                <strong>Success:
                </strong>
                {{ 'licenses.created_item_notice' | trans }}
            </p>
        </div>
    {% endfor %}
    {% for flashMessage in app.session.flashbag.get('delete') %}
        <div class="nNote nSuccess hideit">
            <p>
                <strong>Success:
                </strong>
                {{ 'licenses.deleted_item_notice' | trans }}
            </p>
        </div>
    {% endfor %}

    <div class="widget">
        <div class="title">
            <img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/docs.png') }}" alt="" class="titleIcon"/>
            <h6>List of Questions (drag the question name to change the order)</h6>
        </div>

        <form id="batch_form" name="batch_form" action="{{ path("batch_survey_questions", {'id': entity.id}) }}" method="post">
            <table cellpadding="0" cellspacing="0" width="100%" class="sTable mTable w3-table-all w3-card-4" id="js_manage_survey_questions_table">
                <thead>
                    <tr>
                        <th width="40px;">
                            <div>&middot;&middot;&middot;</div>
                        </th>
                        <th width="40px;">
                            <div>#</div>
                        </th>
                        <th>Question</th>
                        <th>Question type</th>
                        <th width="40px;">Actions</th>
                    </tr>
                </thead>
                <tfoot>
                    <tr>
                        <td colspan="5">
                            <div class="itemActions">
                                <select id="batch_select" name="batch_select" class="form-control" onchange="if(atLeastOne()){ if(confirm('{{ 'locations.batch_confirm_1' | trans }} ' + this.value + ' {{ 'locations.batch_confirm_2' | trans }}')){ document.getElementById('batch_form').submit(); } }">
                                    <option>{{ 'locations.select_batch' | trans }}...</option>
                                    <option value="delete">{{ 'locations.delete' | trans }}</option>
                                </select>
                            </div>
                        </td>
                    </tr>
                </tfoot>
                <tbody>
                    {% for entity in entity.questions %}
                      <tr data-index="{{entity.id}}" data-position="{{entity.questionOrder}}">
                          <td>
                              <input type="checkbox" name="batch_items[]" value="{{ entity.id }}">
                          </td>
                          <td align="center">
                              <a href="{{ path('manage_surveys_questions_edit', { 'id': entity.id }) }}">{{ entity.id }}</a>
                          </td>
                          <td>{{ entity.questionText }}</td>
                          <td>{{ entity.questionsTypeDescription }}</td>
                          <td>
                              <ul>
                                  <li><a href="{{path('manage_surveys_questions_edit',{'id':entity.id})}}" class="smallButton">
                                  <img alt="{{'locations.edit'|trans}}"src="{{asset('bundles/webmastersafricaadmin/images/icons/color/pencil.png')}}"></a></li>
                              </ul>
                          </td>
                      </tr>
                    {% endfor %}
                </tbody>
            </table>
        </form>
    </div>
{% endblock %}
{% block stylesheet_2 %}
    <script>
        $(document).ready(function () {
            $('#js_manage_survey_questions_table').DataTable({"ordering": false});
            $(function () {
    	        $("#js_manage_survey_questions_table tbody").sortable({
    	        	cursor: "move",
    	        	update: function(event, ui) {
    	        		let updated = false;
    	        		$(this).children().each(function (index) {
    	        			if ($(this).attr('data-position') != (index+1)) {
    	        				$(this).attr('data-position', (index+1)).addClass('updated');
    	        				updated = true;
    	        			}
    	        		});
    	        		console.log(updated);
    	        		if (updated) {
    	        			saveNewPosition();
    	        		}
    	        	}
    	        });
    	    });

    	    const saveNewPosition = () => {
    	    	let positions = [];
    	    	$('.updated').each(function () {
    	    		positions.push([$(this).attr('data-index'), $(this).attr('data-position')]);
    	    		$(this).removeClass('updated');
    	    		let url = "{{ path('update_surveys_question_positions') }}";
    	    		console.log(url);
    	    		$.ajax({
    	    			url: url,
    	    			type: 'post',
    	    			dataType: 'text',
    	    			data: {
    	    				update: 1,
    	    				positions: positions
    	    			},
    	    			success: function (response) {
    	    				console.log(response);
    	    			}
    	    		});
    	    	});
    	    }
        });

        function publishSurvey(id) {
            var url = "{{ path('manage_surveys_publish') }}";
            var asset = "{{ asset('bundles/webmastersafricaadmin/images/icons/dark/check.png') }}"
            $.ajax({
                url: url,
                type: 'post',
                dataType: 'json',
                data: {id: id},
                success: function(response) {
                    if (response.success) {

                        $("#js-alert-messages").html("<div class='nNote nSuccess hideit'><p class='alert alert-success'>"+ response.message + "</p></div>");
                    } else {
                        $("#js-alert-messages").html("<div class='nNote nFailure hideit'><p class='alert alert-error'>"+ response.message + "</p></div>");
                    }

                }
            });
        }

        function unpublishSurvey(id) {
            var url = `{{ path('manage_surveys_unpublish') }}`;
            var asset = "{{ asset('bundles/webmastersafricaadmin/images/icons/dark/close.png') }}"
            $.ajax({
                url: url,
                type: 'post',
                dataType: 'json',
                data: {id: id},
                success: function(response) {
                    if (response.success) {
                        $("#js-alert-messages").html("<div class='nNote nSuccess hideit'><p class='alert alert-success'>"+ response.message + "</p></div>");
                    } else {
                        $("#js-alert-messages").html("<div class='nNote nFailure hideit'><p class='alert alert-error'>"+ response.message + "</p></div>");
                    }
                }
            });
        }
    </script>
{% endblock %}
