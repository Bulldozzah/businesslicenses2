  <body class="page-header-fixed page-quick-sidebar-over-content">
      <div class="page-header navbar navbar-fixed-top">
        <!-- BEGIN HEADER INNER -->
        <div class="page-header-inner">
          <!-- BEGIN LOGO -->
          <div class="page-logo">
            <a href="index.html">
              <img alt="logo" style="margin-top: -10px;" class="logo-default" src="{{ asset('/bundles/webmastersafricapress/new/img/logo.png') }}"/>
            </a>
          </div>
          <!-- END LOGO -->
          <!-- BEGIN RESPONSIVE MENU TOGGLER -->
          <a class="menu-toggler responsive-toggler" data-target=".navbar-collapse" data-toggle="collapse" href="javascript:;"></a>
          <!-- END RESPONSIVE MENU TOGGLER -->
          <!-- BEGIN TOP NAVIGATION MENU -->
          <div class="top-menu">
            <ul class="nav navbar-nav pull-right">
              <!-- BEGIN INBOX DROPDOWN -->
              <li class="dropdown dropdown-extended dropdown-inbox" id="header_inbox_bar">
                <a class="dropdown-toggle" data-close-others="true" data-hover="dropdown" data-toggle="dropdown" href="#">
                <i class="icon-envelope-open"></i>
                  {% if fos_message_nb_unread() > 0 %}
                    <span class="badge badge-default">  {{ fos_message_nb_unread() }} </span>
                  {% endif %}
                </a>
                <ul class="dropdown-menu">
                  {% if fos_message_nb_unread() > 0 %}
                    <li>
                      <p>You have {{ fos_message_nb_unread() }} Messages</p>
                    <li>
                  {% endif %}
                  <li> 
                    <ul class="dropdown-menu-list scroller" style="height: 250px;">
                      <li>
                        <a href="{{ path("fos_message_thread_new") }}" title="{{ 'topbar.messages.new_message'|trans }}" class="sAdd">{{ 'topbar.messages.new_message'|trans }}</a>
                      </li>
                      <li>
                      <a href="{{ path("fos_message_inbox") }}" title="{{ 'topbar.messages.inbox'|trans }}" class="sInbox">
                        {{ 'topbar.messages.inbox'|trans }}
                      </a>
                      </li>
                      <li>
                      <a href="{{ path("fos_message_sent") }}" title="{{ 'topbar.messages.outbox'|trans }}" class="sOutbox">{{ 'topbar.messages.outbox'|trans }}
                          </a>
                      </li>
                      <li>
                        <a href="{{ path("fos_message_deleted") }}" title="{{ 'topbar.messages.trash'|trans }}" class="sTrash">{{ 'topbar.messages.trash'|trans }}
                        </a>
                      </li>
                    </ul>
                  </li>
                </ul>
              </li>
              <!-- END INBOX DROPDOWN -->
              <!-- BEGIN TODO DROPDOWN -->
              <li class="dropdown dropdown-extended dropdown-tasks" id="header_task_bar">
                <a class="dropdown-toggle" data-close-others="true" data-hover="dropdown" data-toggle="dropdown" href="{{ path("managetasks") }}">
                  <i class="icon-calendar"></i>
                </a>
              </li>
              <!-- END TODO DROPDOWN -->
              <!-- BEGIN USER LOGIN DROPDOWN -->
              <li class="dropdown dropdown-user">
                <a class="dropdown-toggle" data-close-others="true" data-hover="dropdown" data-toggle="dropdown" href="#">
                  <img alt="" class="img-circle hide1" src="{{ asset('bundles/webmastersafricaadmin/images/userPic.png') }}"/>
                  <span class="username username-hide-on-mobile">
                    {{ app.security.getToken().getUser().getUsername() }}
                  </span>
                  <i class="fa fa-angle-down"></i>
                </a>
                <ul class="dropdown-menu">
                  <li>
                    <a href="{{ path('fos_user_profile_edit') }}">
                      <i class="icon-user"></i>
                      {{ 'topbar.profile'|trans }}
                    </a>
                  </li>
                  <li>
                    <a href="{{ path("fos_user_security_logout") }}">
                      <i class="icon-key"></i>
                      {{ 'topbar.logout'|trans }}
                    </a>
                  </li>
                </ul>
              </li>

