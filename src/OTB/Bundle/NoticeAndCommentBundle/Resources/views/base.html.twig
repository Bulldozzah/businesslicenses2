                <li><a href="{{ path("setting_edit", {'id':'1'}) }}" title="{{ 'topbar.settings'|trans }}"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/topnav/settings.png') }}" alt="" /><span>{{ 'topbar.settings'|trans }}</span></a></li>
