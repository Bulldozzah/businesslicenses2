{% extends '::base.html.twig' %}

{% block body -%}
    <h1>Comment list</h1>

    <table class="records_list">
        <thead>
            <tr>
                <th>Id</th>
                <th>Comment</th>
                <th>Createat</th>
                <th>Updatedat</th>
                <th>Likes</th>
                <th>Isabusive</th>
                <th>Deletedat</th>
                <th>User</th>
                <th>Parent</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for entity in entities %}
            <tr>
                <td><a href="{{ path('managecomments_show', { 'id': entity.id }) }}">{{ entity.id }}</a></td>
                <td>{{ entity.comment }}</td>
                <td>{% if entity.createAt %}{{ entity.createAt|date('Y-m-d H:i:s') }}{% endif %}</td>
                <td>{% if entity.updatedAt %}{{ entity.updatedAt|date('Y-m-d H:i:s') }}{% endif %}</td>
                <td>{{ entity.likes }}</td>
                <td>{{ entity.isAbusive }}</td>
                <td>{% if entity.deletedAt %}{{ entity.deletedAt|date('Y-m-d H:i:s') }}{% endif %}</td>
                <td>{{ entity.user }}</td>
                <td>{{ entity.parent }}</td>
                <td>
                <ul>
                    <li>
                        <a href="{{ path('managecomments_show', { 'id': entity.id }) }}">show</a>
                    </li>
                    <li>
                        <a href="{{ path('managecomments_edit', { 'id': entity.id }) }}">edit</a>
                    </li>
                </ul>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

        <ul>
        <li>
            <a href="{{ path('managecomments_new') }}">
                Create a new entry
            </a>
        </li>
    </ul>
    {% endblock %}
