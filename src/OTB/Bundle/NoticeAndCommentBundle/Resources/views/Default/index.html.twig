{# src/WebmastersAfrica/PressBundle/Resources/views/Default/index.html.twig #}

{% trans_default_domain 'WebmastersAfricaAdminBundle' %}

{% extends 'WebmastersAfricaAdminBundle::adminlayout.html.twig' %}

{% block page_title %}
  {{ 'notice.page_title'|trans }}
{% endblock %}

{% block header %}
  <!-- Title area -->
  <div class="titleArea">
    <div class="wrapper">
      <div class="pageTitle">
        <h5>{{ 'notice.header_title'|trans }}</h5>
        <span>{{ 'notice.header_description'|trans }}</span>
      </div>
      <div class="clear"></div>
    </div>
  </div>
{% endblock %}

{% block body %}
  <div class="widgets">
    <div
      class="oneTwo">
      <!-- Website stats widget -->
      <div class="widget">
        <div class="title"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/stats.png') }}" alt="" class="titleIcon"/><h6>Regulation Statistics</h6>
        </div>
        <table cellpadding="0" cellspacing="0" class="sTable" width="100%">
          <thead>
            <tr>
              <td width="80">{{ 'dashboard.website_statistics.stats'|trans }}</td>
              <td>{{ 'dashboard.website_statistics.description'|trans }}</td>
            </tr>
          </thead>
          <tbody>
            {% if is_expr_granted("hasRole('MANAGE_REGULATIONS')") %}
              <tr>
                <td align="center">
                  <a href="{{ path('regulations') }}" target="_blank" title="" id="all_regulations" class="webStatsLink"><img src="{{ asset('bundles/webmastersafricaadmin/images/loaders/loader1.gif') }}" alt="" class="titleIcon" /></a>
                </td>
                <td>
                  <a href="{{ path('regulations') }}"  target="_blank" title="">All Consultations</a>
                </td>
              </tr>
              <tr>
                <td align="center">
                  <a href="{{ path('regulations') }}" target="_blank" title="" id="published_regulations" class="webStatsLink"><img src="{{ asset('bundles/webmastersafricaadmin/images/loaders/loader1.gif') }}" alt="" class="titleIcon" /></a>
                </td>
                <td>
                  <a href="{{ path('regulations') }}" target="_blank" title="">Published Consultations</a>
                </td>
              </tr>
              <tr>
                <td align="center">
                  <a href="{{ path('regulations_unpublished') }}" target="_blank" title="" id="unpublished_regulations" class="webStatsLink"><img src="{{ asset('bundles/webmastersafricaadmin/images/loaders/loader1.gif') }}" alt="" class="titleIcon" /></a>
                </td>
                <td>
                  <a href="{{ path('regulations_unpublished') }}" target="_blank" title="">Unpublished Consultations</a>
                </td>
              </tr>
              <tr>
                <td align="center">
                  <a href="{{ path('regulations_open_admin') }}" target="_blank" title="" id="open_regulations" class="webStatsLink"><img src="{{ asset('bundles/webmastersafricaadmin/images/loaders/loader1.gif') }}" alt="" class="titleIcon" /></a>
                </td>
                <td>
                  <a href="{{ path('regulations_open_admin') }}" target="_blank" title="">Ongoing Public Consultations</a>
                </td>
              </tr>
              <tr>
                <td align="center">
                  <a href="{{ path('regulations_complete_admin') }}" target="_blank" title="" id="closed_regulations" class="webStatsLink"><img src="{{ asset('bundles/webmastersafricaadmin/images/loaders/loader1.gif') }}" alt="" class="titleIcon" /></a>
                </td>
                <td>
                  <a href="{{ path('regulations_complete_admin') }}" target="_blank" title="">Completed Public Consultations</a>
                </td>
              </tr>
              <tr>
                <td align="center">
                  <a href="{{ path('regulations_completing_admin') }}" target="_blank" title="" id="seven_regulations" class="webStatsLink"><img src="{{ asset('bundles/webmastersafricaadmin/images/loaders/loader1.gif') }}" alt="" class="titleIcon" /></a>
                </td>
                <td>
                  <a href="{{ path('regulations_completing_admin') }}" target="_blank" title="">Consultations Due in {{ closing_date_value }} Days</a>
                </td>
              </tr>
              <tr>
                <td align="center">
                  <a href="{{ path('regulations_internal_admin') }}" target="_blank" title="" id="internal_consultations" class="webStatsLink"><img src="{{ asset('bundles/webmastersafricaadmin/images/loaders/loader1.gif') }}" alt="" class="titleIcon" /></a>
                </td>
                <td>
                  <a href="{{ path('regulations_internal_admin') }}" target="_blank" title="">Internal Consultations</a>
                </td>
              </tr>
              <tr>
                <td align="center">
                  <a href="#" target="_blank" title="" id="public_consultations" class="webStatsLink"><img src="{{ asset('bundles/webmastersafricaadmin/images/loaders/loader1.gif') }}" alt="" class="titleIcon" /></a>
                </td>
                <td>
                  <a href="#" target="_blank" title="">Public Consultations</a>
                </td>
              </tr>
            {% endif %}
          </tbody>
        </table>
      </div>
      <!-- My tasks table widget -->
      <div class="widget">
        <div class="title">
          <a href='#'><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/timer.png') }}" alt="" class="titleIcon"/></a>
          <a href='#'>
            <h6>Comments Stats</h6>
          </a>
          <div class="num">
            <a class="blueNum" href="#" id="number_of_comments"></a>
          </div>
        </div>
        <table cellpadding="0" cellspacing="0" class="sTable taskWidget" width="100%">
          <thead>
            <tr>
              <td>{{ 'dashboard.my_tasks.description'|trans }}</td>
              <td width="100">Number</td>
              <td width="60">{{ 'dashboard.my_tasks.acts'|trans }}</td>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="taskPr">
                <a href="{{path('regulations_with_large_number_comments')}}" title="">Consultation With Highest Comments</a>
              </td>
              <td>
                <span class="Number green f11" id="comment_number_regulation">0</span>
              </td>
              <td class="actBtns">
                <a class="tipS" href="{{ path('regulations_with_large_number_comments')}}" title="Show"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/edit.png') }}" alt=""/></a>
              </td>
            </tr>
            <tr>
              <td class="taskPr">
                <a href="{{path('comment_with_large_number_expressions')}}" title="">Comment With Highest Engagements</a>
              </td>
              <td>
                <span class="green f11" id="regulation_comment_count">0</span>
              </td>
              <td class="actBtns">
                <a class="tipS" href="{{path('comment_with_large_number_expressions')}}" title="Show"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/edit.png') }}" alt=""/></a>
              </td>
            </tr>
            <tr>
              <td class="taskPr">
                <a href="{{path('comments_abusive_comments')}}" title="">Abusive Comments</a>
              </td>
              <td>
                <span class="green f11" id="abusive_comments">0</span>
              </td>
              <td class="actBtns">
                <a class="tipS" href="{{path('comments_abusive_comments')}}" title="Show"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/edit.png') }}" alt=""/></a>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

    </div>
    <div
      class="oneTwo">

      <!-- My tasks table widget -->
      {% if is_expr_granted("hasRole('MANAGE_REGULATIONS')") %}
        <!-- New licenses widget -->
        <div class="widget">
          <div class="title">
            <a href="{{path('regulations_new') }}"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/add.png') }}" alt="New licenses" class="titleIcon"/></a>
            <a href='#'>
              <h6>New Consultations</h6>
            </a>
          </div>
          {% for license in dash_licenses %}
            <div class="wUserInfo">
              <a href="{{ path("manage_comment_list", {'id':license.id}) }}" title="{{ license.title }}" class="wUserPic"><img src="{{ asset('bundles/webmastersafricaadmin/images/user.png') }}" alt=""/></a>
              <ul class="leftList">
                <li>
                  <a href="{{ path("manage_comment_list", {'id':license.id}) }}" title="{{ license.title }}">
                    <strong>{{ license.title }}</strong>
                  </a>
                </li>
                <li>
                  <a href="{{ path("manage_comment_list", {'id':license.id}) }}" title="{{ license.description }}">{{ license.description|striptags|truncate(50, true, "...")|raw }}</a>
                </li>
              </ul>
              <ul class="rightList">
                <li>
                  <a class="green" href="#">
                    <strong>{{ license.closingDate | date('d.m.Y') }}</strong>
                  </a>
                </li>
                <li>
                  <a class="red" href="#">
                    {{ license.agency }}
                  </a>
                </li>
              </ul>
              <div class="clear"></div>
            </div>

            <div class="cLine"></div>
          {% endfor %}
        </div>
      {% endif %}
      <div class="widget">
        <div class="title">
          <a href='#'><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/timer.png') }}" alt="" class="titleIcon"/></a>
          <a href='#'>
            <h6>Consultations Count Per Agency</h6>
          </a>
          <div class="num">
            <a class="blueNum" href="#">+{{ regulations_count }}</a>
          </div>
        </div>
        <table cellpadding="0" cellspacing="0" class="sTable taskWidget" id="regulations_per_agency" width="100%">
          <thead>
            <tr>
              <td>Agency Title</td>
              <td width="60">Consultations Count</td>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>


    </div>
    <div class="clear"></div>
  </div>
{% endblock %}
{% block stylesheet_2 %}
    <script type="text/javascript" src="{{ asset('bundles/OTB/notice/js/admin_request.js') }}"></script>
{% endblock %}

