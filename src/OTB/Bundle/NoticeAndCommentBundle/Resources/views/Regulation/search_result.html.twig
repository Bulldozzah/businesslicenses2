{% trans_default_domain 'WebmastersAfricaPressBundle' %}
{# src/WebmastersAfrica/PressBundle/Resources/views/Default/index.html.twig #}
{% extends 'NoticeCommentBundle::base2.html.twig' %}

{% block page_title %}
    Notice-and-Comment | Regulations List
{% endblock %}
{% block body %}
    <main class="archive" role="main">
        <div class="jumbotronX">
            <div class="container">
                {# {{ include("NoticeCommentBundle:Regulation:regulation_search_form.html.twig", {
                  'keywords': keywords
                }) }} #}
                {# {% include "NoticeCommentBundle:Regulation:regulation_search_form.html.twig" %} #}
                {{ include ( "NoticeCommentBundle:Regulation:regulation_search_form.html.twig", {"agencies": agencies, 'industries': industries, 'keywords': keywords, 'search_agency': search_agency, 'search_industry': search_industry }) }}
            </div>
        </div>

        <div class="home_content full_width">
            <div class="container">
                <div class="row clearfix">
                    <div class="archive_main_content col-md-9 clearfix">
                        <div class="home_content_A">
                            <div class="archive_titleB">
                                <h3>Showing results  <span style="color:blue">{{all_regulations|length }} </span> of <span class="text-primary">{{count_regulation_list }}</span> for <span class="text-primary">{{ keywords }}<span></h3>
                            </div>

                            <div class="tab-content">
                                <div class="tab-pane container active" id="all">
                                {% if all_regulations|length > 0 %}
                                        {% for regulation in all_regulations %}
                                            <div class="box_1">
                                                <a href="/consultation/regulations/{{regulation.slug}}/comments">
                                                    <ul class="box_heading">
                                                        <li class="box_title">
                                                            <h3>{{ regulation.title }}</h3>
                                                        </li>
                                                        <li class="box_comments">
                                                            <h4>
                                                                <ion-icon name="chatboxes"></ion-icon>
                                                            </h4>
                                                            <p>{{regulation.comments|length }}</p>
                                                        </li>
                                                    </ul>
                                                

                                                    <div class="box_1_items row clearfix">
                                                        <div class="box_1_A col-md-1">
                                                            <figure class="box_1_image">
                                                                <img src="{{ asset('bundles/OTB/notice/img/holder.png') }}">
                                                            </figure>
                                                        </div>
                                                        <div class="box_1_B col-md-11">
                                                            <table class="box_details">
                                                                <tr>
                                                                    <th>Agency</th>
                                                                    <td>
                                                                        {{ regulation.agency.name }}
                                                                    </td>
                                                                </tr>
                                                                <tr>
                                                                    <th>Period</th>
                                                                    <td>{{ regulation.publishDate | date("M d Y", false) }}

                                                                        -
                                                                        {{ regulation.closingDate | date("M d Y", false)}}</td>
                                                                </tr>
                                                            </table>
                                                            <table class="box_details">
                                                                <tr>
                                                                    <th>Status</th>
                                                                    <td class="badge badge-danger badge-pill">{{ regulation.consultationStage }}</td>
                                                                </tr>
                                                                <tr>
                                                                    <th>Industry</th>
                                                                    {% if regulation.industry %}
                                                                        <td>{{ regulation.industry.name }}</td>

                                                                    {% endif %}
                                                                </tr>
                                                            </table>
                                                        </div>
                                                        <div class="col-md-6"></div>
                                                    </div>
                                                </a>

                                            </div>
                                        {% endfor %}
                                    {% else %}
                                        <p class="alert alert-danger">No Results Found</p>
                                        <span>
                                            <a class="btn btn-primary btn-md " href="{{ path('regulations_list') }}">Back to list</a>
                                        </span>
                                    {% endif %}
                                </div>
                                <div class="home_right pull_right pagination_B">
                                    {{ knp_pagination_render(all_regulations) }}
                                </div>
                            </div>
                        </div>
                    </div>

                    {{ include ( "NoticeCommentBundle:Regulation:side_stats.html.twig", {"closing_date_value": closing_date_value}) }}

                </div>
            </div>
        </div>
    </main>
    <script src="{{ asset('bundles/OTB/notice/js/request.js') }}"></script>


{% endblock %}
