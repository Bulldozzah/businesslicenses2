{% extends 'WebmastersAfricaAdminBundle::adminlayout.html.twig' %}
{% trans_default_domain 'WebmastersAfricaLicenseBundle' %}
{% block page_title %}
    Eregistry |
    {{ 'manage_regulations.regulations_description' | trans }}
{% endblock %}

{% block header %}
    <!-- Title area -->
    <div class="titleArea">
        <div class="wrapper">
            <div class="pageTitle">
                <h5>{{ 'manage_regulations.regulations_title' | trans }}</h5>
                <span>Internal Consultations</span>

            </div>
            <div class="clear"></div>
        </div>
    </div>


    <div class="line"></div>
{% endblock %}


{% block body %}
    {% for flashMessage in app.session.flashbag.get('update') %}
        <div class="nNote nSuccess hideit">
            <p>
                <strong>Success:
                </strong>
                {{ 'licenses.updated_item_notice' | trans }}
            </p>
        </div>
    {% endfor %}
    {% for flashMessage in app.session.flashbag.get('delete') %}
        <div class="nNote nSuccess hideit">
            <p>
                <strong>Success:
                </strong>
                {{ 'licenses.deleted_item_notice' | trans }}
            </p>
        </div>
    {% endfor %}
    {% for flashMessage in app.session.flashbag.get('publish') %}
        <div class="nNote nSuccess hideit">
            <p>
                <strong>Success:
                </strong>
                {{ flashMessage }}
            </p>
        </div>
    {% endfor %}

    <div class="widget">
        <div class="title">
            <img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/docs.png') }}" alt="" class="titleIcon"/>
            <h6>List of Internal Consultations</h6>
        </div>

        <form id="batch_form" name="batch_form" action="{{ path("batch_regulations_delete") }}" method="post">
            <table cellpadding="0" cellspacing="0" width="100%" class="w3-striped w3-bordered w3-card-4" id="regulations_table">
                <thead>
                    <tr class="w3-pale-blue">
                        <th width="40px;">
                            <div>&middot;&middot;&middot;</div>
                        </th>
                        <th width="40px;">
                            <div>#</div>
                        </th>
                        <th>
                            {{ 'manage_regulations.title' | trans }}
                        </th>
                        <th>
                            {{ 'manage_regulations.agency' | trans }}
                        </th>
                        <th>
                            {{ 'manage_regulations.closing_date' | trans }}
                        </th>
                        <th>
                            {{ 'manage_regulations.is_published' | trans }}
                        </th>
                        <th>Manage Comments</th>
                    </tr>
                </thead>
                <tbody>
                    {% for entity in entities %}
                        <tr>
                            <td>
                                <input type="checkbox" name="batch_items[]" value="{{ entity.id }}">
                            </td>
                            <td align="center">
                                <a href="{{ path('regulations_edit', { 'id': entity.id }) }}">{{ entity.id }}</a>
                            </td>
                            <td>{{ entity.title }}</td>
                            <td>{{ entity.agency }}</td>
                            <td>
                                {% if entity.closingDate %}
                                    {{ entity.closingDate|date('g:ia / l M j, Y') }}

                                {% endif %}
                            </td>
                            <td>
                                {% if entity.published == true %}
                                    <span class="smallButton"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/check.png') }}" alt="Published"></span>
                                {% else %}
                                    <span class="smallButton"><img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/close.png') }}" alt="Not Published"></span>
                                {% endif %}
                            </td>
                            <td>
                            	{% if entity.published == true %}
                                <a class="pull-left" href="{{path('manage_comment_list', { 'id': entity.id }) }}">
                                {% endif %}
                                    <span class="badge badge-primary">
                                        {{ entity.comments|length}}<i aria-hidden="true" class="fa fa-comments-o fa-2x"></i>
                                    </span>
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </form>
    </div>
{% endblock %}
{% block stylesheet_2 %}
    <script>
        $(document).ready(function () {
            $('#regulations_table').DataTable();
        });
    </script>
{% endblock %}
