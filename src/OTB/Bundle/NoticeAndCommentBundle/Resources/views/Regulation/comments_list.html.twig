{% extends 'WebmastersAfricaAdminBundle::adminlayout.html.twig' %}

{% trans_default_domain 'WebmastersAfricaLicenseBundle' %}

{% block page_title %}
    {{ site_title }},
    {{ entity.title}}
    | Manage Comments
{% endblock %}

{% block header %}
    <div class="titleArea">
        <div class="wrapper">
            {% if entity.isPublic %}
                <div class="w3-row-padding">
                    <div class="w3-third">
                    <div style="height:100px" class="w3-card w3-container w3-margin-bottom">
                        <p>Agrees</p>
                        <p>{{ entity.positionStatusAgree.count }}</p>
                    </div>
                    </div>
                    <div class="w3-third">
                    <div style="height:100px" class="w3-card-2 w3-container w3-margin-bottom">
                        <p>Agrees with reservations</p>
                        <p>{{ entity.positionStatusNeutral.count }}</p>
                    </div>
                    </div>
                    <div class="w3-third">
                    <div style="height:100px" class="w3-card-4 w3-container w3-margin-bottom">
                        <p>Diasgree</p>
                        <p>{{ entity.positionStatusDisagree.count }}</p>
                    </div>
                    </div>
                </div>
            {% endif %}
            <div class="pageTitle">
                <h5>{{ entity.title }}
                </h5>
                {% if entity.deleted == 0 %}
                    {% if entity.isPublic == 1 %}
                        <p>
                            <span>
                                <a class="w3-button w3-border w3-button-medium w3-black" target="_blank" href="{{ path('regulation_comments', {'slug': entity.slug }) }}">view on frontend</a>
                            </span>
                        </p>
                    {% endif %}
                {% endif %}
                {% if entity.deleted == 0 %}
                    <h5>Manage Comments</h5>
                {% else %}
                    <h5>
                        <a href="#" id="publish_this_regulation" title="Publish This Regulation" class="w3-button w3-green w3-hover-green w3-medium w3-border-green">
                            <span>Publish This Regulation</span>
                        </a>
                    </h5>
                {% endif %}
            </div>
            <div class="middleNav" style="border: none;">
                {% if entity.deleted == 0 %}
                    {% if entity.isPublic == 0 %}
                    <a href="{{ path('regulations_internal_admin') }}" title="back to list" class="wButton redwB ml15 m10">
                        <span> BACK TO REGULATIONS</span>
                    </a>
                    {% else %}
                    <a href="{{ path('regulations') }}" title="back to list" class="wButton redwB ml15 m10">
                        <span>BACK TO REGULATIONS</span>
                    </a>
                    {% endif %}
                {% else %}
                    <a href="{{ path('regulations_unpublished') }}" title="back to list" class="wButton redwB ml15 m10">
                        <span>BACK TO REGULATIONS</span>
                    </a>
                {% endif %}
                <div class="clear"></div>
            </div>
            <div class="clear"></div>
        </p>
    </div>
{% endblock %}
{% block body %}
    <span id="publish_this_regulation_error"></span>
    {% for flashMessage in app.session.flashbag.get('create') %}
        <div class="nNote nSuccess hideit">
            <p>
                <strong>Success:
                </strong>
                {{ 'licenses.updated_item_notice' | trans }}
            </p>
        </div>
    {% endfor %}
    {% for flashMessage in app.session.flashbag.get('update') %}
        <div class="nNote nSuccess hideit">
            <p>
                <strong>Success:
                </strong>
                {{ 'licenses.updated_item_notice' | trans }}
            </p>
        </div>
    {% endfor %}
    {% for flashMessage in app.session.flashbag.get('delete') %}
        <div class="nNote nSuccess hideit">
            <p>
                <strong>Success:
                </strong>
                {{ 'licenses.deleted_item_notice' | trans }}
            </p>
        </div>
    {% endfor %}   
    {% for flashMessage in app.session.flashbag.get('delete') %}
        <div class="nNote nSuccess hideit">
            <p>
                <strong>Success:
                </strong>
                {{ 'licenses.deleted_item_notice' | trans }}
            </p>
        </div>
    {% endfor %}
    {% for flashMessage in app.session.flashbag.get('comment_upvote') %}
        <div class="nNote nSuccess hideit">
            <p>
                <strong>Success:
                </strong>
                {{ flashMessage }}
            </p>
        </div>
    {% endfor %}

    {% if entity.deleted == 0 %}
        <a href="#" class="w3-button w3-border w3-border-blue" onclick="document.getElementById('regulation_reply').style.display='block'">
            Make Comments on this Consultation. <i class="fa fa-comment"></i>
        </a>
    {% endif %}

    <a href="{{ path('manage_comment_list', {'id': entity.id }) }}" class="w3-button w3-black w3-hover-black w3-border w3-border-black">
        Comments List <span class="w3-badge">{{ entity.commentsCount|length }}</span>
    </a>

    {% if entity.commentPendingReview|length > 0 %}
        <a href="{{ path('pending_review_comment_regulation', {'regulation_id': entity.id }) }}" class="w3-button w3-hover-red w3-border w3-border-red">
            Comments Pending Review <span class="w3-badge">{{ entity.commentPendingReview|length }}</span>
        </a>
    {% endif %}

    {% if entity.abusiveComments|length > 0 %}
        <a href="{{ path('comments_reported_abusive_manage', {'regulation_id': entity.id }) }}" class="w3-button w3-hover-green w3-border w3-border-green">
            Reported Abusive <span class="w3-badge">{{ entity.abusiveComments|length }}</span>
        </a>
    {% endif %}

    {% if entity.UnpublishedComments|length > 0 %}
	    <a href="{{ path('un_published_comment_regulation', {'regulation_id': entity.id }) }}" class="w3-button w3-hover-blue w3-border w3-border-blue">
	        Unpublished Comments <span class="w3-badge">{{ entity.unpublishedComments|length }}</span>
	    </a>
    {% endif %}
    {% if entity.userDeletedComment|length > 0 %}
        <a href="{{ path('user_deleted_comments_list', {'regulation_id': entity.id }) }}" class="w3-button w3-hover-red w3-border w3-border-red">
            User Deleted Comments <span class="w3-badge">{{ entity.userDeletedComment|length }}</span>
        </a>
    {% endif %}
    <div class="w3-container">
        <div id="regulation_reply" class="w3-modal">
            <div class="w3-modal-content w3-card-4 w3-animate-zoom" style="max-width:600px">
                <div class="w3-center"><br>
                    Your Reply Message
                    <form class="w3-container" id="reply_form" action="{{path('regulation_comments_reply', {'regulation_id': entity.id }) }}" method="POST">
                        <div class="w3-section">
                            <textarea class="w3-input w3-border w3-margin-bottom" id="reply_message" placeholder="Enter your reply message" name="reply"></textarea>
                            <p id="error_message"></p>
                        </div>
                        <input type="hidden" value="{{entity.id}}" id="regulation_id" name="regulation">
                        <input type="hidden" value="{{entity.id}}" id="comment_id" name="comment_id">
                        <button class="w3-button w3-block w3-green w3-section w3-padding" type="submit" id="reply_button_action">Reply</button>
                    </form>

                    <div class="w3-container w3-border-top w3-padding-16 w3-light-grey">
                        <button onclick="document.getElementById('regulation_reply').style.display='none'" type="button" class="w3-button w3-red">Cancel</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="widget">
            <div class="title">
                <img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/frames.png') }}" alt="" class="titleIcon"/>
                <h6>List of Regulation Comments</h6>
            </div>
            <form id="batch_form" name="batch_form" action="{{ path("batch_comments") }}" method="post">
                <table cellpadding="0" cellspacing="0" width="100%" class="sTable w3-table-all w3-card-4" id="nc_abusive_comment_table">
                    <thead>
                        <tr class="w3-pale-blue">
                            <td>
                                Comment Title
                            </td>
                            <td>Attachment</td>
                            <td>Replies</td>
                            <td>created at</td>
                            <td>
                                Actions
                            </td>
                        </tr>
                    </thead>
                    <tbody>
                        {% for comment in comments %}
                            {% if (comment.parent is empty) and (comment.publish == 1) and (comment.hidden == 0) and (comment.deleted == 0 ) %}

                                <tr class="w3-hover-blue">
                                    <td>
                                        {% if comment.comment %}
                                            {{ comment.comment }}
                                        {% else %}
                                            {% if comment.document %}
                                            <a href="{{ asset('uploads/documents/' ~ comment.document)}}" target="_blank">
                                                Document Attached
                                            </a>
                                        {% endif %}
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if comment.document %}
                                            <a href="{{ asset('uploads/documents/' ~ comment.document)}}" target="_blank">
                                                <i class="fa fa-paperclip fa-2x" aria-hidden="true"></i>
                                            </a>
                                        {% endif %}
                                    </td>
                                    <td class="w3-center">
                                        <a class="w3-badge color: blue" href="{{ path('comments_show', {'id': comment.id}) }}">{{ comment.childrenRight|length }}</a>
                                    </td>
                                    <td>{{ comment.createAt|date("Y/m/d H:i:s") }}</td>
                                    <td>
                                        <span>
                                            {% if is_expr_granted("hasRole('MODERATE_COMMENTS')") %}
                                                <span>
                                                    <a href="#" class="w3-button w3-white w3-border w3-border-blue" onclick="document.getElementById('id0{{comment.id}}').style.display='block'">
                                                        Reply
                                                    </a>
                                                </span>
                                                <span>
                                                	{% if comment.hidden == 1 %}

                                                    <a href="{{path('managecomments_publish_main',{'id':comment.id, 'regulation_id': entity.id})}}" class="w3-button w3-white w3-border w3-border-green" onclick="return confirm('Are you sure you want to Unpublish this comment')">
                                                        publish
                                                    </a>
                                                  {% endif %}

                                                  {% if comment.hidden == 0 %}

                                                    <a href="{{path('managecomments_unpublish',{'id':comment.id, 'regulation_id': entity.id})}}" class="w3-button w3-white w3-border w3-border-green" onclick="return confirm('Are you sure you want to Unpublish this comment')">
                                                        Unpublish
                                                    </a>
                                                  {% endif %}
                                                </span>
                                            {% endif %}
                                            {% if is_expr_granted("hasRole('DELETE_COMMENT')") %}
                                            	 <span>
                                                    <a href="{{path('managecomments_2_delete',{'id':comment.id, 'entity': entity.id})}}" class="w3-button w3-white w3-border w3-border-red" onclick="return confirm('Are you sure you want to delete this comment')">
                                                        Delete
                                                    </a>
                                                </span>
                                            {% endif %}
                                            {% if is_expr_granted("hasRole('MODERATE_COMMENTS')") %}
                                            	<span>
                                            		<a title="Upvote this comment" href="{{path('managecomments_upvote_comments',{'comment_id': comment.id})}}" class="w3-button w3-white w3-border w3-border-blue" onclick="return confirm('Are you sure you want to Upvote this comment')">
                                                  <i class="fa fa-thumbs-o-up" aria-hidden="true"></i>
                                                </a>
                                            	</span>
                                            {% endif %}
                                            {% if is_expr_granted("hasRole('MODERATE_COMMENTS')") %}
                                            	<a title ="Downvote this comment" href="{{path('managecomments_downvote_comments',{'comment_id' : comment.id})}}" class="w3-button w3-white w3-border w3-border-red" onclick="return confirm('Are you sure you want to downvote this comment')">
                                                  <i class="fa fa-thumbs-o-down" aria-hidden="true"></i>
                                                </a>
                                            	</span>
                                            {% endif %}
                                            <div class="w3-container">
                                                <div id="id0{{comment.id}}" class="w3-modal">
                                                    <div class="w3-modal-content w3-card-4 w3-animate-zoom" style="max-width:600px">
                                                        <div class="w3-center"><br>
                                                            Your Reply Message
                                                            {{ comment.id }}
                                                        </div>
                                                        <form class="w3-container" id="reply_form" action="{{path('comments_reply', {'comment_id': comment.id }) }}" method="POST">
                                                            <div class="w3-section">
                                                                <label>
                                                                    <b>Your Message</b>
                                                                </label>
                                                                <textarea class="w3-input w3-border w3-margin-bottom" id="reply_message" placeholder="Enter your reply message" name="reply"></textarea>
                                                            </div>
                                                            <input type="hidden" value="{{entity.id}}" id="regulation_id" name="regulation">
                                                            <input type="hidden" value="{{comment.id}}" id="comment_id" name="comment_id">
                                                            <button class="w3-button w3-block w3-green w3-section w3-padding" type="submit" id="reply_button_action">Reply</button>
                                                        </form>

                                                        <div class="w3-container w3-border-top w3-padding-16 w3-light-grey">
                                                            <button onclick="document.getElementById('id0{{comment.id}}').style.display='none'" type="button" class="w3-button w3-red">Cancel</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </span>
                                    </td>
                                </tr>
                            {% endif %}
                        {% endfor %}
                    </tbody>
                </table>
            </form>
        </div>
    {% endblock %}
    {% block stylesheet_2 %}
        <script>
            $(document).ready(function () {
                document.getElementById("reply_message").value = "";
                $('#nc_abusive_comment_table').DataTable( {
                    "ordering": false
                } );
                $('#reply_button_action').click(function (e) {
                    e.preventDefault();
                    $("textarea#reply_message").val($("#reply_message").val());
                    if ($("#reply_message").val()) {
                        $("#reply_form").submit();
                    } else {
                        $("#error_message").html(`<span style="color: red;">Message Missing</span>`)
                    }
                });

                $("#publish_this_regulation").click(function() {
                    $.ajax({
                      type: "post",
                      url: `/login-admin/manageregulations/publish/{{ entity.id }}/regulation`,
                      data: {'regulation_id': '{{ entity.id }}'},
                      cache: false,
                      contentType: false,
                      processData: false,
                      success: function (response) {
                        let serverResponse = JSON.parse(response);
                        if (serverResponse.success) {
                            console.log(serverResponse.success);
                            $("#publish_this_regulation_error").html(`
                                <div class="nNote nSuccess hideit">
                                <p>
                                    <strong>Success:
                                    </strong>
                                    ${serverResponse.message}
                                </p>
                            `);
                        } else {
                            $("#publish_this_regulation_error").html(`
                                <div class="nNote nFailure hideit">
                                <p>
                                    <strong>Error:
                                    </strong>
                                    ${serverResponse.message}
                                </p>
                            `);
                        }

                        location.reload();
                      }
                    });
                });
            });
        </script>
    {% endblock %}
