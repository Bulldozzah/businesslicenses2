            }, **/
            refresh: function () {
                $('#comments-container').addClass('rendered');
            }
        });

        // Hide this
        if (!reply) {
            $(".commenting-field").hide();
        } else {
          if (response.required_to_login && response.required_to_login != response.user_logged_in) {
              $(".commenting-field").html(`<p style="color:red;">
                Unfortunately! You can't make your comments anonymously. Login to Make your comments. Your Comments are highly valuable</p>`
              );
          }
        }
          
        
    });
</script>

<script>
    $(document).ready(function () {
        $('.collapse').on('shown.collapse', function(){
            $(this).parent().find(".arrow-dropdown").removeClass("arrow-drodown").addClass("arrow-dropup");
        }).on('hidden.collapse', function(){
            $(this).parent().find(".arrow-dropup").removeClass("arrow-dropup").addClass("arrow-dropdown");
        });
    });
</script>
<style type="text/css">
.hidden {
  color: red;
  border: solid;
}
</style>
{% endblock %}
