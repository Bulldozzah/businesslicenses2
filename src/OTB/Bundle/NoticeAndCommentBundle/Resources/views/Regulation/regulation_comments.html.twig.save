              </div>
            </div>
          </div>
      </div>
    </div>
  </div>

  <div class="home_content full_width">

    <div class="regulation_container_B container">
      <div class="row clearfix">

        <div class="side_content_C col-md-7 clearfix" data-spy="" data-offset-top="">
          <div class="regulation_accordion">
            <div id="accordion">
              {% if ('2' in showedfields) %}
                <div class="card">
                  <div class="card-header" id="headingOne">
                    <h5 class="mb-0">
                      <button class="btn btn-link btn-block" data-toggle="collapse" data-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                        Summary <ion-icon name="arrow-dropdown"></ion-icon>
                      </button>
                    </h5>
                  </div>
                  <div id="collapseOne" class="collapse show" aria-labelledby="headingOne" data-parent="#accordion">
                    <div class="card-body">
                      <h5>{{ regulation.title }}</h5>
                      <div class="accordion_description">{{ regulation.description|raw }}</div>
                    </div>
                  </div>
                </div>
              {% endif %}
              {% if ('8' in showedfields) or ('11' in showedfields) or ('12' in showedfields) %}
                <div class="card">
                  <div class="card-header" id="headingTwo">
                    <h5 class="mb-0">
                      <button class="btn btn-link btn-block collapsed" data-toggle="collapse" data-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                        Documents &amp; Supporting Materials <ion-icon name="arrow-dropdown"></ion-icon>
                      </button>
                    </h5>
                  </div>
                  <div id="collapseTwo" class="collapse" aria-labelledby="headingTwo" data-parent="#accordion">
                    <div class="card-body">
                      {% if ('11' in showedfields) %}
                        {% if regulation.document %}
                          <a href="{{ asset('uploads/documents/' ~ regulation.document)}}" target="_blank">
                            <h6><ion-icon name="document"></ion-icon> {{ regulation.document }}</h6>
                          </a>
                        {% endif %}
                      {% endif %}
                      
                      {% if ('12' in showedfields) %}
                        <div>
                          {% if regulation.supportingAttachments %}
                            {% for attachment in regulation.supportingAttachments %}
                              {% if attachment.filepath %}
                                <h6><a target="_blank" href="{{ asset('uploads/documents/' ~ attachment.filepath) }}"><ion-icon name="document"></ion-icon> {{ attachment.name }}</a></h6>
                              {% endif %}
                            {% endfor %}
                          {% endif %}
                        </div>
                      {% endif %}
                      {% if ('8' in showedfields) %}
                        <div>
                          {% if regulation.supportingMaterials %}
                            <p>{{ regulation.supportingMaterials|raw }}</p>
                          {% endif %}
                        </div>
                      {% endif %}
                    </div>
                  </div>
                </div>
              {% endif %}

              {% if ('4' in showedfields) %}
              <div class="card">
                  <div class="card-header" id="headingThree">
                    <h5 class="mb-0">
                      <button class="btn btn-link btn-block collapsed" data-toggle="collapse" data-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                        Affected Sector(s) And Expected Impact <ion-icon name="arrow-dropdown"></ion-icon>
                      </button>
                    </h5>
                  </div>
                  <div id="collapseThree" class="collapse" aria-labelledby="headingThree" data-parent="#accordion">
                    <div class="card-body">
                      {{ regulation.industry }}
                    </div>
                  </div>
                </div>
            {% endif %}
            {% if ('7' in showedfields) %}
              <div class="card">
                <div class="card-header" id="heading4">
                  <h5 class="mb-0">
                    <button class="btn btn-link btn-block collapsed" data-toggle="collapse" data-target="#collapse4" aria-expanded="false" aria-controls="collapse4">
                      Specific Instructions <ion-icon name="arrow-dropdown"></ion-icon>
                    </button>
                  </h5>
                </div>
                <div id="collapse4" class="collapse" aria-labelledby="heading4" data-parent="#accordion">
                  <div class="card-body">
                    {{regulation.specificInstructions|raw }}
                  </div>
                </div>
              </div>
            {% endif %}
            {% if fielddatas|length > 0 %}
                <div class="card">
                  <div class="card-header" id="headingCustom">
                    <h5 class="mb-0">
                      <button class="btn btn-link btn-block collapsed" data-toggle="collapse" data-target="#collapseCustom" aria-expanded="false" aria-controls="collapseCustom">
                        Additional Details <ion-icon name="arrow-dropdown"></ion-icon>
                      </button>
                    </h5>
                  </div>
                  <div id="collapseCustom" class="collapse" aria-labelledby="headingCustom" data-parent="#accordion">
                    <div class="card-body">
                      <ul>
                      {% for field in regulationfields %}
                        <li>
                          <p>{{ field.fieldlabel|raw }}</p>
                          {% for datafield in fielddatas %}
                            {% if datafield.fieldId == field.id %}
                              <span>{{ datafield.fielddata|raw }}</span>
                            {% endif %}
                          {% endfor %}
                        </li>
                      {% endfor %}
                      </ul>
                    </div>
                  </div>
                </div>
            {% endif %}
            {% if ('14' in showedfields) %}
              <div class="card">
                <div class="card-header" id="heading6">
                  <h5 class="mb-0">
                    <button class="btn btn-link btn-block collapsed" data-toggle="collapse" data-target="#collapse6" aria-expanded="false" aria-controls="collapse6">
                      Offline Consultations <ion-icon name="arrow-dropdown"></ion-icon>
                    </button>
                  </h5>
                </div>
                <div id="collapse6" class="collapse" aria-labelledby="heading6" data-parent="#accordion">
                  <div class="card-body">
                    {{ regulation.offlineConsultations|raw }}
                  </div>
                </div>
              </div>
            {% endif %}
              <div class="card">
                <div class="card-header" id="heading7">
                  <h5 class="mb-0">
                    <button class="btn btn-link btn-block collapsed" data-toggle="collapse" data-target="#collapse7" aria-expanded="false" aria-controls="collapse7">
                      Department Point of Contact <ion-icon name="arrow-dropdown"></ion-icon>
                    </button>
                  </h5>
                </div>
                <div id="collapse7" class="collapse" aria-labelledby="heading7" data-parent="#accordion">
                  <div class="card-body">
                    <ul class="contact_items">
                      <li>
                        Name:
                        {{ regulation.agency.title}}</li>
                      <li>
                        {{ regulation.agency.name}}</li>
                      <li>Fax:
                        {{ regulation.agency.fax}}</li>
                      <li>Address:
                        {{ regulation.agency.address}}</li>
                      <li>Telephone:
                        <a href="tel:{{ regulation.agency.telephone }}">{{ regulation.agency.telephone }}</a></li>
                      <li>Email:
                        <a href="mailto:{{ regulation.agency.email }}" target="_blank">{{ regulation.agency.email }}</a></li>
                      <li>Website:
                        <a href="{{ regulation.agency.website}}" target="_blank">{{ regulation.agency.website}}</a></li>
                      <li>Working Hours:
                        {{ regulation.agency.hours}}</li>
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>

        <div class="archive_main_content col-md-5 clearfix">
          {% if open_for_comments %}
            <figure class="noti_feedback">
              <button class="btn btn-secondary btn-block" data-toggle="modal" data-target="#exampleModal" >
                  <i class="fas fa-question-circle"></i> Do you agree with this regulation?
              </button>
            </figure>
          {% endif %}


            <div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
                <div class="modal-dialog" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="exampleModalLabel">State Your Position?</h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <form id="stating_my_position">
                          <div id="position_stating_area">
                          <div class="modal-body">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" class="positionButtons" name="positionRadios" id="exampleRadios1" value="option1" required>
                                <label class="form-check-label" for="exampleRadios1">
                                    Agree
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" class="positionButtons" name="positionRadios" id="exampleRadios2" value="option2">
                                <label class="form-check-label" for="exampleRadios2">
                                    Agree with reservations
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" class="positionButtons" name="positionRadios" id="exampleRadios2" value="option3">
                                <label class="form-check-label" for="exampleRadios2">
                                    disagree
                                </label>
                            </div>
                          </div>
                        </div>
                          <div class="modal-footer">
                              <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                              <button type="button" id ="submit_my_position_button" class="btn btn-primary" data-dismiss="modal">Submit my Response</button>
                          </div>
                        </form>
                    </div>
            </div>
          </div>

          <div class="home_content_A">
            <div class="header_A">
              <h2 class="style_A">Comments</h2>
              <p class="policy">You can submit your comment as a guest user or sign up to give your comment. Signing up allows you to like comments and make attachments along with your comment.  <a href="/policy/comment-policy" target="_blank">Read our Comment Policy here</a>.</p>
              <div id="comment_area"></div>
              {% if open_for_comments == false %}
                <div class="comment-alert alert alert-warning alert-dismissible">
                  <button type="button" class="close" data-dismiss="alert">&times;</button>
                  <!--<strong>Warning!</strong>-->
                  This Regulation is no longer available for commenting
                </div>
              {% endif %}

              <span id="error_message"></span>
            </div>
            <div class="global_content_A_in home_content_A_in">
              <div class="single_box_main box_1">
                <div class="comment_in_B">
                  <div class="comment-error-section"></div>
                  <section id="comments">
                    <div class="container">
                      <div class="mx-auto">
                        <div id="comments-container"></div>
                      </div>
                    </div>
                  </section>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
{% endblock %}

{% block comments %}
<script>
$('#submit_my_position_button').click(function () {
    var ckbox = $("input[name='positionRadios']");
    var chkId = '';
    if (ckbox.is(':checked')) {
      $("input[name='positionRadios']:checked").each ( function() {
        chkId = $(this).val();
        $.ajax({
            url: `/consultation/regulations/{{ regulation.slug }}/votting/position`,
            type: 'POST',
            dataType: 'json',
            data: {
              'position': chkId,
            },
            success: function (data) {
              $("#position_stating_area").html(`<p class='alert alert-success'>${data.message}</p>`);
              $("#submit_my_position_button").disabled = true;
            }  
        }); 
      });
    }
    return false;
});
</script>
<script src="https://unpkg.com/micromodal/dist/micromodal.min.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        if (typeof window.orientation == 'undefined') {
            $("#share_whatsapp").html('<div class="share_whatsapp">\
                  <a href="https://web.whatsapp.com/send?text=https://eregistry.otbafrica.com/consultation/regulations/{{ regulation.slug }}/comments" target="_blank">\
                    <ion-icon aria-label="copy" class="hydrated" name="logo-whatsapp" role="img"></ion-icon>\
                  </a>\
          </div>');
        }

        $(".marked-abusive").addClass("text-success");
        $("#subscribe_button_area").click(function (e) {
          e.stopPropagation();
          let loading = `<a href="#" class="disabled" title="Thank you for subscribing"><img src="{{ asset('bundles/webmastersafricaadmin/images/loaders/loader.gif') }}" alt="" class="titleIcon" /></a>`;
          $("#subscribe_button_area").html(loading);
          let url = "{{ path('agency_subscribe_for_regulations') }}";
          let agency = "{{ regulation.agency.id }}";
          let regulation = "{{ regulation.id }}";
          $.ajax({
            type: "post",
            url: url,
            data: {"agency": agency, 'regulation': regulation},
            success: function(response) {
              let response_obj = JSON.parse(response);
              if (response_obj.success) {
                console.log(response_obj.success);
                let success = '';
                if (response_obj.sub) {
                  $("#subscribe_agency_button_area").html('');
                  success = `<a class="dropdown-item text-dark" id="subscribe_button_area" href="#">To Agency &nbsp;&nbsp;&nbsp <i class="fa fa-check" aria-hidden="true"></i></a>`;
                  $("#subscribe_agency_button_area").html(success);
                } else {
                  $("#subscribe_agency_button_area").html('');
                  success = `<a class="dropdown-item text-dark" id="subscribe_button_area" href="#">To Agency</a>`;
                  $("#subscribe_agency_button_area").html(success);
                }
                
              } else {
                $("#subscribe_button_area").html(response_obj.message);
              }
            }
          });
        });
        $("#subscribe_button_area_industry").click(function (e) {
          e.stopPropagation();
          let loading = `<a href="#" class="disabled"><img src="{{ asset('bundles/webmastersafricaadmin/images/loaders/loader.gif') }}" alt="" class="titleIcon" /></a>`;
          $("#subscribe_button_area_industry").html(loading);
          let url = "{{ path('industry_subscribe_for_regulations') }}";
          let industry = "{{ regulation.industry.id }}";
          let regulation = "{{ regulation.id }}";
          $.ajax({
            type: "post",
            url: url,
            data: {"industry": industry, 'regulation': regulation},
            success: function(response) {
              let response_obj = JSON.parse(response);
              if (response_obj.success) {
                console.log(response_obj.success);
                let success = '';
                if (response_obj.sub) {
                  $("#subscribe_industry_button_area").html('');
                  success = `<a class="dropdown-item text-dark" id="subscribe_button_area" href="#">To Industry&nbsp;&nbsp;&nbsp<i class="fa fa-check" aria-hidden="true"></i></a>`;
                  $("#subscribe_industry_button_area").html(success);
                } else {
                  $("#subscribe_industry_button_area").html('');
                  success = `<a class="dropdown-item text-dark" id="subscribe_button_area" href="#">To Industry</a>`;
                  $("#subscribe_industry_button_area").html(success);
                }
                
              } else {
                $("#subscribe_button_area_industry").html(response_obj.message);
              }
            }
          });
        });
    });
    let replying = $.getJSON(`/consultation/regulations/api/{{ regulation.id }}/comments/enabled`);
    replying.done(function (response) {
        let reply = response.open;
        let login_required = response.login_required

        var saveComment = function (data) { // Convert pings to human readable format
            $(Object.keys(data.pings)).each(function (index, userId) {
                var fullname = data.pings[userId];
                var pingText = '@' + fullname;
                data.content = data.content.replace(new RegExp('@' + userId, 'g'), pingText);
            });
            return data;
        }
      function doOnlineCheck() {
          //if the server can be reached it returns 1, other wise it times out
          var submitURL = ""  + "{{ path('check_is_online') }}"  + "";

          $.ajax({
              url : submitURL,
              type : "post",
              dataType : "msg",
              timeout : 5000,
              success : function(msg) {
                  msg = JSON.parse(msg).success;
                  if(msg) {
                      $("#online").addClass("online");
                      $("#online").removeClass("offline");
                  } else {
                      $("#online").addClass("offline");
                      $("#online").removeClass("online");
                  }
                  checkOnline();
              },
              error : function() {
                  $("#online").addClass("offline");
                  $("#online").removeClass("online");
                  checkOnline();
              }
          });
      }
        $('#comments-container').comments({

            profilePictureURL: 'https://viima-app.s3.amazonaws.com/media/public/defaults/user-icon.png',
            currentUserId: 1,
            roundProfilePictures: true,
            textareaRows: 1,
            enableAttachments: response.enable_attachment,
            enableHashtags: true,
            enablePinging: true,
            textareaPlaceholderText: 'Leave a comment..',
            editText: 'Edit',
            enableUpvoting: response.open,
            enableDeleting: response.user_logged_in,
            enableDeletingCommentWithReplies: false,
            enableEditing: response.user_logged_in,
            enableHashtags: false,
            postCommentOnEnter: response.review_comments,
            enableShare: reply,
            maxRepliesVisible: 1,
            enableMarkAbusive: reply,
            enableReplying: reply,
            enableNavigation: true,
            searchUsers: function (term, success, error) {
                setTimeout(function () {
                    success(usersArray.filter(function (user) {
                        var containsSearchTerm = user.fullname.toLowerCase().indexOf(term.toLowerCase()) != -1;
                        var isNotSelf = user.id != 1;
                        return containsSearchTerm && isNotSelf;
                    }));
                }, 500);
            },
            getComments: function (success, error) {
              // if (doOnlineCheck()) {
                $.ajax({
                    type: 'get',
                    url: `/consultation/regulations/api/{{ regulation.slug }}/comments`,
                    success: function (commentList) {
                        let commentsArray = JSON.parse(atob(commentList));
                        success(commentsArray.comments);
                    },
                    error: error
                });
                //}

            },
            postComment: function (commentPost, success, error) {
              // if (doOnlineCheck()) {
                var formData = new FormData();
                let can_post = true;
                  if ('file' in commentPost) {
                    i = response.file_size * 1024 * 1024;
                    if (commentPost.file.size > i) {
                        can_post = false;
                        $(".comment-error-section").html(`<p style="color: red;">You're required to upload a maxium of ${response.file_size} MB size </p>`);
                    } else {
                      can_post = true;
                      //$(".comment-error-section").html(`<p style="color: red;">You're required to upload a ${response.file_type['file_type']} </p>`);
                    }
                  }
                  console.log(can_post);
                  if (can_post) {
                    $(Object.keys(commentPost)).each(function (index, key) {
                      var value = commentPost[key];
                      if (value) {
                        formData.append(key, value)
                      }
                    });
                    $.ajax({
                      type: "post",
                      url: `/consultation/regulations/api/{{ regulation.id }}/comments`,
                      data: formData,
                      cache: false,
                      contentType: false,
                      processData: false,
                      success: function (comment) {
                          let this_comment = JSON.parse(comment)
                          if (this_comment.success) {
                            success(this_comment.comment);
                          } else {
                            $(".comment-error-section").html(`<p style="color: red;">${this_comment.message}</p>`);
                          }
                      },
                      error: error
                    });
                  }

              //}
