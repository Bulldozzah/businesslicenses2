{% trans_default_domain 'WebmastersAfricaPressBundle' %}
{# src/WebmastersAfrica/PressBundle/Resources/views/Default/index.html.twig #}
{% extends 'NoticeCommentBundle::base2.html.twig' %}
{% block sitekeywords %}
  {{ regulation.keywords }}
{% endblock %}
{% block sitetitle %}
  {{ regulation.title }}
  comments
{% endblock %}
{% block sitedescription %}
  {{ regulation.title }}
{% endblock %}

{% block page_title %}
  Notice-and-Comment |
  {{ regulation.title }}
{% endblock %}

{% block body %}
  <main class="single" role="main">
    <div class="jumbotronZ clearfix">
      <div class="regulation_container_B container text-left">
        <div class="row clearfix">
          <div class="col-md-9">
            {% set currentPath = path(app.request.attributes.get('_route'),
              app.request.attributes.get('_route_params')) %}
            <div class="jumboZ_in_1 jumboZ_in">
              <h1 class="display-3">{{regulation.title}}</h1>
              <ul class="share_icons_A">
                <li class="s_title">SHARE:
                </li>
                <li class="s_fb">
                   <div class="fb-share-button" data-href="https://eregistry.otbafrica.com{{ currentPath }}" data-layout="button_count" data-size="large">
                      <a target="_blank" href="https://www.facebook.com/sharer/sharer.php?u=https://eregistry.otbafrica.com{{ currentPath }}" class="fb-xfbml-parse-ignore">Share</a>
                    </div>
                </li>
                <li class="s_tw">
                  <a href="https://twitter.com/intent/tweet?text=https://eregistry.otbafrica.com{{ currentPath }}" data-size="large">
                    <ion-icon aria-label="logo twitter" class="hydrated" name="logo-twitter" role="img"></ion-icon>
                  </a>
                </li>
                <li class="s_tw">
                </li>
                <li class="s_mail">
                  {% set regulation_body = regulation.description|raw %}
                  <a href="mailto:?Subject={{ regulation.title }} Comments &amp;Body={{ regulation_body }}" target="_blank">
                    <ion-icon aria-label="mail" class="hydrated" name="mail" role="img"></ion-icon>
                  </a>
                </li>
                <li class="s_copy">
                  <div class="share_whatsapp">
                    <a href="https://web.whatsapp.com/send?text=https://eregistry.otbafrica.com{{ currentPath }}" target="_blank">
                      <ion-icon aria-label="copy" class="hydrated" name="logo-whatsapp" role="img"></ion-icon>
                    </a>
                  </div>
                </li>
                <li class="s_tw">
                  <div class="share_whatsapp">
                    <a href="{{ path('print_regulation_details', {'slug': regulation.slug }) }}" target="_blank">
                      <ion-icon aria-label="copy" class="hydrated" name="print" role="img"></ion-icon>
                    </a>
                  </div>
                </li>
              </ul>
              <figure class="button_subscription">
                {% if subscribed_button %}
                  <div class="dropdown">
                    <button class="btn btn-success btn-sm dropdown-toggle" type="button" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                      Subscribe/Unsubscribe
                    </button>
                    <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                      <span id="subscribe_agency_button_area">
                          <a class="dropdown-item text-dark" id="subscribe_button_area" href="#">Agency &nbsp;&nbsp;&nbsp;{% if subscribed_agency %}<i class="fa fa-check" aria-hidden="true"></i>{% endif %}
                          </a>
                      </span>
                      <span id="subscribe_industry_button_area">
                        <a class="dropdown-item text-dark" id="subscribe_button_area_industry" href="#">Industry &nbsp;&nbsp;&nbsp;{% if subscribed_industry %}<i class="fa fa-check" aria-hidden="true"></i>{% endif %}</a>
                      </span>
                    </div>
                  </div>
                {% else %}
                  <div class="dropdown">
                    <button class="btn btn-success btn-sm dropdown-toggle" type="button" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                      Subscribe/Unsubscribe
                    </button>
                    <div class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                      <a class="dropdown-item text-dark" href="/login">Agency</a>
                      <a class="dropdown-item text-dark" href="/login">Industry</a>
                    </div>
                  </div>
                {% endif %}
<<<<<<< HEAD
