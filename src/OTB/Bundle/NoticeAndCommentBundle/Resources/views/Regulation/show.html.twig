{% extends 'WebmastersAfricaAdminBundle::adminlayout.html.twig' %}

{% trans_default_domain 'WebmastersAfricaLicenseBundle' %}

{% block page_title %}
    {{ site_title }},
    {{ entity.comment}}
    | Manage Comments
{% endblock %}

{% block header %}
    <div class="titleArea">
        <div class="wrapper">
            <div class="pageTitle">
                <h1>Regulation: {{ entity.regulation.title }}</h1>
                <h5>Comment: {{ entity.comment }}</h5>
                <h6>Manage Comments</h6>
                {% if is_expr_granted("hasRole('MODERATE_COMMENTS')") %}
                    {% if user %}
                        <span class="fa fa-user fa-2x">
                            {{ user.firstName }}
                            {{ user.lastName}}
                        </span>
                    {% endif %}
                    <i class="fa fa-heart-o fa-2x" aria-hidden="true">.
                        {{ entity.likes|length }}</i>
                    <a href="#" class="w3-button w3-white w3-border w3-border-blue" onclick="document.getElementById('id1').style.display='block'">
                        Reply
                    </a>
                    <div class="w3-container">
                        <div id="id1" class="w3-modal">
                            <div class="w3-modal-content w3-card-4 w3-animate-zoom" style="max-width:600px">
                                <div class="w3-center"><br>
                                    Your Reply Message
                                </div>
                                <form class="w3-container" id="reply_form" action="{{path('comments_reply', {'comment_id': entity.id }) }}" method="POST">
                                    <div class="w3-section">
                                        <span id="error_message"></span>
                                        <textarea class="w3-input w3-border w3-margin-bottom" id="reply_message" placeholder="Enter your reply message" name="reply"></textarea>
                                    </div>
                                    <input type="hidden" value="{{entity.regulation.id}}" id="regulation_id" name="regulation">
                                    <input type="hidden" value="{{entity.id}}" id="comment_id" name="comment_id">
                                    <button class="w3-button w3-block w3-green w3-section w3-padding" type="submit" id="reply_button_action">Reply</button>
                                </form>

                                <div class="w3-container w3-border-top w3-padding-16 w3-light-grey">
                                    <button onclick="document.getElementById('id1').style.display='none'" type="button" class="w3-button w3-red">Cancel</button>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}

            </div>
            <div class="middleNav" style="border: none;">
                <a href="{{ path('manage_comment_list', {'id': entity.regulation.id }) }}" title="back to list" class="wButton redwB ml15 m10">
                    <span>BACK TO COMMENT LIST</span>
                </a>
                <div class="clear"></div>
            </div>
           <div class="clear"></div>
        </p>
    </div>
{% endblock %}

{% block body %}
    {% for flashMessage in app.session.flashbag.get('create') %}
        <div class="nNote nSuccess hideit">
            <p>
                <strong>Success:
                </strong>
                {{ 'licenses.created_item_notice' | trans }}
            </p>
        </div>
    {% endfor %}
    {% for flashMessage in app.session.flashbag.get('update') %}
        <div class="nNote nSuccess hideit">
            <p>
                <strong>Success:
                </strong>
                {{ 'licenses.updated_item_notice' | trans }}
            </p>
        </div>
    {% endfor %}
    {% for flashMessage in app.session.flashbag.get('reply_publish') %}
        <div class="nNote nSuccess hideit">
            <p>
                <strong>Success:
                </strong>
                {{ flashMessage }}
            </p>
        </div>
    {% endfor %}
    <div class="widget">
        <div class="title">
            <img src="{{ asset('bundles/webmastersafricaadmin/images/icons/dark/frames.png') }}" alt="" class="titleIcon"/>
            <h6>List of Abusive Comments</h6>
        </div>
        <form id="batch_form" name="batch_form" action="{{ path("batch_comments") }}" method="post">
            <table cellpadding="0" cellspacing="0" width="100%" class="sTable w3-table-all w3-card-4" id="nc_abusive_comment_table">
                <thead>
                    <tr class="w3-pale-blue">
                        <td width="40px;">
                            <div>&middot;&middot;&middot;</div>
                        </td>
                        <td>
                            Comment Title
                        </td>
                        <td>
                            Action
                        </td>
                    </tr>
                </thead>

                <tbody>
                    {% for comment in entity.childrenRight %}
                        <tr>
                            <td><input type="checkbox" name="batch_items[]" value="{{ comment.id }}" class="w3-check"></td>
                            <td>{{ comment.comment }}</td>
                            <td>
                                {% if is_expr_granted("hasRole('MODERATE_COMMENTS')") %}
                                    {% if comment.publish == 0 %}
                                        <a href="{{path('managecomments_1_publish',{'id':comment.id, 'comment_id': entity.id })}}" class="w3-button w3-white w3-border w3-border-green" onclick="return confirm('Are you sure you want to unpublish this item')">
                                            publish
                                        </a>
                                    {% endif %}

                                    {% if comment.publish == 1 %}
                                        <a href="{{path('managecomments_1_unpublish',{'id':comment.id, 'comment_id': entity.id })}}" class="w3-button w3-white w3-border w3-border-green" onclick="return confirm('Are you sure you want to unpublish this item')">
                                            unpublish
                                        </a>
                                    {% endif %}
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </form>
    </div>
{% endblock %}
{% block stylesheet_2 %}
    <script>
        $(document).ready(function () {
            $('#nc_abusive_comment_table').DataTable();
            $('#reply_button_action').click(function (e) {
                e.preventDefault();
                $("textarea#reply_message").val($("#reply_message").val());
                if ($("#reply_message").val()) {
                    $("#reply_form").submit();
                } else {
                    $("#error_message").html(`<span style="color: red;">Message Missing</span>`)
                }
            });
        });
    </script>
{% endblock %}
